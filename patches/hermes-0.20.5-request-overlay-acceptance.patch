+class RequestOverlayFilterResult:
+    """Host-verified final-guard proposal for one owned overlay."""
+
+    def __init__(
+        self,
+        *,
+        overlay: RequestOverlay,
+        before: Mapping[str, Any],
+        after: dict[str, Any],
+        disposition: str,
+    ) -> None:
+        self.body = after
+        self._overlay = overlay
+        self._before_sha256 = canonical_request_sha256(before)
+        self._after_sha256 = canonical_request_sha256(after)
+        self._disposition = disposition
+
+    def _accept(self, before: Mapping[str, Any], after: Mapping[str, Any]) -> bool:
+        try:
+            if (
+                canonical_request_sha256(before) != self._before_sha256
+                or canonical_request_sha256(after) != self._after_sha256
+            ):
+                return False
+            expected = (
+                before
+                if self._disposition == OVERLAY_KEPT
+                else self._overlay.native_request(
+                    before,
+                    require_original_material=False,
+                )
+            )
+            if (
+                expected is None
+                or canonical_request_sha256(expected) != self._after_sha256
+            ):
+                return False
+        except (TypeError, ValueError):
+            return False
+        self._overlay._set_disposition(self._disposition)
+        return True
+
