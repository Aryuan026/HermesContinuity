--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -118,6 +118,37 @@ RUN_BUDGET_WRAPUP_NOTICE = (
 )
 
 
+def _middleware_context_window(agent: Any) -> Dict[str, Any]:
+    """Return the current host-resolved context window without guessing."""
+    engine = getattr(agent, "context_compressor", None)
+    try:
+        tokens = getattr(engine, "context_length", None)
+        if not isinstance(tokens, int) or tokens <= 0:
+            raise ValueError("invalid context window")
+    except Exception:
+        return {
+            "context_window_tokens": None,
+            "context_window_source": "unknown",
+            "context_window_confidence": "unknown",
+        }
+
+    resolution = getattr(agent, "_context_window_resolution", None)
+    if not isinstance(resolution, dict) or resolution.get("tokens") != tokens:
+        resolution = getattr(engine, "_context_window_resolution", None)
+    if not isinstance(resolution, dict) or resolution.get("tokens") != tokens:
+        resolution = {
+            "source": "unknown",
+            "confidence": "unknown",
+        }
+    return {
+        "context_window_tokens": tokens,
+        "context_window_source": str(resolution.get("source") or "unknown"),
+        "context_window_confidence": str(
+            resolution.get("confidence") or "unknown"
+        ),
+    }
+
+
