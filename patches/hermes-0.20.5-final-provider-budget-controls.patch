+def test_plugin_owned_provider_body_filters_compose_once_before_sdk(monkeypatch):
+    from agent import relay_llm
+    from hermes_cli import plugins
+
+    manager = plugins.PluginManager(scope_key="/tmp/hermes-filter-owner-test")
+    first_ctx = plugins.PluginContext(
+        plugins.PluginManifest(name="first", key="first"), manager
+    )
+    second_ctx = plugins.PluginContext(
+        plugins.PluginManifest(name="second", key="second"), manager
+    )
+    seen = []
+
+    def first_filter(
+        body,
+        *,
+        estimated_tokens,
+        estimate_source,
+        estimate_confidence,
+    ):
+        seen.append(("first", copy.deepcopy(body)))
+        assert estimated_tokens > 0
+        assert estimate_source == "hermes.provider_body.rough.v1"
+        assert estimate_confidence == "heuristic_with_margin"
+        body["metadata"] = {"filters": ["first"]}
+        return body
+
+    def second_filter(body):
+        seen.append(("second", copy.deepcopy(body)))
+        body["metadata"]["filters"].append("second")
+        return body
+
+    def first_execution(*, request, next_call, transport_record, **_kwargs):
+        transport_record.register_provider_body_filter(first_filter)
+        return next_call(request)
+
+    def second_execution(*, request, next_call, transport_record, **_kwargs):
+        transport_record.register_provider_body_filter(second_filter)
+        return next_call(request)
+
+    first_handle = first_ctx.register_middleware(
+        middleware.LLM_EXECUTION_MIDDLEWARE, first_execution
+    )
+    second_ctx.register_middleware(
+        middleware.LLM_EXECUTION_MIDDLEWARE, second_execution
+    )
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+
+    request = {
+        "model": "test",
+        "messages": [{"role": "user", "content": "hello"}],
+    }
+    record = middleware.TransportRecord()
+    sdk_calls = []
+    client_timeout = object()
+
+    def terminal(final):
+        record.mark_middleware_verified(final)
+        with middleware.transport_record_scope(record):
+            return relay_llm.call_provider_body(
+                lambda **body: sdk_calls.append(body) or "ok",
+                {**final, "timeout": client_timeout},
+            )
+
+    result = middleware.run_llm_execution_middleware(
+        request,
+        terminal,
+        transport_record=record,
+    )
+    record.settle()
+
+    assert result == "ok"
+    assert [name for name, _body in seen] == ["first", "second"]
+    assert all("timeout" not in body for _name, body in seen)
+    assert sdk_calls[0]["metadata"] == {"filters": ["first", "second"]}
+    assert sdk_calls[0]["timeout"] is client_timeout
+    assert len(sdk_calls) == 1
+    assert record.provider_body == {
+        key: value for key, value in sdk_calls[0].items() if key != "timeout"
+    }
+    assert record.provider_body_filter_owners == ("first", "second")
+    assert record.provider_body_filter_phases == ("transform", "transform")
+    assert record.provider_body_estimated_tokens is not None
+    assert record.provider_body_estimate_source == "hermes.provider_body.rough.v1"
+    assert (
+        record.provider_body_estimate_confidence == "heuristic_with_margin"
+    )
+    assert record.settled is True
+
+    first_handle.dispose()
+    assert manager._middleware[middleware.LLM_EXECUTION_MIDDLEWARE] == [
+        second_execution
+    ]
+    assert manager._middleware_owners[middleware.LLM_EXECUTION_MIDDLEWARE] == [
+        "second"
+    ]
