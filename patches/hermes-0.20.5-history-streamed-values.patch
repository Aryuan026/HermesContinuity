+"""The byte-work owner must finish all raw/semantic hashes before publishing."""
+import hashlib
+import json
+import sqlite3
+import time
+
+import pytest
+
+from hermes_history_content import CHUNK, ValueWork, HistoryValue, HistoryString
+
+
+def test_streamed_value_keeps_exact_json_identity_across_quanta(tmp_path):
+    value = [{"type":"text", "text":"中😀\\\n"*20000},
+             {"type":"image_url", "image_url":{"url":"data:image/png;base64,"+"A"*17_500_000}}]
+    content = '\x00json:'+json.dumps(value)
+    connection = sqlite3.connect(tmp_path/'values.sqlite3')
+    connection.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    connection.execute('INSERT INTO messages VALUES(1,?)', (content,))
+    connection.commit()
+    size = len(content.encode())
+    del content
+    work = ValueWork(size, json_offset=6)
+    max_read = steps = 0
+
+    def read(offset, limit):
+        nonlocal max_read
+        assert limit <= CHUNK
+        max_read = max(max_read, limit)
+        with connection.blobopen('messages','content',1,readonly=True) as blob:
+            blob.seek(offset)
+            return blob.read(limit)
+
+    while not work.step(read, deadline=time.monotonic()+1, max_bytes=2*CHUNK):
+        steps += 1
+        assert work.proof is None and not work.complete
+        # A quantum owns no open blob/connection; cancellation can discard it.
+        assert work._reader is None
+    assert steps > 300 and max_read == CHUNK
+    original = connection.execute('SELECT content FROM messages').fetchone()[0]
+    for ascii_only, key in ((True,'semantic_ascii_sha256'),(False,'semantic_utf8_sha256')):
+        expected = hashlib.sha256(json.dumps(value, ensure_ascii=ascii_only, sort_keys=True,
+                                             separators=(',',':')).encode()).hexdigest()
+        assert work.proof[key] == expected
+    assert work.proof['raw_ascii_sha256'] == hashlib.sha256(
+        json.dumps(original, ensure_ascii=True).encode()).hexdigest()
+    descriptor = json.dumps(work.proof)
+    assert len(descriptor) < 10_000 and 'data:image' not in descriptor and '中' not in descriptor
+    capability = HistoryValue(json.loads(descriptor),read,decoded=True)
+    assert capability.utf8_sha256 == work.proof['semantic_utf8_sha256']
+    assert isinstance(capability.root[0]['text'],HistoryString)
+    assert isinstance(capability.root[1]['image_url']['url'],HistoryString)
+    # Sparse character/byte checkpoints make repeated compiler fragments read
+    # only their local region, including escaped emoji/UTF-8 boundaries.
+    for index,original_text in ((0,value[0]['text']), (1,value[1]['image_url']['url'])):
+        reference = capability.root[index]['text'] if index == 0 else capability.root[index]['image_url']['url']
+        for start in (0,10,65535,len(original_text)-100):
+            assert reference.slice(start,start+80) == original_text[start:start+80]
+    connection.close()
+
+
+def test_restarting_unfinished_value_does_not_publish_partial_proof():
+    data = json.dumps(['界😀'*30000]).encode()
+    read = lambda offset, limit: data[offset:offset+limit]
+    abandoned = ValueWork(len(data), json_offset=0)
+    assert not abandoned.step(read, deadline=time.monotonic()+1, max_bytes=CHUNK)
+    assert abandoned.proof is None
+    restarted = ValueWork(len(data), json_offset=0)
+    while not restarted.step(read, deadline=time.monotonic()+1, max_bytes=CHUNK):
+        assert restarted.proof is None
+    assert restarted.complete
+
+
+@pytest.mark.parametrize('payload', [b'[1,]', b'{"x":}', b'"bad\nline"', b'[1] 2'])
+def test_invalid_json_cannot_finish_a_value(payload):
+    work = ValueWork(len(payload), json_offset=0)
+    with pytest.raises(ValueError):
+        while not work.step(lambda offset, limit: payload[offset:offset+limit],
+                            deadline=time.monotonic()+1, max_bytes=CHUNK):
+            pass
+    assert not work.complete and work.proof is None
+
+
+def test_plain_giant_text_fragments_do_not_materialize_the_whole_value():
+    original = '中😀\r\nabc\\'*30000
+    data = original.encode()
+    sizes = []
+    def read(offset,limit):
+        sizes.append(limit)
+        return data[offset:offset+limit]
+    work = ValueWork(len(data))
+    while not work.step(read,deadline=time.monotonic()+1,max_bytes=CHUNK):
+        pass
+    capability = HistoryValue(json.loads(json.dumps(work.proof)),read,decoded=True)
+    assert isinstance(capability.root,HistoryString)
+    sizes.clear()
+    assert capability.root.slice(len(original)-100,len(original)) == original[-100:]
+    assert sum(sizes) < 3*CHUNK
