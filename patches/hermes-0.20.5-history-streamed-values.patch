+def test_real_host_streams_then_reads_after_page_connection_closes(tmp_path):
+    from hermes_state import SessionDB
+    value = [{"type":"text","text":"recorded meaning"},
+             {"type":"image_url","image_url":{"url":"data:image/png;base64,"+"A"*(5*1024*1024)}}]
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("giant", "cli")
+        row_id = db.append_message("giant","user",value,timestamp=1)
+        db.append_message("giant","assistant","recorded response",timestamp=2)
+        progresses = 0
+        for _ in range(2000):
+            prepared = db.prepare_history_step("giant",owner_id="test-stream",deadline_ms=50)
+            if prepared["status"] == "ready":
+                break
+            assert prepared["status"] == "progress", prepared
+            progresses += 1
+        else:
+            raise AssertionError("stream preparation stalled")
+        assert progresses > 0
+        page = db.read_history_page("giant",target=prepared["head_token"])
+        assert page["status"] == "ready", page
+        assert page["returned_rows"] == 2 and page["stored_bytes"] < 4*1024*1024
+        capability = page["rows"][0]["content"]
+        assert isinstance(capability,HistoryValue)
+        assert capability.utf8_sha256 == hashlib.sha256(json.dumps(
+            value,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+        assert capability.root[0]["text"] == "recorded meaning"
+        image = capability.root[1]["image_url"]["url"]
+        assert isinstance(image,HistoryString)
+        assert image.slice(0,22) == "data:image/png;base64,"
+        db._execute_write(lambda conn: conn.execute(
+            "UPDATE messages SET content='changed' WHERE session_id='giant' AND role='user'"))
+        with pytest.raises(ValueError,match="history_deferred_source_changed"):
+            image.slice(0,22)
