@@ -0,0 +1,518 @@
+"""Cooperative bounded SQLite value decoding for canonical-history preparation.
+
+Ranges, counts and hashes can be retained; canonical bodies stay in SQLite.
+Each yield is an unfinished byte-work boundary, never a record/group proof.
+"""
+import codecs
+import bisect
+import hashlib
+import json
+import re
+import time
+
+CHUNK = 65536
+SPECIAL = re.compile(rb'["\\\x00-\x1f]')
+SPACE = b' \t\r\n'
+
+
+class StringRange:
+    def __init__(self, start, end, chars, nonblank, ascii_sha, utf8_sha):
+        self.start, self.end, self.chars = start, end, chars
+        self.nonblank = nonblank
+        self.ascii_sha, self.utf8_sha = ascii_sha, utf8_sha
+        self.points = []
+
+    def descriptor(self):
+        return {'kind': 'string', 'start': self.start, 'end': self.end,
+                'characters': self.chars, 'nonblank': self.nonblank,
+                'ascii_sha256': self.ascii_sha, 'utf8_sha256': self.utf8_sha,
+                'points':self.points}
+
+
+class Parser:
+    def __init__(self, read, size, offset=0, on_text=None):
+        self.read, self.size = read, size
+        self.offset, self.buffer = offset, b''
+        self.nodes = self.small_bytes = 0
+        self.complete = False
+        self.on_text = on_text
+        self.ranges = {}
+        self.literals = {}
+
+    def fill(self):
+        if not self.buffer and self.offset < self.size:
+            self.buffer = self.read(self.offset, min(CHUNK, self.size-self.offset))
+            if not self.buffer:
+                raise ValueError('short_read')
+            yield len(self.buffer)
+
+    def take(self, count):
+        value = self.buffer[:count]
+        self.buffer = self.buffer[count:]
+        self.offset += count
+        return value
+
+    def peek(self):
+        yield from self.fill()
+        return self.buffer[:1]
+
+    def skip(self):
+        while (yield from self.peek()) in [bytes([c]) for c in SPACE]:
+            self.take(1)
+
+    def string(self, *, key=False, inside=False):
+        yield from self.fill()
+        if not inside:
+            assert self.take(1) == b'"'
+        start = self.offset
+        small = []
+        small_size = chars = 0
+        ascii_hash, utf8_hash = hashlib.sha256(), hashlib.sha256()
+        ascii_hash.update(b'"')
+        utf8_hash.update(b'"')
+        decoder = codecs.getincrementaldecoder('utf-8')('strict')
+        pending_surrogate = ''
+        nonblank = False
+        points = [(0, start)]
+
+        def feed(text):
+            nonlocal small, small_size, chars, pending_surrogate, nonblank
+            if pending_surrogate:
+                text = pending_surrogate + text
+                pending_surrogate = ''
+            if text and 0xD800 <= ord(text[-1]) <= 0xDBFF:
+                pending_surrogate, text = text[-1], text[:-1]
+            # json.loads combines adjacent escaped UTF-16 surrogate pairs.
+            text = re.sub(r'[\ud800-\udbff][\udc00-\udfff]',
+                          lambda m: chr(0x10000 + (ord(m[0][0])-0xD800)*1024 + ord(m[0][1])-0xDC00), text)
+            chars += len(text)
+            if self.on_text is not None:
+                self.on_text(text)
+            nonblank = nonblank or bool(text.strip())
+            ascii_hash.update(json.dumps(text, ensure_ascii=True)[1:-1].encode('ascii'))
+            utf8_hash.update(json.dumps(text, ensure_ascii=False)[1:-1].encode('utf-8'))
+            if small is not None:
+                small_size += len(text.encode('utf-8', 'surrogatepass'))
+                if small_size > CHUNK:
+                    if key:
+                        raise ValueError('object_key_budget_exceeded')
+                    small = None
+                else:
+                    small.append(text)
+            if (chars-points[-1][0] >= CHUNK and not pending_surrogate
+                    and not decoder.getstate()[0]):
+                points.append((chars, self.offset))
+
+        while True:
+            yield from self.fill()
+            if not self.buffer:
+                raise ValueError('unterminated_string')
+            match = SPECIAL.search(self.buffer)
+            count = match.start() if match else len(self.buffer)
+            if count:
+                feed(decoder.decode(self.take(count)))
+            if not match:
+                continue
+            byte = self.take(1)
+            if byte == b'"':
+                feed(decoder.decode(b'', final=True))
+                if pending_surrogate:
+                    # json.loads permits lone surrogate escapes. Hashing as
+                    # UTF-8 is intentionally rejected by the real consumer.
+                    raise ValueError('lone_surrogate')
+                break
+            if byte != b'\\':
+                raise ValueError('invalid_control_character')
+            if decoder.getstate()[0]:
+                raise ValueError('incomplete_utf8_before_escape')
+            escape = byte
+            yield from self.fill()
+            if not self.buffer:
+                raise ValueError('unterminated_escape')
+            escape += self.take(1)
+            if escape[-1:] == b'u':
+                for _ in range(4):
+                    yield from self.fill()
+                    if not self.buffer:
+                        raise ValueError('unterminated_unicode_escape')
+                    escape += self.take(1)
+            feed(json.loads(b'"'+escape+b'"'))
+        ascii_hash.update(b'"')
+        utf8_hash.update(b'"')
+        reference = StringRange(start, self.offset-1, chars, nonblank,
+                                ascii_hash.hexdigest(), utf8_hash.hexdigest())
+        reference.points = points
+        if small is not None:
+            self.small_bytes += small_size
+            if self.small_bytes > 1024*1024:
+                raise ValueError('structure_byte_budget_exceeded')
+            result = ''.join(small)
+            self.ranges[id(result)] = reference
+            return result
+        return reference
+
+    def value(self, depth=0):
+        self.nodes += 1
+        if depth > 64 or self.nodes > 16384:
+            raise ValueError('structure_budget_exceeded')
+        yield from self.skip()
+        start = self.offset
+        token = yield from self.peek()
+        if token == b'"':
+            return (yield from self.string())
+        if token in (b'[', b'{'):
+            opening = self.take(1)
+            close = b']' if opening == b'[' else b'}'
+            result = [] if opening == b'[' else {}
+            yield from self.skip()
+            if (yield from self.peek()) == close:
+                self.take(1)
+                return result
+            while True:
+                if opening == b'{':
+                    if (yield from self.peek()) != b'"':
+                        raise ValueError('object_key_expected')
+                    key = yield from self.string(key=True)
+                    yield from self.skip()
+                    if self.take(1) != b':':
+                        raise ValueError('colon_expected')
+                item = yield from self.value(depth+1)
+                if opening == b'[':
+                    result.append(item)
+                else:
+                    result[key] = item
+                yield from self.skip()
+                separator = self.take(1)
+                if separator == close:
+                    return result
+                if separator != b',':
+                    raise ValueError('separator_expected')
+                yield from self.skip()
+        literal = bytearray()
+        while (yield from self.peek()) not in (b'', b',', b']', b'}', b' ', b'\t', b'\r', b'\n'):
+            literal += self.take(1)
+            if len(literal) > 256:
+                raise ValueError('number_budget_exceeded')
+        value = json.loads(literal)
+        if not isinstance(value, (int, float, bool, type(None))):
+            raise ValueError('invalid_literal')
+        self.literals[id(value)] = (start, self.offset)
+        return value
+
+    def descriptor(self, value):
+        if isinstance(value, StringRange):
+            return value.descriptor()
+        if isinstance(value, str):
+            return self.ranges[id(value)].descriptor()
+        if isinstance(value, dict):
+            return {'kind':'object', 'members':[
+                [self.descriptor(key), self.descriptor(item)] for key, item in value.items()]}
+        if isinstance(value, list):
+            return {'kind':'array', 'items':[self.descriptor(item) for item in value]}
+        start, end = self.literals[id(value)]
+        return {'kind':'literal', 'start':start, 'end':end}
+
+    def parse(self):
+        value = yield from self.value()
+        yield from self.skip()
+        if (yield from self.peek()) != b'':
+            raise ValueError('trailing_data')
+        self.complete = True
+        return value
+
+
+def run(read, size, offset=0):
+    parser = Parser(read, size, offset)
+    steps = parser.parse()
+    consumed = 0
+    while True:
+        try:
+            consumed += next(steps)
+            assert not parser.complete
+        except StopIteration as done:
+            return done.value, consumed, parser.nodes
+
+
+def text_chunks(reference, read):
+    pieces = []
+    parser = Parser(read, reference.end+1, reference.start-1, pieces.append)
+    task = parser.string()
+    while True:
+        try:
+            next(task)
+        except StopIteration:
+            if pieces:
+                yield ''.join(pieces)
+            return
+        if pieces:
+            yield ''.join(pieces)
+            pieces.clear()
+
+
+class HistoryString:
+    """Private verified range; never implicitly converts a giant value to str."""
+
+    def __init__(self, descriptor, read):
+        self._descriptor, self._read = descriptor, read
+
+    def __len__(self):
+        return self._descriptor['characters']
+
+    @property
+    def nonblank(self):
+        return self._descriptor['nonblank']
+
+    def __repr__(self):
+        return '<verified history string; body deferred>'
+
+    def chunks(self, start=0, end=None):
+        end = len(self) if end is None else end
+        if not 0 <= start <= end <= len(self):
+            raise ValueError('history string character range invalid')
+        if start == end:
+            return
+        descriptor = self._descriptor
+        points = [tuple(point) for point in descriptor.get('points') or [(0,descriptor['start'])]]
+        point = points[max(0, bisect.bisect_right(points, (start,2**63))-1)]
+        at, offset = point
+        if descriptor['kind'] == 'raw_string':
+            decoder = codecs.getincrementaldecoder('utf-8')('strict')
+            while offset < descriptor['end'] and at < end:
+                limit = min(CHUNK, descriptor['end']-offset)
+                text = decoder.decode(self._read(offset,limit))
+                offset += limit
+                left, right = max(0,start-at), min(len(text),end-at)
+                if left < right:
+                    yield text[left:right]
+                at += len(text)
+            return
+        pieces = []
+        parser = Parser(self._read, descriptor['end']+1, offset, pieces.append)
+        task = parser.string(inside=True)
+        try:
+            while at < end:
+                finished = False
+                try:
+                    next(task)
+                except StopIteration:
+                    finished = True
+                if pieces:
+                    text = ''.join(pieces)
+                    pieces.clear()
+                    left, right = max(0,start-at), min(len(text),end-at)
+                    if left < right:
+                        yield text[left:right]
+                    at += len(text)
+                if finished:
+                    break
+        finally:
+            task.close()
+        if at < end:
+            raise ValueError('history string range ended early')
+
+    def slice(self, start, end, *, max_bytes=CHUNK):
+        pieces, size = [], 0
+        for text in self.chunks(start,end):
+            size += len(text.encode('utf-8'))
+            if size > max_bytes:
+                raise ValueError('history fragment byte limit exceeded')
+            pieces.append(text)
+        return ''.join(pieces)
+
+
+def hydrate_tree(descriptor, read):
+    """Resolve only bounded structural/scalar leaves; keep giant strings lazy."""
+    kind = descriptor['kind']
+    if kind in {'string','raw_string'}:
+        value = HistoryString(descriptor,read)
+        return value.slice(0,len(value)) if len(value) <= CHUNK//4 else value
+    if kind == 'array':
+        return [hydrate_tree(item,read) for item in descriptor['items']]
+    if kind == 'object':
+        values = [(hydrate_tree(key,read),hydrate_tree(value,read))
+                  for key,value in descriptor['members']]
+        if any(not isinstance(key,str) for key,_ in values):
+            raise ValueError('history object key is not bounded')
+        return dict(values)
+    if kind == 'literal':
+        length = descriptor['end']-descriptor['start']
+        if not 0 < length <= 256:
+            raise ValueError('history scalar range invalid')
+        return json.loads(read(descriptor['start'],length))
+    raise ValueError('history value descriptor kind invalid')
+
+
+class HistoryValue:
+    """Host-owned complete value identity plus its lazy canonical read capability."""
+
+    def __init__(self, proof, read, *, decoded=False):
+        self._proof, self._read, self._decoded = proof, read, decoded
+        self._root = None
+
+    @property
+    def ascii_sha256(self):
+        return self._proof['semantic_ascii_sha256' if self._decoded else 'raw_ascii_sha256']
+
+    @property
+    def utf8_sha256(self):
+        if not self._decoded:
+            raise ValueError('raw history capability cannot supply semantic identity')
+        return self._proof['semantic_utf8_sha256']
+
+    @property
+    def root(self):
+        if not self._decoded:
+            raise ValueError('raw history capability cannot supply decoded content')
+        if self._root is None:
+            self._root = hydrate_tree(self._proof['tree'],self._read)
+        return self._root
+
+    def footprint(self):
+        # Locators/capabilities remain private; this is sizing, NOT JSON identity.
+        return {'schema':'hermes.history_value_footprint.v1',
+                'content_sha256':self.ascii_sha256, 'descriptor':self._proof['tree']}
+
+    def __repr__(self):
+        return '<complete verified history value; body deferred>'
+
+    def __eq__(self, other):
+        return isinstance(other,HistoryValue) and self.ascii_sha256 == other.ascii_sha256
+
+    def __deepcopy__(self, memo):
+        # The reader is an identity-bound capability, not a SQLite connection.
+        return self
+
+
+def canonical_chunks(value, read, *, ascii_only=False):
+    if isinstance(value, StringRange):
+        yield b'"'
+        for part in text_chunks(value, read):
+            yield json.dumps(part, ensure_ascii=ascii_only)[1:-1].encode('ascii' if ascii_only else 'utf-8')
+        yield b'"'
+    elif isinstance(value, dict):
+        yield b'{'
+        for index, key in enumerate(sorted(value)):
+            if index:
+                yield b','
+            yield json.dumps(key, ensure_ascii=ascii_only).encode('ascii' if ascii_only else 'utf-8')
+            yield b':'
+            yield from canonical_chunks(value[key], read, ascii_only=ascii_only)
+        yield b'}'
+    elif isinstance(value, list):
+        yield b'['
+        for index, item in enumerate(value):
+            if index:
+                yield b','
+            yield from canonical_chunks(item, read, ascii_only=ascii_only)
+        yield b']'
+    else:
+        yield json.dumps(value, ensure_ascii=ascii_only, separators=(',',':')).encode('ascii' if ascii_only else 'utf-8')
+
+
+class ValueWork:
+    """One unfinished value owned by the existing preparation worker.
+
+No SQLite connection or blob survives a step. The host must bind a fresh,
+validated row snapshot on every step and revalidate before publication. On
+restart this disposable hash/parser state is discarded, not trusted/resumed.
+"""
+
+    def __init__(self, size, *, storage_type='text', json_offset=None):
+        self.size, self.storage_type, self.json_offset = size, storage_type, json_offset
+        self.complete = False
+        self.proof = None
+        self.read_bytes = self.steps = 0
+        self._reader = None
+        self._task = self._run()
+
+    def _read(self, offset, limit):
+        if self._reader is None:
+            raise RuntimeError('history value has no active read snapshot')
+        if not 0 <= offset <= self.size or not 0 < limit <= CHUNK:
+            raise ValueError('history value read range invalid')
+        limit = min(limit, self.size-offset)
+        data = self._reader(offset, limit)
+        if len(data) != limit:
+            raise ValueError('history value short read')
+        self.read_bytes += len(data)
+        return data
+
+    def step(self, read, *, deadline, max_bytes):
+        if self.complete:
+            return True
+        self._reader = read
+        before = self.read_bytes
+        try:
+            while time.monotonic() < deadline and self.read_bytes-before < max_bytes:
+                try:
+                    next(self._task)
+                except StopIteration as finished:
+                    self.proof = finished.value
+                    self.complete = True
+                    return True
+                self.steps += 1
+            return False
+        finally:
+            self._reader = None
+
+    def _run(self):
+        raw_ascii, raw_utf8 = hashlib.sha256(), hashlib.sha256()
+        if self.storage_type == 'blob':
+            # Match the host's existing _json_value(bytes) canonical shape.
+            raw_ascii.update(b'{"$bytes":"')
+            for offset in range(0, self.size, CHUNK):
+                raw_ascii.update(self._read(offset, min(CHUNK, self.size-offset)).hex().encode('ascii'))
+                yield
+            raw_ascii.update(b'"}')
+            return {'kind':'blob', 'bytes':self.size,
+                    'raw_ascii_sha256':raw_ascii.hexdigest(),
+                    'semantic_ascii_sha256':raw_ascii.hexdigest(),
+                    'semantic_utf8_sha256':None, 'tree':None}
+        if self.storage_type != 'text':
+            raise ValueError('unsupported streamed storage type')
+        decoder = codecs.getincrementaldecoder('utf-8')('strict')
+        chars, nonblank = 0, False
+        points = [(0,0)]
+        raw_ascii.update(b'"')
+        raw_utf8.update(b'"')
+        for offset in range(0, self.size, CHUNK):
+            text = decoder.decode(self._read(offset, min(CHUNK, self.size-offset)))
+            chars += len(text)
+            nonblank = nonblank or bool(text.strip())
+            raw_ascii.update(json.dumps(text, ensure_ascii=True)[1:-1].encode('ascii'))
+            raw_utf8.update(json.dumps(text, ensure_ascii=False)[1:-1].encode('utf-8'))
+            if chars-points[-1][0] >= CHUNK and not decoder.getstate()[0]:
+                points.append((chars,offset+min(CHUNK,self.size-offset)))
+            yield
+        assert decoder.decode(b'', final=True) == ''
+        raw_ascii.update(b'"')
+        raw_utf8.update(b'"')
+        proof = {'kind':'text', 'bytes':self.size,
+                 'raw_ascii_sha256':raw_ascii.hexdigest(),
+                 'semantic_ascii_sha256':raw_ascii.hexdigest(),
+                 'semantic_utf8_sha256':raw_utf8.hexdigest(),
+                 'tree':{'kind':'raw_string', 'start':0, 'end':self.size,
+                         'characters':chars, 'nonblank':nonblank,
+                         'ascii_sha256':raw_ascii.hexdigest(),
+                         'utf8_sha256':raw_utf8.hexdigest(), 'points':points}}
+        if self.json_offset is None:
+            return proof
+        parser = Parser(self._read, self.size, self.json_offset)
+        try:
+            root = yield from parser.parse()
+        except (ValueError, UnicodeError):
+            # The host's content decoder returns the raw string for malformed
+            # encoded JSON. Resource-limit exceptions must NOT use this path.
+            raise
+        proof['tree'] = parser.descriptor(root)
+        for ascii_only, key in ((True, 'semantic_ascii_sha256'), (False, 'semantic_utf8_sha256')):
+            digest = hashlib.sha256()
+            for piece in canonical_chunks(root, self._read, ascii_only=ascii_only):
+                if len(piece) > 6*CHUNK+2:
+                    raise ValueError('canonical_piece_budget_exceeded')
+                digest.update(piece)
+                yield
+            proof[key] = digest.hexdigest()
+        if len(json.dumps(proof, separators=(',',':')).encode()) > 1024*1024:
+            raise ValueError('descriptor_budget_exceeded')
+        return proof
