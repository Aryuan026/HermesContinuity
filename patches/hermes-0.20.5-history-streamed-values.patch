+@pytest.mark.parametrize("read_only", [False, True])
+def test_completed_proof_survives_a_quantum_that_cannot_commit_the_row(tmp_path, monkeypatch, read_only):
+    from hermes_state import SessionDB
+    import hermes_state_history as history
+    value = [{"type":"text","text":"meaning"},
+             {"type":"image_url","image_url":{"url":"A"*(5*1024*1024)}}]
+    constructions = 0
+    original_work = history.ValueWork
+    def work(*args, **kwargs):
+        nonlocal constructions
+        constructions += 1
+        return original_work(*args, **kwargs)
+    monkeypatch.setattr(history, "ValueWork", work)
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("late", "cli")
+        db.append_message("late", "user", value, timestamp=1)
+        db.append_message("late", "assistant", "reply", timestamp=2)
+        original_probe = history.SessionHistoryMixin._history_probe_native_page
+        yielded_after_completion = False
+        def probe(self, *args, **kwargs):
+            nonlocal yielded_after_completion
+            result = original_probe(self, *args, **kwargs)
+            if result[0] and not yielded_after_completion:
+                yielded_after_completion = True
+                time.sleep(0.06)  # actual row cannot be committed in this quantum
+            return result
+        monkeypatch.setattr(history.SessionHistoryMixin, "_history_probe_native_page", probe)
+        reader = SessionDB(tmp_path / "state.db", read_only=True) if read_only else db
+        try:
+            for _ in range(2000):
+                prepared = reader.prepare_history_step("late", owner_id="late-worker", deadline_ms=50)
+                if prepared["status"] == "ready":
+                    break
+                assert prepared["status"] == "progress", prepared
+            else:
+                raise AssertionError("completed proof was repeatedly discarded")
+            assert yielded_after_completion and constructions == 1
+            assert reader.read_history_page("late", target=prepared["head_token"])["returned_rows"] == 2
+        finally:
+            if read_only:
