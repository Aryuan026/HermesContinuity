From 201fe7756c57c35aaed9af8e9886e10ff4d25cfe Mon Sep 17 00:00:00 2001
From: asherie <asherie@users.noreply.github.com>
Date: Sun, 30 Aug 2026 00:36:57 +0800
Subject: [PATCH] feat(plugins): expose LLM finish reasons

---
 agent/plugin_llm.py            | 29 +++++++++++
 tests/agent/test_plugin_llm.py | 89 +++++++++++++++++++++++++++++++---
 2 files changed, 111 insertions(+), 7 deletions(-)

diff --git a/agent/plugin_llm.py b/agent/plugin_llm.py
index e0cc8cc..1805ffe 100644
--- a/agent/plugin_llm.py
+++ b/agent/plugin_llm.py
@@ -143,6 +143,7 @@ class PluginLlmCompleteResult:
     agent_id: str
     usage: PluginLlmUsage = field(default_factory=PluginLlmUsage)
     audit: Dict[str, Any] = field(default_factory=dict)
+    finish_reason: Optional[str] = None
 
 
 @dataclass
@@ -162,6 +163,7 @@ class PluginLlmStructuredResult:
     parsed: Optional[Any] = None
     content_type: str = "text"
     audit: Dict[str, Any] = field(default_factory=dict)
+    finish_reason: Optional[str] = None
 
 
 # ---------------------------------------------------------------------------
@@ -651,6 +653,29 @@ def _extract_text(response: Any) -> str:
     return ""
 
 
+def _extract_finish_reason(response: Any) -> Optional[str]:
+    """Pull a normalized finish reason from an OpenAI-shaped response."""
+    try:
+        choices = (
+            response.get("choices")
+            if isinstance(response, dict)
+            else getattr(response, "choices", None)
+        )
+        choice = choices[0]
+        reason = (
+            choice.get("finish_reason")
+            if isinstance(choice, dict)
+            else getattr(choice, "finish_reason", None)
+        )
+    except (AttributeError, IndexError, KeyError, TypeError):
+        return None
+
+    if not isinstance(reason, str):
+        return None
+    normalized = reason.strip()
+    return normalized or None
+
+
 def _resolve_attribution(
     *,
     provider_override: Optional[str],
@@ -799,6 +824,7 @@ class PluginLlm:
                 "profile": eff_profile or "",
                 "task": eff_task or "",
             },
+            finish_reason=_extract_finish_reason(response),
         )
         logger.info(
             "plugin_llm.complete plugin=%s provider=%s model=%s task=%s "
@@ -898,6 +924,7 @@ class PluginLlm:
                 "schema_name": schema_name or "",
                 "task": eff_task or "",
             },
+            finish_reason=_extract_finish_reason(response),
         )
         logger.info(
             "plugin_llm.complete_structured plugin=%s provider=%s model=%s "
@@ -957,6 +984,7 @@ class PluginLlm:
                 "profile": eff_profile or "",
                 "task": eff_task or "",
             },
+            finish_reason=_extract_finish_reason(response),
         )
         logger.info(
             "plugin_llm.acomplete plugin=%s provider=%s model=%s task=%s "
@@ -1040,6 +1068,7 @@ class PluginLlm:
                 "schema_name": schema_name or "",
                 "task": eff_task or "",
             },
+            finish_reason=_extract_finish_reason(response),
         )
         logger.info(
             "plugin_llm.acomplete_structured plugin=%s provider=%s model=%s "
diff --git a/tests/agent/test_plugin_llm.py b/tests/agent/test_plugin_llm.py
index 3801694..4d12484 100644
--- a/tests/agent/test_plugin_llm.py
+++ b/tests/agent/test_plugin_llm.py
@@ -26,6 +26,7 @@ from agent.plugin_llm import (
     _build_structured_messages,
     _check_overrides,
