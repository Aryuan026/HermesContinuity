@@ -38,15 +39,24 @@ from agent.plugin_llm import (
 # ---------------------------------------------------------------------------
 
 
-def _fake_response(text: str, *, prompt: int = 4, completion: int = 6) -> SimpleNamespace:
+_MISSING_FINISH_REASON = object()
+
+
+def _fake_response(
+    text: str,
+    *,
+    prompt: int = 4,
+    completion: int = 6,
+    finish_reason: Any = "stop",
+) -> SimpleNamespace:
     """Build an OpenAI-shaped response with the given text + token usage."""
+    choice = SimpleNamespace(
+        message=SimpleNamespace(content=text, role="assistant"),
+    )
+    if finish_reason is not _MISSING_FINISH_REASON:
+        choice.finish_reason = finish_reason
     return SimpleNamespace(
-        choices=[
-            SimpleNamespace(
-                message=SimpleNamespace(content=text, role="assistant"),
-                finish_reason="stop",
-            )
-        ],
+        choices=[choice],
         usage=SimpleNamespace(
             prompt_tokens=prompt,
             completion_tokens=completion,
@@ -328,6 +338,58 @@ class TestPluginLlmFacade:
         assert captured["max_tokens"] == 128
         assert captured["timeout"] == 10.0
 
+    @pytest.mark.parametrize(
+        ("method", "is_async", "structured", "text"),
+        [
+            ("complete", False, False, "plain response"),
+            ("complete_structured", False, True, '{"ok": true}'),
+            ("acomplete", True, False, "plain response"),
+            ("acomplete_structured", True, True, '{"ok": true}'),
+        ],
+    )
+    @pytest.mark.parametrize(
+        ("wire_reason", "expected"),
+        [
+            (" stop ", "stop"),
+            ("length", "length"),
+            (_MISSING_FINISH_REASON, None),
+        ],
+    )
+    def test_results_expose_finish_reason(
+        self,
+        method: str,
+        is_async: bool,
+        structured: bool,
+        text: str,
+        wire_reason: Any,
+        expected: Any,
+    ):
+        def fake_caller(**_kwargs):
+            return "openai", "gpt-4o", _fake_response(
+                text, finish_reason=wire_reason
+            )
+
+        async def fake_async(**_kwargs):
+            return fake_caller(**_kwargs)
+
+        llm = make_plugin_llm_for_test(
+            plugin_id="my-plugin",
+            policy=_TrustPolicy(plugin_id="my-plugin"),
+            sync_caller=fake_caller,
+            async_caller=fake_async,
+        )
+        if structured:
+            call = getattr(llm, method)(
+                instructions="Return JSON",
+                input=[PluginLlmTextInput(text="hi")],
+                json_mode=True,
+            )
+        else:
+            call = getattr(llm, method)([{"role": "user", "content": "hi"}])
+
+        result = asyncio.run(call) if is_async else call
+        assert result.finish_reason == expected
+
     def test_complete_structured_returns_parsed_json(self):
         def fake_caller(**_kwargs):
             return "openai", "gpt-4o", _fake_response(
@@ -427,6 +489,19 @@ class TestAsyncSurface:
         assert result.content_type == "json"
 
 
+@pytest.mark.parametrize(
+    ("response", "expected"),
+    [
+        ({"choices": [{"finish_reason": " stop "}]}, "stop"),
+        ({"choices": [{"finish_reason": ""}]}, None),
+        ({"choices": [{}]}, None),
+        ({"choices": [{"finish_reason": 42}]}, None),
+    ],
+)
+def test_extract_finish_reason_supports_dict_responses(response: Any, expected: Any):
+    assert _extract_finish_reason(response) == expected
+
+
