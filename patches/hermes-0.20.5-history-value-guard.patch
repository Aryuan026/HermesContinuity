+def test_probe_rejects_large_value_before_decode_and_restores_borrowed_state(history_db, monkeypatch):
+    history_db.append_message("history", "user", "large" * 10000)
+    conn = history_db._conn
+    before = conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH)
+    conn.execute("SAVEPOINT owner_transaction")
+    conn.execute("UPDATE sessions SET title='pending' WHERE id='history'")
+    domain = {"domain_id": "history", "cursor_message_id": 0, "target_max_message_id": 10}
+    probe_limits = []
+    conn.set_trace_callback(lambda sql: probe_limits.append(conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH))
+                            if " AS stored_bytes FROM messages " in sql else None)
+    try:
+        rows, sizes, total, more, reason = history_db._history_probe_page(
+            conn, domain, max_rows=2, max_bytes=1024)
+        assert (rows, sizes, total, more, reason) == (
+            [], {}, 0, True, "history_row_byte_limit_exceeded")
+        assert probe_limits == [1024 + 4096]
+        assert conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH) == before
+        assert conn.in_transaction
+        assert conn.execute("SELECT title FROM sessions WHERE id='history'").fetchone()[0] == "pending"
+    finally:
+        conn.set_trace_callback(None)
+        conn.execute("ROLLBACK TO owner_transaction")
+        conn.execute("RELEASE owner_transaction")
+
+    def decode_must_not_run(rows):
+        raise AssertionError("oversized source reached decoder")
+    with monkeypatch.context() as guard:
+        guard.setattr(history_db, "_decode_message_rows", decode_must_not_run)
+        result = history_db.prepare_history_step("history", owner_id="guard", max_page_bytes=1024)
+    assert result["status"] == "overflow"
+    assert result["reason"] == "history_row_byte_limit_exceeded"
+    assert conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH) == before
+    assert not conn.in_transaction
+    history_db.create_session("small", source="cli")
+    history_db.append_message("small", "user", "small body")
+    result = history_db.prepare_history_step("small", owner_id="guard", max_page_bytes=1024)
+    assert result["status"] == "ready"
+    page = history_db.read_history_page("small", target=result["head_token"], max_bytes=1024)
+    assert page["rows"][0]["content"] == "small body"
+
+
+def test_frontend_read_restores_limit_and_outer_transaction(history_db, monkeypatch):
+    from contextlib import contextmanager
+    history_db.append_message("history", "user", "budget body")
+    prepared = _prepare(history_db)
+    conn = history_db._conn
+    before = conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH)
+    original_decode = history_db._decode_message_rows
+    def checked_decode(rows):
+        assert conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH) == 1024 + 4096
+        return original_decode(rows)
+    @contextmanager
+    def borrowed_read():
+        yield conn
+    monkeypatch.setattr(history_db, "_read_ctx", borrowed_read)
+    monkeypatch.setattr(history_db, "_decode_message_rows", checked_decode)
+    conn.execute("SAVEPOINT owner_transaction")
+    conn.execute("UPDATE sessions SET title='pending' WHERE id='history'")
+    try:
+        page = history_db.read_history_page("history", target=prepared["head_token"], max_bytes=1024)
+        assert page["status"] == "ready"
+        assert page["rows"][0]["content"] == "budget body"
+        assert conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH) == before
+        assert conn.in_transaction
+        assert conn.execute("SELECT title FROM sessions WHERE id='history'").fetchone()[0] == "pending"
+        with monkeypatch.context() as failure:
+            failure.setattr(history_db, "_decode_message_rows", lambda rows: (_ for _ in ()).throw(RuntimeError("decode failed")))
+            with pytest.raises(RuntimeError, match="decode failed"):
+                history_db.read_history_page("history", target=prepared["head_token"], max_bytes=1024)
+        assert conn.getlimit(sqlite3.SQLITE_LIMIT_LENGTH) == before
+        assert conn.in_transaction
+    finally:
+        conn.execute("ROLLBACK TO owner_transaction")
+        conn.execute("RELEASE owner_transaction")
+
+
