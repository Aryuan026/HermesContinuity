@@ -344,6 +477,28 @@ def _run_execution_chain(
     return call_at(0, kwargs[payload_key])
 
 
+def _invoke_execution_callback(
+    callback: Callable[..., Any],
+    call_kwargs: Dict[str, Any],
+) -> Any:
+    """Hide additive transport kwargs from pre-H5 narrow callbacks."""
+
+    try:
+        parameters = inspect.signature(callback).parameters
+    except (TypeError, ValueError):
+        return callback(**call_kwargs)
+    if any(
+        parameter.kind is inspect.Parameter.VAR_KEYWORD
+        for parameter in parameters.values()
+    ):
+        return callback(**call_kwargs)
+    compatible = dict(call_kwargs)
+    for key in ("transport_record", "transport_schema_version"):
+        if key not in parameters:
+            compatible.pop(key, None)
+    return callback(**compatible)
+
+
 def _trace_entry(result: Dict[str, Any]) -> Dict[str, Any]:
     entry: Dict[str, Any] = {}
     for key in ("source", "reason", "name"):
