+def test_execution_callback_receives_transport_record_and_schema(monkeypatch):
+    record = middleware.TransportRecord()
+    calls = []
+
+    def wrapper(
+        *,
+        request,
+        next_call,
+        middleware_schema_version,
+        transport_schema_version,
+        transport_record,
+        **_kwargs,
+    ):
+        calls.append(
+            (
+                middleware_schema_version,
+                transport_schema_version,
+                transport_record,
+            )
+        )
+        result = next_call(request)
+        assert transport_record.provider_body == request
+        assert transport_record.settled is False
+        return result
+
+    def provider(request):
+        calls.append("provider")
+        record.mark_middleware_verified(request)
+        with middleware.transport_record_scope(record):
+            from agent.relay_llm import _capture_provider_body
+
+            _capture_provider_body(request)
+        return "ok"
+
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_callbacks",
+        lambda kind: [wrapper]
+        if kind == middleware.LLM_EXECUTION_MIDDLEWARE
+        else [],
+    )
+
+    assert (
+        middleware.run_llm_execution_middleware(
+            {"messages": []},
+            provider,
+            transport_record=record,
+        )
+        == "ok"
+    )
+    assert calls == [
+        ("hermes.middleware.v2", "hermes.transport.v1", record),
+        "provider",
+    ]
+
