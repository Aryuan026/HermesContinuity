 TOOL_EXECUTION_MIDDLEWARE = "tool_execution"
@@ -44,6 +61,120 @@ class RequestMiddlewareResult:
     trace: List[Dict[str, Any]] = field(default_factory=list)
 
 
+class TransportRecord:
+    """Process-private truth for one physical provider attempt."""
+
+    schema_version = TRANSPORT_SCHEMA_VERSION
+
+    def __init__(self) -> None:
+        self._lock = Lock()
+        self._middleware_verified_request: Dict[str, Any] | None = None
+        self._provider_body: Dict[str, Any] | None = None
+        self._capture_count = 0
+        self._ambiguous = False
+        self._settled = False
+
+    @property
+    def middleware_verified_request(self) -> Dict[str, Any] | None:
+        with self._lock:
+            return _safe_copy(self._middleware_verified_request)
+
+    @property
+    def provider_body(self) -> Dict[str, Any] | None:
+        with self._lock:
+            return _safe_copy(self._provider_body)
+
+    @property
+    def capture_count(self) -> int:
+        with self._lock:
+            return self._capture_count
+
+    @property
+    def ambiguous(self) -> bool:
+        with self._lock:
+            return self._ambiguous
+
+    @property
+    def settled(self) -> bool:
+        with self._lock:
+            return self._settled
+
+    def mark_middleware_verified(self, request: Any) -> None:
+        if isinstance(request, dict) and "_moa_prepared_request" in request:
+            with self._lock:
+                self._ambiguous = True
+                self._settled = False
+            return
+        snapshot = _transport_snapshot(request)
+        with self._lock:
+            if self._middleware_verified_request is not None or snapshot is None:
+                self._ambiguous = True
+                self._settled = False
+                return
+            self._middleware_verified_request = snapshot
+
+    def capture_provider_body(self, body: Any) -> None:
+        snapshot = _transport_snapshot(body)
+        with self._lock:
+            self._capture_count += 1
+            if self._capture_count != 1 or snapshot is None:
+                self._ambiguous = True
+                self._settled = False
+                return
+            self._provider_body = snapshot
+
+    def settle(self) -> None:
+        with self._lock:
+            self._settled = bool(
+                not self._ambiguous
+                and self._middleware_verified_request is not None
+                and self._provider_body is not None
+                and self._capture_count == 1
+            )
+
+
+def current_transport_record() -> TransportRecord | None:
+    return _CURRENT_TRANSPORT_RECORD.get()
+
+
+@contextmanager
+def transport_record_scope(record: TransportRecord | None) -> Iterator[None]:
+    token = _CURRENT_TRANSPORT_RECORD.set(record)
+    try:
+        yield
+    finally:
+        _CURRENT_TRANSPORT_RECORD.reset(token)
+
+
+def _transport_snapshot(request: Any) -> Dict[str, Any] | None:
+    if not isinstance(request, dict):
+        return None
+    try:
+        stripped = {
+            key: value
+            for key, value in request.items()
+            if key not in _TRANSPORT_PRIVATE_KEYS
+        }
+        if not _transport_value_supported(stripped):
+            return None
+        return deepcopy(stripped)
+    except Exception:
+        return None
+
+
+def _transport_value_supported(value: Any) -> bool:
+    if value is None or isinstance(value, (bool, int, float, str, bytes)):
+        return True
+    if isinstance(value, dict):
+        return all(
+            isinstance(key, str) and _transport_value_supported(item)
+            for key, item in value.items()
+        )
+    if isinstance(value, (list, tuple)):
+        return all(_transport_value_supported(item) for item in value)
+    return False
+
+
 def observer_payload(**kwargs: Any) -> Dict[str, Any]:
