@@ -0,0 +1,599 @@
+"""Vertical transport-truth coverage through the real conversation loop."""
+
+from __future__ import annotations
+
+import sys
+from types import ModuleType
+from types import SimpleNamespace
+
+from agent import relay_llm, relay_runtime
+from hermes_cli import lifecycle, middleware, plugins
+from run_agent import AIAgent
+
+
+def _response(text: str = "done") -> SimpleNamespace:
+    return SimpleNamespace(
+        id="response-1",
+        model="test-model",
+        choices=[
+            SimpleNamespace(
+                message=SimpleNamespace(
+                    role="assistant",
+                    content=text,
+                    tool_calls=None,
+                ),
+                finish_reason="stop",
+            )
+        ],
+        usage=SimpleNamespace(
+            prompt_tokens=1,
+            completion_tokens=1,
+            total_tokens=2,
+        ),
+    )
+
+
+def _agent(monkeypatch) -> AIAgent:
+    from agent import context_compressor, model_metadata
+
+    monkeypatch.setattr(
+        AIAgent,
+        "_create_openai_client",
+        lambda *_args, **_kwargs: SimpleNamespace(),
+    )
+    monkeypatch.setattr(
+        model_metadata,
+        "get_model_context_length",
+        lambda *_args, **_kwargs: 128_000,
+    )
+    monkeypatch.setattr(
+        context_compressor,
+        "get_model_context_length",
+        lambda *_args, **_kwargs: 128_000,
+    )
+    agent = AIAgent(
+        api_key="test-key",
+        base_url="http://127.0.0.1:1/v1",
+        provider="openai-compat",
+        model="test-model",
+        max_iterations=1,
+        enabled_toolsets=[],
+        quiet_mode=True,
+        skip_context_files=True,
+        skip_memory=True,
+        save_trajectories=False,
+        platform="subagent",
+    )
+    agent._api_max_retries = 1
+    agent._build_api_kwargs = lambda messages: {
+        "model": agent.model,
+        "messages": messages,
+    }
+    agent._try_recover_primary_transport = lambda *_args, **_kwargs: False
+    agent._try_activate_fallback = lambda *_args, **_kwargs: False
+    agent._has_pending_fallback = lambda: False
+    monkeypatch.setitem(sys.modules, "httpx", ModuleType("httpx"))
+    return agent
+
+
+def _install_callbacks(monkeypatch, execution_callback, post_callback):
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_callbacks",
+        lambda kind: [execution_callback]
+        if kind == middleware.LLM_EXECUTION_MIDDLEWARE
+        else [],
+    )
+    monkeypatch.setattr(
+        middleware,
+        "_has_middleware",
+        lambda kind: kind == middleware.LLM_EXECUTION_MIDDLEWARE,
+    )
+    monkeypatch.setattr(
+        lifecycle,
+        "has_hook",
+        lambda name: name == "post_api_request",
+    )
+    monkeypatch.setattr(
+        lifecycle,
+        "invoke_hook",
+        lambda name, **kwargs: post_callback(
+            telemetry_schema_version="hermes.observer.v1",
+            **kwargs,
+        )
+        if name == "post_api_request"
+        else [],
+    )
+    monkeypatch.setattr(plugins, "invoke_hook", lambda *_args, **_kwargs: [])
+
+
+def test_direct_stream_fallback_settles_only_before_post_and_calls_provider_once(
+    monkeypatch,
+):
+    agent = _agent(monkeypatch)
+    provider_requests = []
+    execution_observations = []
+    post_observations = []
+
+    def provider(request, *, on_first_delta=None):
+        del on_first_delta
+        with relay_llm.provider_body_scope(request):
+            provider_requests.append(request)
+            return _response()
+
+    def execution(
+        *,
+        request,
+        next_call,
+        middleware_schema_version,
+        transport_schema_version,
+        transport_record,
+        **_kwargs,
+    ):
+        result = next_call(request)
+        execution_observations.append(
+            (
+                middleware_schema_version,
+                transport_schema_version,
+                transport_record,
+                transport_record.provider_body,
+                transport_record.settled,
+            )
+        )
+        return result
+
+    def post(
+        *,
+        transport_schema_version,
+        transport_record,
+        telemetry_schema_version=None,
+        **_kwargs,
+    ):
+        post_observations.append(
+            (
+                transport_schema_version,
+                transport_record,
+                transport_record.provider_body,
+                transport_record.settled,
+                telemetry_schema_version,
+            )
+        )
+
+    _install_callbacks(monkeypatch, execution, post)
+    monkeypatch.setattr(
+        relay_runtime,
+        "resolve_execution_context",
+        lambda _session_id: (None, None, None),
+    )
+    agent._interruptible_streaming_api_call = provider
+
+    result = agent.run_conversation(
+        "hello",
+        conversation_history=[],
+        task_id="task-transport",
+    )
+
+    assert result["final_response"] == "done"
+    assert len(provider_requests) == 1
+    assert len(execution_observations) == 1
+    assert len(post_observations) == 1
+    execution_schema, transport_schema, execution_record, captured, settled = (
+        execution_observations[0]
+    )
+    assert execution_schema == "hermes.middleware.v2"
+    assert transport_schema == "hermes.transport.v1"
+    assert captured == provider_requests[0]
+    assert settled is False
+    assert post_observations[0] == (
+        "hermes.transport.v1",
+        execution_record,
+        provider_requests[0],
+        True,
+        "hermes.observer.v1",
+    )
+
+
+def test_provider_error_never_settles_or_fires_post(monkeypatch):
+    agent = _agent(monkeypatch)
+    execution_records = []
+    post_records = []
+    provider_calls = []
+
+    def provider(request, *, on_first_delta=None):
+        del on_first_delta
+        with relay_llm.provider_body_scope(request):
+            provider_calls.append(request)
+            raise RuntimeError("provider failed")
+
+    def execution(*, request, next_call, transport_record, **_kwargs):
+        execution_records.append(transport_record)
+        return next_call(request)
+
+    _install_callbacks(
+        monkeypatch,
+        execution,
+        lambda **kwargs: post_records.append(kwargs["transport_record"]),
+    )
+    monkeypatch.setattr(
+        relay_runtime,
+        "resolve_execution_context",
+        lambda _session_id: (None, None, None),
+    )
+    agent._interruptible_streaming_api_call = provider
+
+    result = agent.run_conversation(
+        "hello",
+        conversation_history=[],
+        task_id="task-transport-error",
+    )
+
+    assert result["completed"] is False
+    assert len(provider_calls) == 1
+    assert len(execution_records) == 1
+    assert execution_records[0].provider_body == provider_calls[0]
+    assert execution_records[0].settled is False
+    assert post_records == []
+
+
+def test_disable_streaming_records_final_openai_sdk_body_without_timeout(
+    monkeypatch,
+):
+    agent = _agent(monkeypatch)
+    agent.platform = "cli"
+    agent._disable_streaming = True
