             result.append(msg)
         return result
 
+    def get_messages_time_window(
+        self,
+        session_id: str,
+        *,
+        start_timestamp: float,
+        end_timestamp: float,
+        include_inactive: bool = False,
+        include_compacted: bool = False,
+        max_physical_rows: int,
+    ) -> Dict[str, Any]:
+        """Read a bounded, inclusive message timestamp window.
+
+        Lifecycle filtering and both timestamp bounds are applied by SQLite
+        before the physical-row cap.  The query reads at most
+        ``max_physical_rows + 1`` rows; the extra row is an overflow sentinel.
+        Overflow never returns a partial message body because the canonical
+        winner for a compacted generation may be beyond that prefix.
+
+        ``include_compacted`` uses the same canonical generation collapse as
+        :meth:`get_messages`.  ``include_inactive`` takes precedence and
+        returns every physical row for audit/debug use.  Complete results use
+        the same content, tool-call, and display-metadata decoding as
+        :meth:`get_messages` and remain ordered by insertion id, so regressing
+        wall clocks cannot skip or reorder messages inside the window.
+
+        ``physical_row_count`` is exact when ``scan_complete`` is true.  On
+        overflow it is the observed sentinel count (``max_physical_rows + 1``),
+        not the total number of matching rows.
+        """
+        try:
+            start = float(start_timestamp)
+            end = float(end_timestamp)
+        except (TypeError, ValueError) as exc:
+            raise ValueError("timestamps must be finite numbers") from exc
+        if not math.isfinite(start) or not math.isfinite(end):
+            raise ValueError("timestamps must be finite numbers")
+        if start > end:
+            raise ValueError("start_timestamp must be <= end_timestamp")
+        if (
+            isinstance(max_physical_rows, bool)
+            or not isinstance(max_physical_rows, int)
+            or max_physical_rows <= 0
+        ):
+            raise ValueError("max_physical_rows must be a positive integer")
+
+        if include_inactive:
+            lifecycle_clause = ""
+        elif include_compacted:
+            lifecycle_clause = " AND (active = 1 OR compacted = 1)"
+        else:
+            lifecycle_clause = " AND active = 1"
+
+        sql = (
+            "SELECT * FROM messages WHERE session_id = ? "
+            "AND timestamp >= ? AND timestamp <= ?"
+            f"{lifecycle_clause} ORDER BY id ASC LIMIT ?"
+        )
+        with self._read_ctx() as conn:
+            rows = conn.execute(
+                sql,
+                (session_id, start, end, max_physical_rows + 1),
+            ).fetchall()
+
+        physical_row_count = len(rows)
+        overflow = physical_row_count > max_physical_rows
+        if overflow:
+            return {
+                "messages": [],
+                "scan_complete": False,
+                "overflow": True,
+                "physical_row_count": physical_row_count,
+                "max_physical_rows": max_physical_rows,
+            }
+
+        if include_compacted and not include_inactive:
+            rows = self._dedupe_compacted_message_rows(rows)
+        return {
+            "messages": self._decode_message_rows(rows),
+            "scan_complete": True,
+            "overflow": False,
+            "physical_row_count": physical_row_count,
+            "max_physical_rows": max_physical_rows,
+        }
+
