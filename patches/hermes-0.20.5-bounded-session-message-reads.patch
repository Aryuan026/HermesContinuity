diff --git a/tests/test_hermes_state_time_window.py b/tests/test_hermes_state_time_window.py
new file mode 100644
index 0000000..cfb05ce
--- /dev/null
+++ b/tests/test_hermes_state_time_window.py
@@ -0,0 +1,239 @@
+"""Real SessionDB coverage for bounded timestamp-window message reads."""
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture()
+def db(tmp_path: Path):
+    store = SessionDB(tmp_path / "state.db")
+    store.create_session("window", source="test")
+    yield store
+    store.close()
+
+
+def _read(db: SessionDB, **overrides):
+    options = {
+        "start_timestamp": 0.0,
+        "end_timestamp": 1_000.0,
+        "max_physical_rows": 100,
+    }
+    options.update(overrides)
+    return db.get_messages_time_window("window", **options)
+
+
+def test_filters_before_cap_and_preserves_id_order_when_clock_regresses(db):
+    for index in range(40):
+        db.append_message("window", "user", f"old-{index}", timestamp=index)
+
+    db.append_message("window", "user", "lower-bound", timestamp=100)
+    db.append_message("window", "assistant", "outside-middle", timestamp=300)
+    db.append_message("window", "assistant", "regressed-clock", timestamp=150)
+    db.append_message("window", "user", "upper-bound", timestamp=200)
+
+    for index in range(40):
+        db.append_message(
+            "window", "assistant", f"future-{index}", timestamp=400 + index
+        )
+
+    materialized_rows = []
+
+    def count_rows(cursor, row):
+        materialized_rows.append(row)
+        return sqlite3.Row(cursor, row)
+
+    wal_active = db._wal_active
+    db._wal_active = False
+    db._conn.row_factory = count_rows
+    try:
+        result = _read(
+            db,
+            start_timestamp=100,
+            end_timestamp=200,
+            max_physical_rows=3,
+        )
+    finally:
+        db._conn.row_factory = sqlite3.Row
+        db._wal_active = wal_active
+
+    assert result["scan_complete"] is True
+    assert result["overflow"] is False
+    assert result["physical_row_count"] == 3
+    assert len(materialized_rows) == 3
+    assert [message["content"] for message in result["messages"]] == [
+        "lower-bound",
+        "regressed-clock",
+        "upper-bound",
+    ]
+
+
+def test_inclusive_bounds_and_overflow_never_return_partial_body(db):
+    db.append_message("window", "user", "start", timestamp=10)
+    db.append_message("window", "assistant", "middle", timestamp=11)
+    db.append_message("window", "user", "end", timestamp=12)
+
+    complete = _read(db, start_timestamp=10, end_timestamp=12, max_physical_rows=3)
+    assert [message["content"] for message in complete["messages"]] == [
+        "start",
+        "middle",
+        "end",
+    ]
+
+    overflow = _read(db, start_timestamp=10, end_timestamp=12, max_physical_rows=2)
+    assert overflow == {
+        "messages": [],
+        "scan_complete": False,
+        "overflow": True,
+        "physical_row_count": 3,
+        "max_physical_rows": 2,
+    }
+
+
+def test_canonical_dedupes_clone_generations_while_raw_exposes_collision(db):
+    db.append_message(
+        "window", "user", "same user", timestamp=100, api_content="old-sidecar"
+    )
+    db.append_message("window", "assistant", "same answer", timestamp=101)
+    original = db.get_messages("window")
+
+    db.archive_and_compact("window", original)
+    assert db.set_latest_user_api_content("window", "same user", "new-sidecar") == 1
+    deleted_id = db.append_message("window", "user", "soft deleted", timestamp=100.5)
+    db._execute_write(
+        lambda conn: conn.execute(
+            "UPDATE messages SET active = 0, compacted = 0 WHERE id = ?",
+            (deleted_id,),
+        )
+    )
+
+    canonical = _read(
+        db,
+        start_timestamp=100,
+        end_timestamp=101,
+        include_compacted=True,
+        max_physical_rows=4,
+    )
+    raw = _read(
+        db,
+        start_timestamp=100,
+        end_timestamp=101,
+        include_inactive=True,
+        max_physical_rows=5,
+    )
+
+    assert canonical["physical_row_count"] == 4
+    assert [message["content"] for message in canonical["messages"]] == [
+        "same user",
+        "same answer",
+    ]
+    canonical_user = next(
+        message for message in canonical["messages"] if message["role"] == "user"
+    )
+    assert canonical_user["active"] == 1
+    assert canonical_user["api_content"] == "new-sidecar"
+
+    assert raw["physical_row_count"] == 5
+    assert len(raw["messages"]) == 5
+    assert "soft deleted" not in {
+        message["content"] for message in canonical["messages"]
+    }
+    assert "soft deleted" in {message["content"] for message in raw["messages"]}
+    raw_users = [
+        message for message in raw["messages"] if message["content"] == "same user"
+    ]
+    assert [(message["active"], message["compacted"]) for message in raw_users] == [
+        (0, 1),
+        (1, 0),
+    ]
+    assert [message["api_content"] for message in raw_users] == [
+        "old-sidecar",
+        "new-sidecar",
+    ]
+
+
+def test_physical_cap_precedes_canonical_generation_dedupe(db):
+    db.append_message("window", "user", "u", timestamp=20)
+    db.append_message("window", "assistant", "a", timestamp=21)
+    db.archive_and_compact("window", db.get_messages("window"))
+
+    result = _read(
+        db,
+        start_timestamp=20,
+        end_timestamp=21,
+        include_compacted=True,
+        max_physical_rows=3,
+    )
+
+    assert result["scan_complete"] is False
+    assert result["overflow"] is True
+    assert result["messages"] == []
+    assert result["physical_row_count"] == 4
+
+
+def test_decoding_matches_get_messages(db):
+    db.append_message(
+        "window",
+        "user",
+        [{"type": "text", "text": "multimodal"}],
+        timestamp=50,
+        display_kind="notice",
+        display_metadata={"nested": {"value": 1}},
+    )
+    db.append_message(
+        "window",
+        "assistant",
+        "calling",
+        timestamp=51,
+        tool_calls=[
+            {
+                "id": "call-1",
+                "type": "function",
+                "function": {"name": "terminal", "arguments": "{}"},
+            }
+        ],
+    )
+
+    assert _read(db, start_timestamp=50, end_timestamp=51)["messages"] == (
+        db.get_messages("window")
+    )
+
+
+def test_time_window_is_available_on_read_only_session_db(tmp_path: Path):
+    db_path = tmp_path / "read-only.db"
+    writable = SessionDB(db_path)
+    writable.create_session("window", source="test")
+    writable.append_message("window", "user", "persisted", timestamp=25)
+    writable.close()
+
+    read_only = SessionDB(db_path, read_only=True)
+    try:
+        result = read_only.get_messages_time_window(
+            "window",
+            start_timestamp=25,
+            end_timestamp=25,
+            include_inactive=True,
+            max_physical_rows=1,
+        )
+    finally:
+        read_only.close()
+
+    assert result["scan_complete"] is True
+    assert [message["content"] for message in result["messages"]] == ["persisted"]
+
+
+@pytest.mark.parametrize(
+    ("overrides", "message"),
+    [
+        ({"start_timestamp": 2, "end_timestamp": 1}, "start_timestamp"),
+        ({"start_timestamp": float("nan")}, "finite"),
+        ({"max_physical_rows": 0}, "positive integer"),
+        ({"max_physical_rows": True}, "positive integer"),
+    ],
+)
+def test_invalid_window_or_capacity_is_rejected(db, overrides, message):
+    with pytest.raises(ValueError, match=message):
+        _read(db, **overrides)
