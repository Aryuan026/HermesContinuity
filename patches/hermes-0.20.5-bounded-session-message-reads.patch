+    @staticmethod
+    def _dedupe_compacted_message_rows(rows: List[Any]) -> List[Any]:
+        """Collapse physical compaction generations to canonical messages."""
+        seen: dict = {}
+        for row in rows:
+            # Tool fields participate in the dedupe key: compaction copies
+            # them verbatim, so identical tool messages across generations
+            # still collapse, while distinct tool calls that happen to share
+            # role/content/timestamp are never merged.
+            key = (
+                row["role"],
+                row["content"],
+                row["timestamp"],
+                row["tool_call_id"],
+                row["tool_calls"],
+                row["tool_name"],
+            )
+            cur = seen.get(key)
+            if cur is None or (row["active"], row["id"]) > (
+                cur["active"],
+                cur["id"],
+            ):
+                seen[key] = row
+        return sorted(seen.values(), key=lambda row: row["id"])
+
+    def _decode_message_rows(self, rows: List[Any]) -> List[Dict[str, Any]]:
+        """Decode stored message rows using the public read representation."""
         result = []
         for row in rows:
             msg = dict(row)
@@ -10258,13 +10271,102 @@ class SessionDB(SessionSearchMixin, SessionSchemaMixin, SessionPortabilityMixin)
                 try:
