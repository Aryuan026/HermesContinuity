+def _apply_request_callbacks(
+    kind: str,
+    *,
+    payload_key: str,
+    original_key: str,
+    current_payload: Dict[str, Any],
+    original_payload: Dict[str, Any],
+    context: Dict[str, Any],
+    trace: List[Dict[str, Any]],
+) -> tuple[Dict[str, Any], List[Dict[str, Any]]]:
+    """Apply request middleware in registration order.
+
+    Each callback receives the last accepted payload and an isolated copy of
+    the pre-middleware baseline.  A callback may mutate its working payload in
+    place and return it, but exceptions and invalid returns cannot corrupt the
+    last accepted payload or the baseline seen by later callbacks.
+    """
+    current = current_payload
+    for callback in _get_middleware_callbacks(kind):
+        working = _safe_copy(current)
+        call_kwargs = middleware_payload(**context)
+        call_kwargs[payload_key] = working
+        call_kwargs[original_key] = _safe_copy(original_payload)
+        try:
+            result = callback(**call_kwargs)
+        except Exception as exc:
+            logger.warning(
+                "Middleware '%s' callback %s raised: %s",
+                kind,
+                getattr(callback, "__name__", repr(callback)),
+                exc,
+            )
+            continue
+        if not isinstance(result, dict):
+            continue
+        next_payload = result.get(payload_key)
+        if not isinstance(next_payload, dict):
+            continue
+        current = _safe_copy(next_payload)
+        trace.append(_trace_entry(result))
+    return current, trace
+
+
