     kind: str,
     callbacks: List[Callable],
diff --git a/tests/test_middleware.py b/tests/test_middleware.py
new file mode 100644
index 0000000..63f275f
--- /dev/null
+++ b/tests/test_middleware.py
@@ -0,0 +1,212 @@
+from __future__ import annotations
+
+import copy
+
+from hermes_cli import middleware
+
+
+def _install_request_callbacks(monkeypatch, callbacks_by_kind):
+    monkeypatch.setattr(middleware, "_has_middleware", lambda kind: True)
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_callbacks",
+        lambda kind: list(callbacks_by_kind.get(kind, [])),
+    )
+
+
+def test_llm_request_middleware_composes_replacements_sequentially(monkeypatch):
+    baseline = {
+        "messages": [{"role": "user", "content": "hello"}],
+        "metadata": {"steps": []},
+    }
+    calls = []
+    schemas = []
+
+    def first(
+        *, request, original_request, middleware_schema_version, **_kwargs
+    ):
+        calls.append("first")
+        schemas.append(middleware_schema_version)
+        assert request == baseline
+        assert original_request == baseline
+        return {
+            "request": {**request, "metadata": {"steps": ["first"]}},
+            "source": "first",
+        }
+
+    def second(
+        *, request, original_request, middleware_schema_version, **_kwargs
+    ):
+        calls.append("second")
+        schemas.append(middleware_schema_version)
+        assert request["metadata"]["steps"] == ["first"]
+        assert original_request == baseline
+        return {
+            "request": {
+                **request,
+                "metadata": {"steps": [*request["metadata"]["steps"], "second"]},
+            },
+            "source": "second",
+        }
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.LLM_REQUEST_MIDDLEWARE: [first, second]},
+    )
+    result = middleware.apply_llm_request_middleware(baseline)
+
+    assert calls == ["first", "second"]
+    assert schemas == ["hermes.middleware.v2", "hermes.middleware.v2"]
+    assert result.payload["metadata"]["steps"] == ["first", "second"]
+    assert result.original_payload == baseline
+    assert baseline["metadata"]["steps"] == []
+    assert result.trace == [{"source": "first"}, {"source": "second"}]
+
+
+def test_exception_none_and_invalid_return_discard_working_mutations(monkeypatch):
+    baseline = {"messages": [], "metadata": {"steps": []}}
+    seen = []
+
+    def accepted(*, request, **_kwargs):
+        request["metadata"]["steps"].append("accepted")
+        return {"request": request, "source": "accepted"}
+
+    def raises(*, request, original_request, **_kwargs):
+        request["metadata"]["steps"].append("raised")
+        original_request["metadata"]["steps"].append("corrupt")
+        raise RuntimeError("boom")
+
+    def returns_none(*, request, **_kwargs):
+        # Bare mutation is not a commit: request middleware must return the
+        # documented {"request": dict} shape to publish its working copy.
+        request["metadata"]["steps"].append("none")
+        return None
+
+    def returns_invalid(*, request, **_kwargs):
+        request["metadata"]["steps"].append("invalid")
+        return {"request": "not-a-dict"}
+
+    def observes(*, request, original_request, **_kwargs):
+        seen.append((copy.deepcopy(request), copy.deepcopy(original_request)))
+        return {"request": request, "source": "observes"}
+
+    _install_request_callbacks(
+        monkeypatch,
+        {
+            middleware.LLM_REQUEST_MIDDLEWARE: [
+                accepted,
+                raises,
+                returns_none,
+                returns_invalid,
+                observes,
+            ]
+        },
+    )
+    result = middleware.apply_llm_request_middleware(baseline)
+
+    assert seen == [
+        (
+            {"messages": [], "metadata": {"steps": ["accepted"]}},
+            baseline,
+        )
+    ]
+    assert result.payload["metadata"]["steps"] == ["accepted"]
+    assert result.original_payload == baseline
+    assert baseline["metadata"]["steps"] == []
+    assert result.trace == [{"source": "accepted"}, {"source": "observes"}]
+
+
+def test_tool_request_middleware_composes_and_preserves_original_args(monkeypatch):
+    baseline = {"query": "hello", "options": {"steps": []}}
+    calls = []
+
+    def first(*, tool_name, args, original_args, **_kwargs):
+        calls.append(("first", tool_name, copy.deepcopy(original_args)))
+        args["options"]["steps"].append("first")
+        return {"args": args, "source": "first"}
+
+    def second(*, tool_name, args, original_args, **_kwargs):
+        calls.append(("second", tool_name, copy.deepcopy(original_args)))
+        assert args["options"]["steps"] == ["first"]
+        return {
+            "args": {
+                **args,
+                "options": {"steps": [*args["options"]["steps"], "second"]},
+            },
+            "source": "second",
+        }
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.TOOL_REQUEST_MIDDLEWARE: [first, second]},
+    )
+    result = middleware.apply_tool_request_middleware(
+        "web_search", baseline, skip_relay=True
+    )
+
+    assert [row[:2] for row in calls] == [
+        ("first", "web_search"),
+        ("second", "web_search"),
+    ]
+    assert all(row[2] == baseline for row in calls)
+    assert result.payload["options"]["steps"] == ["first", "second"]
+    assert result.original_payload == baseline
+    assert baseline["options"]["steps"] == []
+
+
+def test_each_retry_starts_from_a_clean_request(monkeypatch):
+    baseline = {"messages": [], "metadata": {"steps": []}}
+    call_count = 0
+
+    def callback(*, request, **_kwargs):
+        nonlocal call_count
+        call_count += 1
+        request["metadata"]["steps"].append("once")
+        return {"request": request}
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.LLM_REQUEST_MIDDLEWARE: [callback]},
+    )
+    first = middleware.apply_llm_request_middleware(baseline)
+    retry = middleware.apply_llm_request_middleware(baseline)
+
+    assert first.payload == retry.payload == {
+        "messages": [],
+        "metadata": {"steps": ["once"]},
+    }
+    assert baseline["metadata"]["steps"] == []
+    assert call_count == 2
+
+
+def test_execution_chain_still_calls_each_wrapper_and_provider_once(monkeypatch):
+    calls = []
+
+    def first(*, request, next_call, **_kwargs):
+        calls.append("first")
+        return next_call({**request, "first": True})
+
+    def second(*, request, next_call, **_kwargs):
+        calls.append("second")
+        result = next_call({**request, "second": True})
+        try:
+            next_call(request)
+        except RuntimeError:
+            calls.append("second-call-blocked")
+        return result
+
+    def provider(request):
+        calls.append("provider")
+        return request
+
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_callbacks",
+        lambda kind: [first, second]
+        if kind == middleware.LLM_EXECUTION_MIDDLEWARE
+        else [],
+    )
+    result = middleware.run_llm_execution_middleware({}, provider)
+
+    assert result == {"first": True, "second": True}
+    assert calls == ["first", "second", "provider", "second-call-blocked"]
