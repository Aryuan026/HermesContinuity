+                        domain["indexed_change_seq"] = seal_seq
+                        if deferred_tail:
+                            domain["target_max_message_id"] = current_max_id
+                            domain["scan_base_change_seq"] = seal_seq
+                        domain["invalidated_from_position"] = None
+                        domain["failure_reason"] = ""
+
+            self._history_save_domain(conn, domain)
+            if domain["phase"] == "ready":
+                self._history_prune_journal(conn, max_rows=max_changes)
+                token = self._history_prefix_token(state, domain)
+                return self._history_result(
+                    state,
+                    domain,
+                    status="ready",
+                    pages=pages,
+                    rows=physical_rows,
