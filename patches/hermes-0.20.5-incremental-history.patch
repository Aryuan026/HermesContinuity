+
+class SessionHistoryMixin:
+    """Body-free canonical index mixed into ``SessionDB``."""
+
+    def register_history_listener(
+        self,
+        domain_id: str,
+        callback: Callable[[str, int], None],
+    ) -> HistoryListenerRegistration:
+        """Register one process-local, body-free post-commit listener."""
+
+        _require_code(domain_id, "domain_id")
+        if not callable(callback):
+            raise TypeError("history listener callback must be callable")
+        path = str(self.db_path.resolve())
+        token = uuid.uuid4().hex
+        with _LISTENER_LOCK:
+            by_domain = _LISTENERS.setdefault(path, {})
+            if domain_id not in by_domain and len(by_domain) >= _MAX_LISTENER_DOMAINS:
+                if not by_domain:
+                    _LISTENERS.pop(path, None)
+                raise RuntimeError("history listener domain capacity reached")
+            by_domain.setdefault(domain_id, {})[token] = callback
+        return HistoryListenerRegistration(path, domain_id, token)
+
+    def _history_notification_baseline(
+        self, conn: sqlite3.Connection
+    ) -> Optional[tuple[int, tuple[str, ...]]]:
+        path = str(self.db_path.resolve())
+        with _LISTENER_LOCK:
+            domains = tuple(_LISTENERS.get(path, {}))
+        if not domains:
+            return None
+        try:
+            row = conn.execute(
+                "SELECT journal_tail, capture_enabled FROM hermes_history_state "
+                "WHERE singleton=1"
+            ).fetchone()
+        except sqlite3.Error:
+            return None
+        if row is None or not int(row["capture_enabled"]):
+            return None
+        return int(row["journal_tail"]), domains
+
+    @staticmethod
+    def _history_collect_notifications(
+        conn: sqlite3.Connection,
+        baseline: Optional[tuple[int, tuple[str, ...]]],
+    ) -> tuple[tuple[str, int], ...]:
+        if baseline is None:
+            return ()
+        before, domains = baseline
+        try:
+            row = conn.execute(
+                "SELECT journal_tail, capture_enabled FROM hermes_history_state "
+                "WHERE singleton=1"
+            ).fetchone()
+        except sqlite3.Error:
+            return ()
+        if row is None or not int(row["capture_enabled"]):
+            return ()
+        tail = int(row["journal_tail"])
+        if tail <= before:
+            return ()
+        affected = []
+        for domain_id in domains:
+            try:
+                old_match = conn.execute(
+                    "SELECT 1 FROM hermes_history_changes "
+                    "WHERE old_session_id=? AND change_seq>? "
+                    "AND change_seq<=? LIMIT 1",
+                    (domain_id, before, tail),
+                ).fetchone()
+                new_match = conn.execute(
+                    "SELECT 1 FROM hermes_history_changes "
+                    "WHERE new_session_id=? AND change_seq>? "
+                    "AND change_seq<=? LIMIT 1",
+                    (domain_id, before, tail),
+                ).fetchone()
+            except sqlite3.Error:
+                return ()
+            if old_match is not None or new_match is not None:
+                affected.append((domain_id, tail))
+        return tuple(affected)
+
+    def _history_dispatch_notifications(
+        self, notifications: Sequence[tuple[str, int]]
+    ) -> None:
+        if not notifications:
+            return
+        path = str(self.db_path.resolve())
+        for domain_id, tail in notifications:
+            with _LISTENER_LOCK:
+                callbacks = tuple(
+                    _LISTENERS.get(path, {}).get(domain_id, {}).values()
+                )
+            for callback in callbacks:
+                try:
+                    callback(domain_id, tail)
+                except Exception:
+                    logger.exception("history listener callback failed")
+
+    @contextmanager
+    def _history_worker_limits(self):
+        """Temporarily bound this connection's preparation cache footprint."""
+
+        with self._lock:
+            cache_size = int(self._conn.execute("PRAGMA cache_size").fetchone()[0])
+            temp_store = int(self._conn.execute("PRAGMA temp_store").fetchone()[0])
+            self._conn.execute(f"PRAGMA cache_size=-{_WORKER_CACHE_KIB}")
+            # Keep transient sort/index work out of the Python process RSS.
+            # Page/row/deadline bounds still cap every statement's input.
+            self._conn.execute("PRAGMA temp_store=FILE")
+        try:
+            yield
+        finally:
+            with self._lock:
+                self._conn.execute(f"PRAGMA cache_size={cache_size}")
+                self._conn.execute(f"PRAGMA temp_store={temp_store}")
+
+    @staticmethod
+    def _history_message_columns(conn: sqlite3.Connection) -> Sequence[str]:
+        rows = conn.execute("PRAGMA table_info(messages)").fetchall()
+        columns = [str(row[1]) for row in rows]
+        if not columns or "id" not in columns or "session_id" not in columns:
+            raise sqlite3.DatabaseError("messages schema is incompatible with history index")
+        return columns
+
+    @classmethod
+    def _history_message_columns_digest(cls, conn: sqlite3.Connection) -> str:
+        rows = conn.execute("PRAGMA table_info(messages)").fetchall()
+        return _digest([list(row) for row in rows])
+
+    @staticmethod
+    def _history_contract_ok(conn: sqlite3.Connection) -> bool:
+        required_tables = {
+            "hermes_history_state",
+            "hermes_history_changes",
+            "hermes_history_domains",
+            "hermes_history_buckets",
+            "hermes_history_members",
+        }
+        tables = {
+            str(row[0])
+            for row in conn.execute(
+                "SELECT name FROM sqlite_master WHERE type='table' "
+                "AND name LIKE 'hermes_history_%'"
+            ).fetchall()
+        }
+        if not required_tables.issubset(tables):
+            return False
+        for table, expected_columns in _TABLE_COLUMNS.items():
+            table_info = conn.execute(f"PRAGMA table_info({table})").fetchall()
+            actual_columns = {str(row[1]) for row in table_info}
+            if actual_columns != expected_columns:
+                return False
+            actual_shape = tuple(
+                (
+                    str(row[1]),
+                    str(row[2]).upper(),
+                    int(row[3]),
+                    row[4],
+                    int(row[5]),
+                )
+                for row in table_info
+            )
+            if actual_shape != _EXPECTED_TABLE_SHAPES[table]:
+                return False
+        for index, expected_columns in _HISTORY_INDEX_COLUMNS.items():
+            rows = conn.execute(f"PRAGMA index_info({index})").fetchall()
+            if tuple(str(row[2]) for row in rows) != expected_columns:
+                return False
+        triggers = {
+            str(row[0]): _normalize_sql(str(row[1] or ""))
+            for row in conn.execute(
+                "SELECT name, sql FROM sqlite_master WHERE type='trigger' "
+                "AND name LIKE 'hermes_history_%'"
+            ).fetchall()
+        }
+        if set(triggers) != set(_TRIGGER_NAMES):
+            return False
+        return triggers == _EXPECTED_TRIGGER_SQL
+
+    def _init_history_schema(self) -> None:
+        """Install derived tables and builtin triggers on a writable handle."""
+
+        conn = self._conn
+        had_state = conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' "
+            "AND name='hermes_history_state'"
+        ).fetchone() is not None
+        prior_contract_ok = had_state and self._history_contract_ok(conn)
+        if had_state and not prior_contract_ok:
+            for index in _HISTORY_INDEX_COLUMNS:
+                conn.execute(f"DROP INDEX IF EXISTS {index}")
+        conn.executescript(_HISTORY_SCHEMA_SQL)
+        columns_digest = self._history_message_columns_digest(conn)
+        realm_binding = _digest(
+            [
+                "hermes.canonical_history_realm.v1",
+                str(self.db_path.parent.resolve()),
+            ]
+        )
+        row = conn.execute(
+            "SELECT * FROM hermes_history_state WHERE singleton=1"
+        ).fetchone()
+        if row is None:
+            conn.execute(
+                "INSERT INTO hermes_history_state "
+                "(singleton, realm_id, realm_binding, incarnation, activation_epoch, "
+                "activation_process, owner_id, lease_expires_at, capture_enabled, "
+                "message_columns_digest, retained_floor, journal_tail) "
+                "VALUES (1, ?, ?, ?, '', '', '', 0, 1, ?, 0, 0)",
+                (
+                    _new_marker("hhr_"),
+                    realm_binding,
+                    _new_marker("hhi_"),
+                    columns_digest,
+                ),
+            )
+            had_state = False
+        disabled = conn.execute(
+            "SELECT value FROM state_meta WHERE key='history_capture_disabled'"
+        ).fetchone()
+        stored = conn.execute(
+            "SELECT capture_enabled, message_columns_digest, realm_binding "
+            "FROM hermes_history_state WHERE singleton=1"
+        ).fetchone()
+        realm_changed = bool(had_state and stored[2] != realm_binding)
+        incompatible = bool(had_state and (not prior_contract_ok or stored[1] != columns_digest))
+        if realm_changed:
+            new_epoch = _new_marker("hha_")
+            conn.execute(
+                "UPDATE hermes_history_state SET realm_id=?, realm_binding=?, "
+                "incarnation=?, activation_epoch=?, activation_process='', "
+                "owner_id='', lease_expires_at=0, message_columns_digest=? "
+                "WHERE singleton=1",
+                (
+                    _new_marker("hhr_"),
+                    realm_binding,
+                    _new_marker("hhi_"),
+                    new_epoch,
+                    columns_digest,
+                ),
+            )
+            conn.execute(
+                "UPDATE hermes_history_domains SET activation_epoch=?, "
+                "phase='reverification_required', invalidated_from_position=1, "
+                "failure_reason='history_realm_changed'",
+                (new_epoch,),
+            )
+        if incompatible:
+            conn.execute(
+                "UPDATE hermes_history_domains SET phase='reverification_required', "
+                "invalidated_from_position=1, failure_reason='history_contract_changed'"
+            )
+            conn.execute(
+                "UPDATE hermes_history_state SET activation_epoch=?, "
+                "activation_process='', owner_id='', lease_expires_at=0, "
+                "message_columns_digest=? WHERE singleton=1",
+                (_new_marker("hha_"), columns_digest),
+            )
+        if disabled is not None or not bool(stored[0]):
+            self._drop_history_triggers(conn)
+            conn.execute(
+                "UPDATE hermes_history_state SET capture_enabled=0 WHERE singleton=1"
+            )
+            return
+        if not prior_contract_ok or not self._history_contract_ok(conn):
+            self._replace_history_triggers(conn)
+
+    @staticmethod
+    def _drop_history_triggers(conn: sqlite3.Connection) -> None:
+        for name in _TRIGGER_NAMES:
+            conn.execute(f"DROP TRIGGER IF EXISTS {name}")
+
+    @classmethod
+    def _replace_history_triggers(cls, conn: sqlite3.Connection) -> None:
+        cls._drop_history_triggers(conn)
+        for name in _TRIGGER_NAMES:
+            conn.execute(_TRIGGER_DECLARATIONS[name])
+
+    def _is_history_index_error(self, exc: sqlite3.Error) -> bool:
+        text = str(exc).lower()
+        if "hermes_history_" in text or "history index" in text:
+            return True
+        try:
+            return not self._history_contract_ok(self._conn)
+        except sqlite3.Error:
+            return True
+
+    def _enter_history_fail_open(self, exc: sqlite3.Error) -> bool:
+        """Disable broken capture and allow the canonical write to retry."""
+
+        if getattr(self, "_history_fail_open_attempted", False):
+            return False
+        if not self._is_history_index_error(exc):
+            return False
+        self._history_fail_open_attempted = True
+        try:
+            with self._lock:
+                self._conn.execute("BEGIN IMMEDIATE")
+                try:
+                    self._conn.execute(
+                        "INSERT INTO state_meta(key, value) VALUES "
+                        "('history_capture_disabled', '1') "
+                        "ON CONFLICT(key) DO UPDATE SET value='1'"
+                    )
+                    if self._conn.execute(
+                        "SELECT 1 FROM sqlite_master WHERE type='table' "
+                        "AND name='hermes_history_state'"
+                    ).fetchone():
+                        self._conn.execute(
+                            "UPDATE hermes_history_state SET capture_enabled=0, "
+                            "activation_epoch=?, activation_process='', owner_id='', "
+                            "lease_expires_at=0 WHERE singleton=1",
+                            (_new_marker("hha_"),),
+                        )
+                    if self._conn.execute(
+                        "SELECT 1 FROM sqlite_master WHERE type='table' "
+                        "AND name='hermes_history_domains'"
+                    ).fetchone():
+                        self._conn.execute(
+                            "UPDATE hermes_history_domains SET "
+                            "phase='reverification_required', "
+                            "invalidated_from_position=1, "
+                            "failure_reason='history_capture_fault'"
+                        )
+                    self._drop_history_triggers(self._conn)
+                    self._conn.commit()
+                except BaseException:
+                    self._conn.rollback()
+                    raise
+        except sqlite3.Error:
+            return False
+        return True
+
+    def _history_with_writer(self, method: str, *args: Any, **kwargs: Any) -> Any:
+        if not self.read_only:
+            return getattr(self, method)(*args, **kwargs)
+        # The caller keeps a SELECT-only handle.  This private host-owned
+        # delegate exposes only the narrow history methods, never the writer.
+        with type(self)(db_path=self.db_path, read_only=False) as writer:
+            return getattr(writer, method)(*args, **kwargs)
+
+    @staticmethod
+    def _history_journal_contiguous(
+        conn: sqlite3.Connection, state: Mapping[str, Any]
+    ) -> bool:
+        """Verify retained journal endpoints without scanning the journal."""
+
+        floor = int(state["retained_floor"])
+        tail = int(state["journal_tail"])
+        retained_count = int(state["retained_count"])
+        if (
+            floor < 0
+            or tail < floor
+            or retained_count < 0
+            or retained_count != tail - floor
+        ):
+            return False
+        first = conn.execute(
+            "SELECT change_seq FROM hermes_history_changes "
+            "WHERE change_seq>? ORDER BY change_seq LIMIT 1",
+            (floor,),
+        ).fetchone()
+        last = conn.execute(
+            "SELECT change_seq FROM hermes_history_changes "
+            "WHERE change_seq>? ORDER BY change_seq DESC LIMIT 1",
+            (floor,),
+        ).fetchone()
+        if floor == tail:
+            return first is None and last is None
+        return (
+            first is not None
+            and last is not None
+            and int(first[0]) == floor + 1
+            and int(last[0]) == tail
+        )
+
+    @staticmethod
+    def _history_rebaseline_journal(conn: sqlite3.Connection) -> int:
+        """Discard an untrusted journal after scheduling full revalidation."""
+
+        sequence = conn.execute(
+            "SELECT seq FROM sqlite_sequence WHERE name='hermes_history_changes'"
+        ).fetchone()
+        state = conn.execute(
+            "SELECT retained_floor, journal_tail FROM hermes_history_state "
+            "WHERE singleton=1"
+        ).fetchone()
+        last = conn.execute(
+            "SELECT change_seq FROM hermes_history_changes "
+            "ORDER BY change_seq DESC LIMIT 1"
+        ).fetchone()
+        baseline = max(
+            int(sequence[0]) if sequence is not None else 0,
+            int(state[0]) if state is not None else 0,
+            int(state[1]) if state is not None else 0,
+            int(last[0]) if last is not None else 0,
+        )
+        conn.execute(
+            "UPDATE hermes_history_state SET retained_floor=?, journal_tail=? "
+            "WHERE singleton=1",
+            (baseline, baseline),
+        )
+        conn.execute(
+            "UPDATE hermes_history_state SET retained_count=0 WHERE singleton=1"
+        )
+        return baseline
+
+    @classmethod
+    def _history_prune_journal(
+        cls, conn: sqlite3.Connection, *, max_rows: int
+    ) -> int:
+        """Delete one bounded, globally consumed contiguous journal prefix."""
+
+        state = dict(
+            conn.execute(
+                "SELECT * FROM hermes_history_state WHERE singleton=1"
+            ).fetchone()
+        )
+        if not cls._history_journal_contiguous(conn, state):
+            raise sqlite3.DatabaseError("history journal continuity lost")
+        safe_row = conn.execute(
+            "SELECT MIN(indexed_change_seq) FROM hermes_history_domains"
+        ).fetchone()
+        safe_through = (
+            int(safe_row[0])
+            if safe_row is not None and safe_row[0] is not None
+            else int(state["journal_tail"])
+        )
+        floor = int(state["retained_floor"])
+        stale = conn.execute(
+            "SELECT change_seq FROM hermes_history_changes "
+            "WHERE change_seq<=? ORDER BY change_seq LIMIT ?",
+            (floor, max_rows),
+        ).fetchall()
+        if stale:
+            conn.executemany(
+                "DELETE FROM hermes_history_changes WHERE change_seq=?",
+                ((int(row[0]),) for row in stale),
+            )
+            return len(stale)
+        if safe_through <= floor:
+            return 0
+        rows = conn.execute(
+            "SELECT change_seq FROM hermes_history_changes "
+            "WHERE change_seq>? AND change_seq<=? ORDER BY change_seq LIMIT ?",
+            (floor, safe_through, max_rows),
+        ).fetchall()
+        if not rows:
+            raise sqlite3.DatabaseError("history journal retained range is missing")
+        sequences = [int(row[0]) for row in rows]
+        if sequences != list(range(floor + 1, floor + 1 + len(sequences))):
+            raise sqlite3.DatabaseError("history journal contains an internal gap")
+        new_floor = sequences[-1]
+        conn.execute(
+            "UPDATE hermes_history_state SET retained_floor=?, "
+            "retained_count=retained_count-? WHERE singleton=1",
+            (new_floor, len(sequences)),
+        )
+        conn.execute(
+            "DELETE FROM hermes_history_changes WHERE change_seq<=?",
+            (new_floor,),
+        )
+        return len(sequences)
+
+    @staticmethod
+    def _history_domain_topology(conn: sqlite3.Connection, domain_id: str) -> Optional[str]:
+        row = conn.execute(
+            "SELECT id, source, user_id, session_key, chat_id, chat_type, "
+            "thread_id, origin_json, model_config, parent_session_id, "
+            "ended_at, end_reason, "
+            "(SELECT end_reason FROM sessions parent "
+            " WHERE parent.id=sessions.parent_session_id) AS parent_end_reason "
+            "FROM sessions WHERE id=?",
+            (domain_id,),
+        ).fetchone()
+        if row is None:
+            return None
+        topology = dict(row)
+        raw_config = topology.pop("model_config", None)
+        try:
+            config = json.loads(raw_config) if isinstance(raw_config, str) else raw_config
+        except (TypeError, json.JSONDecodeError):
+            config = {"_invalid_model_config": raw_config}
+        if not isinstance(config, Mapping):
+            config = {"_invalid_model_config": config}
+        # Runtime provider knobs and UI preferences live beside the lineage
+        # markers in model_config.  Only the markers are topology: refreshing
+        # a browser/model lock must not invalidate a canonical transcript.
+        topology["lineage_markers"] = {
+            key: config.get(key)
+            for key in ("_branched_from", "_delegate_from", "_reset_from")
+            if key in config
+        }
+        topology["ended"] = topology.pop("ended_at", None) is not None
+        return "hht_" + _digest(topology)
