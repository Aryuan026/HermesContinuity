+    def _history_claim(
+        self,
+        conn: sqlite3.Connection,
+        *,
+        owner_id: str,
+        activation_epoch: Optional[str],
+    ) -> tuple[Optional[Dict[str, Any]], Optional[str]]:
+        now = time.time()
+        row = dict(
+            conn.execute("SELECT * FROM hermes_history_state WHERE singleton=1").fetchone()
+        )
+        if not self._history_journal_contiguous(conn, row):
+            conn.execute(
+                "UPDATE hermes_history_state SET capture_enabled=0 WHERE singleton=1"
+            )
+            row["capture_enabled"] = 0
+        if not row["capture_enabled"] or not self._history_contract_ok(conn):
+            # Recovery is explicit at the preparation seam.  It rotates the
+            # activation and forces every prior proof through revalidation.
+            self._replace_history_triggers(conn)
+            new_epoch = _new_marker("hha_")
+            self._history_rebaseline_journal(conn)
+            conn.execute("DELETE FROM state_meta WHERE key='history_capture_disabled'")
+            conn.execute(
+                "UPDATE hermes_history_state SET capture_enabled=1, "
+                "activation_epoch=?, activation_process=?, owner_id=?, "
+                "lease_expires_at=?, message_columns_digest=? WHERE singleton=1",
+                (
+                    new_epoch,
+                    _PROCESS_NONCE,
+                    owner_id,
+                    now + _LEASE_SECONDS,
+                    self._history_message_columns_digest(conn),
+                ),
+            )
+            conn.execute(
+                "UPDATE hermes_history_domains SET activation_epoch=?, "
+                "phase='reverification_required', invalidated_from_position=1, "
+                "failure_reason='history_capture_reactivated'",
+                (new_epoch,),
+            )
+            row = dict(
+                conn.execute("SELECT * FROM hermes_history_state WHERE singleton=1").fetchone()
+            )
+
+        live = float(row["lease_expires_at"] or 0) > now
+        same_process = row["activation_process"] == _PROCESS_NONCE
+        # Plugin-manager reloads in the same trusted host process use a new
+        # owner id but must retain committed progress and the host activation.
+        # A different process may take over only after the lease expires.
+        if live and not same_process:
+            return None, "preparation_owner_busy"
+        if activation_epoch is not None and activation_epoch != row["activation_epoch"]:
+            return None, "activation_epoch_changed"
+        if not row["activation_epoch"]:
+            new_epoch = _new_marker("hha_")
+        elif not same_process and not live:
+            new_epoch = _new_marker("hha_")
+            conn.execute(
+                "UPDATE hermes_history_domains SET activation_epoch=?, "
+                "phase='reverification_required', invalidated_from_position=1, "
+                "failure_reason='preparation_process_changed'",
+                (new_epoch,),
+            )
+        else:
+            new_epoch = str(row["activation_epoch"])
+        conn.execute(
+            "UPDATE hermes_history_state SET activation_epoch=?, "
+            "activation_process=?, owner_id=?, lease_expires_at=? WHERE singleton=1",
+            (new_epoch, _PROCESS_NONCE, owner_id, now + _LEASE_SECONDS),
+        )
+        return dict(
+            conn.execute("SELECT * FROM hermes_history_state WHERE singleton=1").fetchone()
+        ), None
+
+    @staticmethod
+    def _history_probe_expression(columns: Sequence[str]) -> str:
+        terms = [
+            f"COALESCE(length(CAST(\"{column}\" AS BLOB)), 0)"
+            for column in columns
+        ]
+        return " + ".join(terms) or "0"
+
+    def _history_probe_page(
+        self,
+        conn: sqlite3.Connection,
+        domain: Mapping[str, Any],
+        *,
+        max_rows: int,
+        max_bytes: int,
+    ) -> tuple[list[sqlite3.Row], Dict[int, int], int, bool, Optional[str]]:
+        columns = self._history_message_columns(conn)
+        expression = self._history_probe_expression(columns)
+        probes = conn.execute(
+            f"SELECT id, ({expression}) AS stored_bytes FROM messages "
+            "WHERE session_id=? AND id>? AND id<=? ORDER BY id LIMIT ?",
+            (
+                domain["domain_id"],
+                domain["cursor_message_id"],
+                domain["target_max_message_id"],
+                max_rows + 1,
+            ),
+        ).fetchall()
+        if not probes:
+            return [], {}, 0, False, None
+        selected: list[int] = []
+        selected_sizes: Dict[int, int] = {}
+        total = 0
+        for probe in probes[:max_rows]:
+            size = int(probe["stored_bytes"] or 0)
+            if size > max_bytes and not selected:
+                return [], {}, 0, True, "history_row_byte_limit_exceeded"
+            if total + size > max_bytes:
+                break
+            selected.append(int(probe["id"]))
+            selected_sizes[int(probe["id"])] = size
+            total += size
+        if not selected:
+            return [], {}, 0, True, "history_page_byte_limit_exceeded"
+        placeholders = ",".join("?" for _ in selected)
+        payload = conn.execute(
+            f"SELECT * FROM messages WHERE session_id=? AND id IN ({placeholders}) "
+            "ORDER BY id",
+            (domain["domain_id"], *selected),
+        ).fetchall()
+        more = len(probes) > len(selected)
+        return payload, selected_sizes, total, more, None
+
+    def _history_row_material(
+        self, row: sqlite3.Row, stored_bytes: int
+    ) -> Dict[str, Any]:
+        raw = dict(row)
+        decoded = self._decode_message_rows([row])[0]
+        raw_active = raw.get("active")
+        raw_compacted = raw.get("compacted")
+        lifecycle_valid = (
+            type(raw_active) is int
+            and raw_active in {0, 1}
+            and type(raw_compacted) is int
+            and raw_compacted in {0, 1}
+        )
+        raw_key = [
+            raw.get("role"),
+            raw.get("content"),
+            raw.get("timestamp"),
+            raw.get("tool_call_id"),
+            raw.get("tool_calls"),
+            raw.get("tool_name"),
+        ]
+        semantic_key = [
+            decoded.get("role"),
+            decoded.get("content"),
+            decoded.get("timestamp"),
+            decoded.get("tool_call_id"),
+            decoded.get("tool_calls"),
+            decoded.get("tool_name"),
+        ]
+        raw_signature = _digest(
+            {key: value for key, value in raw.items() if key not in {"id", "active", "compacted"}}
+        )
+        semantic_signature = _digest(
+            {
+                key: value
+                for key, value in decoded.items()
+                if key not in {"id", "active", "compacted"}
+            }
+        )
+        semantic_key_digest = _digest(semantic_key)
+        anchor = "hca_" + _digest(
+            ["hermes.canonical_history_anchor.v1", raw.get("session_id"), semantic_key_digest]
+        )
+        return {
+            "message_id": int(raw["id"]),
+            "anchor": anchor,
+            "raw_key_digest": _digest(raw_key),
+            "semantic_key_digest": semantic_key_digest,
+            "raw_signature": raw_signature,
+            "semantic_signature": semantic_signature,
+            "stored_bytes": stored_bytes,
+            "active": int(raw_active) if lifecycle_valid else -1,
+            "compacted": int(raw_compacted) if lifecycle_valid else -1,
+        }
+
+    def _history_index_row(
+        self,
+        conn: sqlite3.Connection,
+        domain: Dict[str, Any],
+        row: sqlite3.Row,
+        stored_bytes: int,
+    ) -> Optional[str]:
+        material = self._history_row_material(row, stored_bytes)
+        # Rewound rows remain durable but are absent from the canonical view,
+        # matching SessionDB.get_messages(include_compacted=True) plus the
+        # raw lifecycle audit.  Their restore/update is journaled and causes
+        # the affected suffix to be rebuilt from the current row.
+        if (material["active"], material["compacted"]) == (0, 0):
+            return None
+        if (material["active"], material["compacted"]) not in {(1, 0), (0, 1)}:
+            return "source_lifecycle_invalid"
+        existing_member = conn.execute(
+            "SELECT * FROM hermes_history_members WHERE domain_id=? AND message_id=?",
+            (domain["domain_id"], material["message_id"]),
+        ).fetchone()
+        if existing_member is not None:
+            old = dict(existing_member)
+            comparable = {
+                key: old[key]
+                for key in (
+                    "anchor",
+                    "raw_key_digest",
+                    "semantic_key_digest",
+                    "raw_signature",
+                    "semantic_signature",
+                    "stored_bytes",
+                    "active",
+                    "compacted",
+                )
+            }
+            if comparable == {key: material[key] for key in comparable}:
+                return None
+            return "indexed_row_changed_without_invalidation"
+        bucket_row = conn.execute(
+            "SELECT * FROM hermes_history_buckets "
+            "WHERE domain_id=? AND semantic_key_digest=?",
+            (domain["domain_id"], material["semantic_key_digest"]),
+        ).fetchone()
+        if bucket_row is None:
+            position = int(domain["canonical_count"]) + 1
+            canonical_digest = _chain_digest(
+                "hermes.canonical_history_record.v1",
+                domain["domain_id"],
+                material["anchor"],
+                material["semantic_signature"],
+            )
+            prefix_hash = _chain_digest(domain["prefix_hash"], canonical_digest)
+            conn.execute(
+                "INSERT INTO hermes_history_buckets "
+                "(domain_id, anchor, position, raw_key_digest, semantic_key_digest, "
+                "raw_signature, semantic_signature, earliest_message_id, "
+                "winner_message_id, winner_stored_bytes, physical_count, "
+                "active_count, active, compacted, last_physical_change_seq, "
+                "physical_prefix_max_seq, canonical_digest, prefix_hash) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?, 0, ?, ?)",
+                (
+                    domain["domain_id"],
+                    material["anchor"],
+                    position,
+                    material["raw_key_digest"],
+                    material["semantic_key_digest"],
+                    material["raw_signature"],
+                    material["semantic_signature"],
+                    material["message_id"],
+                    material["message_id"],
+                    material["stored_bytes"],
+                    material["active"],
+                    material["active"],
+                    material["compacted"],
+                    domain["scan_base_change_seq"],
+                    canonical_digest,
+                    prefix_hash,
+                ),
+            )
+            domain["canonical_count"] = position
+            domain["end_anchor"] = material["anchor"]
+            domain["prefix_hash"] = prefix_hash
+        else:
+            bucket = dict(bucket_row)
+            if (
+                bucket["raw_key_digest"] != material["raw_key_digest"]
+                or bucket["raw_signature"] != material["raw_signature"]
+                or bucket["semantic_signature"] != material["semantic_signature"]
+            ):
+                return "canonical_clone_audit_collision"
+            if material["active"] and int(bucket["active_count"]) > 0:
+                return "canonical_active_collision"
+            if not material["active"] and int(bucket["active_count"]) > 0:
+                return "canonical_clone_order_invalid"
+            winner_id = material["message_id"]
+            winner_bytes = material["stored_bytes"]
+            active_count = int(bucket["active_count"]) + material["active"]
+            domain["physical_cursor_position"] = min(
+                int(domain["physical_cursor_position"]),
+                int(bucket["position"]) - 1,
+            )
+            conn.execute(
+                "UPDATE hermes_history_buckets SET winner_message_id=?, "
+                "winner_stored_bytes=?, physical_count=physical_count+1, "
+                "active_count=?, active=?, compacted=?, last_physical_change_seq=? "
+                "WHERE domain_id=? AND anchor=?",
+                (
+                    winner_id,
+                    winner_bytes,
+                    active_count,
+                    material["active"],
+                    material["compacted"],
+                    domain["scan_base_change_seq"],
+                    domain["domain_id"],
+                    material["anchor"],
+                ),
+            )
+        conn.execute(
+            "INSERT INTO hermes_history_members "
+            "(domain_id, message_id, anchor, raw_key_digest, semantic_key_digest, "
+            "raw_signature, semantic_signature, stored_bytes, active, compacted) "
+            "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                domain["domain_id"],
+                material["message_id"],
+                material["anchor"],
+                material["raw_key_digest"],
+                material["semantic_key_digest"],
+                material["raw_signature"],
+                material["semantic_signature"],
+                material["stored_bytes"],
+                material["active"],
+                material["compacted"],
+            ),
+        )
+        return None
+
+    @staticmethod
+    def _history_reset_suffix(
+        conn: sqlite3.Connection,
+        domain: Dict[str, Any],
+        position: int,
+    ) -> None:
+        position = max(1, min(position, int(domain["canonical_count"]) + 1))
+        if domain.get("phase") == "resetting" and type(
+            domain.get("invalidated_from_position")
+        ) is int:
+            position = min(position, int(domain["invalidated_from_position"]))
+        domain["phase"] = "resetting"
+        domain["invalidated_from_position"] = position
+        domain["physical_cursor_position"] = min(
+            int(domain["physical_cursor_position"]), position - 1
+        )
+
+    @staticmethod
+    def _history_reset_suffix_page(
+        conn: sqlite3.Connection,
+        domain: Dict[str, Any],
+        *,
+        max_rows: int,
+    ) -> tuple[int, bool]:
+        """Delete one bounded suffix page and persist reset progress."""
+
+        position = domain.get("invalidated_from_position")
+        if type(position) is not int or position < 1:
+            raise sqlite3.DatabaseError("history reset position is invalid")
+        domain_id = domain["domain_id"]
+        processed = 0
+        restart = 1
+        while processed < max_rows:
+            bucket = conn.execute(
+                "SELECT anchor, position, earliest_message_id "
+                "FROM hermes_history_buckets WHERE domain_id=? AND position>=? "
+                "ORDER BY position DESC LIMIT 1",
+                (domain_id, position),
+            ).fetchone()
+            if bucket is None:
+                break
+            remaining = max_rows - processed
+            members = conn.execute(
+                "SELECT message_id FROM hermes_history_members "
+                "WHERE domain_id=? AND anchor=? "
+                "ORDER BY message_id DESC LIMIT ?",
+                (domain_id, bucket["anchor"], remaining),
+            ).fetchall()
+            if members:
+                conn.executemany(
+                    "DELETE FROM hermes_history_members "
+                    "WHERE domain_id=? AND message_id=?",
+                    ((domain_id, int(row["message_id"])) for row in members),
+                )
+                processed += len(members)
+                if processed >= max_rows:
+                    return processed, False
+            restart = int(bucket["earliest_message_id"])
+            conn.execute(
+                "DELETE FROM hermes_history_buckets "
+                "WHERE domain_id=? AND anchor=?",
+                (domain_id, str(bucket["anchor"])),
+            )
+            processed += 1
+
+        remaining_bucket = conn.execute(
+            "SELECT 1 FROM hermes_history_buckets "
+            "WHERE domain_id=? AND position>=? LIMIT 1",
+            (domain_id, position),
+        ).fetchone()
+        if remaining_bucket is not None:
+            return processed, False
+        previous = conn.execute(
+            "SELECT anchor, prefix_hash FROM hermes_history_buckets "
+            "WHERE domain_id=? AND position=?",
+            (domain_id, position - 1),
+        ).fetchone()
+        domain["canonical_count"] = position - 1
+        domain["end_anchor"] = str(previous["anchor"]) if previous else ""
+        domain["prefix_hash"] = (
+            str(previous["prefix_hash"]) if previous else _prefix_zero(domain_id)
+        )
+        domain["cursor_message_id"] = restart - 1
+        domain["phase"] = "building"
+        return processed, True
+
+    @staticmethod
+    def _history_affected_position(
+        conn: sqlite3.Connection,
+        domain_id: str,
+        changes: Sequence[sqlite3.Row],
+        cursor_message_id: int,
+    ) -> Optional[int]:
+        affected: Optional[int] = None
+        for change in changes:
+            if change["object_kind"] == "session":
+                # The current normalized session topology is compared before
+                # journal classification.  Session UPDATE triggers may fire
+                # for a no-op assignment or a runtime-only model_config key;
+                # neither changes any canonical message bucket.
+                continue
+            ids = {
+                value
+                for value in (change["old_row_id"], change["new_row_id"])
+                if type(value) is int
+            }
+            for message_id in ids:
+                row = conn.execute(
+                    "SELECT b.position FROM hermes_history_members m "
+                    "JOIN hermes_history_buckets b ON b.domain_id=m.domain_id "
+                    "AND b.anchor=m.anchor WHERE m.domain_id=? AND m.message_id=?",
+                    (domain_id, message_id),
+                ).fetchone()
+                if row is not None:
+                    position = int(row[0])
+                    affected = position if affected is None else min(affected, position)
+                elif message_id <= cursor_message_id:
+                    return 1
+            if change["operation"] in {"update", "delete"} and not ids:
+                return 1
+        return affected
+
+    def _history_changes_are_unique_tail(
+        self,
+        conn: sqlite3.Connection,
+        domain: Mapping[str, Any],
+        changes: Sequence[sqlite3.Row],
+        *,
+        max_bytes: int,
+    ) -> bool:
+        """Prove a bounded journal slice adds only new post-target anchors."""
+
+        message_ids: list[int] = []
+        target = int(domain["target_max_message_id"])
+        for change in changes:
+            if change["object_kind"] == "session":
+                continue
+            message_id = change["new_row_id"]
+            if (
+                change["object_kind"] != "message"
+                or change["operation"] != "insert"
+                or change["old_row_id"] is not None
+                or type(message_id) is not int
+                or message_id <= target
+                or change["new_session_id"] != domain["domain_id"]
+            ):
+                return False
+            message_ids.append(message_id)
+        if not message_ids:
+            return False
+        if len(message_ids) != len(set(message_ids)):
+            return False
+        columns = self._history_message_columns(conn)
+        expression = self._history_probe_expression(columns)
+        placeholders = ",".join("?" for _ in message_ids)
+        probes = conn.execute(
+            f"SELECT id, ({expression}) AS stored_bytes FROM messages "
+            f"WHERE session_id=? AND id IN ({placeholders}) ORDER BY id",
+            (domain["domain_id"], *message_ids),
+        ).fetchall()
+        if len(probes) != len(message_ids):
+            return False
+        sizes = {int(row["id"]): int(row["stored_bytes"] or 0) for row in probes}
+        if any(size > max_bytes for size in sizes.values()):
+            return False
+        total = sum(sizes.values())
+        if total > max_bytes:
+            return False
+        rows = conn.execute(
+            f"SELECT * FROM messages WHERE session_id=? "
+            f"AND id IN ({placeholders}) ORDER BY id",
+            (domain["domain_id"], *message_ids),
+        ).fetchall()
+        seen: set[str] = set()
+        for row in rows:
+            material = self._history_row_material(row, sizes[int(row["id"])])
+            if (material["active"], material["compacted"]) not in {(1, 0), (0, 1)}:
+                return False
+            semantic_key = material["semantic_key_digest"]
+            if semantic_key in seen:
+                return False
+            seen.add(semantic_key)
+            collision = conn.execute(
+                "SELECT 1 FROM hermes_history_buckets "
+                "WHERE domain_id=? AND semantic_key_digest=?",
+                (domain["domain_id"], semantic_key),
+            ).fetchone()
+            if collision is not None:
+                return False
+        return True
+
+    @staticmethod
+    def _history_finalize_physical_page(
+        conn: sqlite3.Connection,
+        domain: Dict[str, Any],
+        *,
+        max_rows: int,
+    ) -> tuple[int, bool]:
+        """Advance one bounded prefix-max page over finalized buckets."""
+
+        cursor = int(domain["physical_cursor_position"])
+        previous = 0
+        if cursor:
+            row = conn.execute(
+                "SELECT physical_prefix_max_seq FROM hermes_history_buckets "
+                "WHERE domain_id=? AND position=?",
+                (domain["domain_id"], cursor),
+            ).fetchone()
+            if row is None:
+                raise sqlite3.DatabaseError("history physical prefix cursor is missing")
+            previous = int(row[0])
+        rows = conn.execute(
+            "SELECT position, last_physical_change_seq "
+            "FROM hermes_history_buckets WHERE domain_id=? AND position>? "
+            "ORDER BY position LIMIT ?",
+            (domain["domain_id"], cursor, max_rows + 1),
+        ).fetchall()
+        selected = rows[:max_rows]
+        expected = cursor + 1
+        updates = []
+        for row in selected:
+            position = int(row["position"])
+            if position != expected:
+                raise sqlite3.DatabaseError("history physical prefix contains a gap")
+            previous = max(previous, int(row["last_physical_change_seq"]))
+            updates.append((previous, domain["domain_id"], position))
+            expected += 1
+        if updates:
+            conn.executemany(
+                "UPDATE hermes_history_buckets SET physical_prefix_max_seq=? "
+                "WHERE domain_id=? AND position=?",
+                updates,
+            )
+            domain["physical_cursor_position"] = updates[-1][2]
+        complete = (
+            len(rows) <= max_rows
+            and int(domain["physical_cursor_position"]) == int(domain["canonical_count"])
+        )
+        return len(selected), complete
+
+    @staticmethod
+    def _history_save_domain(conn: sqlite3.Connection, domain: Mapping[str, Any]) -> None:
+        conn.execute(
+            "UPDATE hermes_history_domains SET topology_revision=?, "
+            "canonical_rule_version=?, activation_epoch=?, phase=?, "
+            "target_max_message_id=?, scan_base_change_seq=?, "
+            "indexed_change_seq=?, cursor_message_id=?, physical_cursor_position=?, "
+            "canonical_count=?, "
+            "end_anchor=?, prefix_hash=?, invalidated_from_position=?, "
+            "failure_reason=?, updated_at=? WHERE domain_id=?",
+            (
+                domain["topology_revision"],
+                HISTORY_RULE_VERSION,
+                domain["activation_epoch"],
+                domain["phase"],
+                domain["target_max_message_id"],
+                domain["scan_base_change_seq"],
+                domain["indexed_change_seq"],
+                domain["cursor_message_id"],
+                domain["physical_cursor_position"],
+                domain["canonical_count"],
+                domain["end_anchor"],
+                domain["prefix_hash"],
+                domain.get("invalidated_from_position"),
+                domain.get("failure_reason", ""),
+                time.time(),
+                domain["domain_id"],
+            ),
+        )
+
+    def prepare_history_step(
+        self,
+        domain_id: str,
+        *,
+        owner_id: str,
+        activation_epoch: Optional[str] = None,
+        max_pages: int = 8,
+        max_rows_per_page: int = 256,
+        max_page_bytes: int = 4 * 1024 * 1024,
+        max_changes: int = 256,
+        deadline_ms: int = 100,
+    ) -> Dict[str, Any]:
+        """Advance one bounded preparation quantum for a session domain."""
+
+        _require_code(domain_id, "domain_id")
+        _require_code(owner_id, "owner_id")
+        if activation_epoch is not None:
+            _require_code(activation_epoch, "activation_epoch")
+        for value, name in (
+            (max_pages, "max_pages"),
+            (max_rows_per_page, "max_rows_per_page"),
+            (max_page_bytes, "max_page_bytes"),
+            (max_changes, "max_changes"),
+            (deadline_ms, "deadline_ms"),
+        ):
+            if type(value) is not int or value <= 0:
+                raise ValueError(f"{name} must be a positive integer")
+        if self.read_only:
+            return self._history_with_writer(
+                "prepare_history_step",
+                domain_id,
+                owner_id=owner_id,
+                activation_epoch=activation_epoch,
+                max_pages=max_pages,
+                max_rows_per_page=max_rows_per_page,
+                max_page_bytes=max_page_bytes,
+                max_changes=max_changes,
+                deadline_ms=deadline_ms,
+            )
+
+        # A confirmed derived-index fault may have removed a journal table.
+        # Recreate only the host-owned schema before entering the bounded
+        # write transaction; _history_claim then rotates activation and
+        # forces canonical revalidation before any proof can become ready.
+        if not self._history_contract_ok(self._conn):
+            with self._lock:
+                self._init_history_schema()
+
+        deadline = time.monotonic() + deadline_ms / 1000.0
+
+        def _do_body(conn: sqlite3.Connection) -> Dict[str, Any]:
+            state, claim_error = self._history_claim(
+                conn, owner_id=owner_id, activation_epoch=activation_epoch
+            )
+            fallback_state = dict(
+                conn.execute("SELECT * FROM hermes_history_state WHERE singleton=1").fetchone()
+            )
+            if claim_error:
+                return self._history_result(
+                    fallback_state,
+                    {"domain_id": domain_id},
+                    status="busy" if claim_error == "preparation_owner_busy" else "incompatible",
+                    reason=claim_error,
+                )
+            assert state is not None
+            topology = self._history_domain_topology(conn, domain_id)
+            if topology is None:
+                return self._history_result(
+                    state,
+                    {"domain_id": domain_id},
+                    status="incompatible",
+                    reason="history_domain_missing",
+                )
+            current_seq = int(state["journal_tail"])
+            max_id_row = conn.execute(
+                "SELECT COALESCE(MAX(id), 0) FROM messages WHERE session_id=?",
+                (domain_id,),
+            ).fetchone()
+            current_max_id = int(max_id_row[0])
+            existing = conn.execute(
+                "SELECT * FROM hermes_history_domains WHERE domain_id=?",
+                (domain_id,),
+            ).fetchone()
+            if existing is None:
+                conn.execute(
+                    "INSERT INTO hermes_history_domains "
+                    "(domain_id, topology_revision, canonical_rule_version, "
+                    "activation_epoch, phase, target_max_message_id, "
+                    "scan_base_change_seq, indexed_change_seq, cursor_message_id, "
+                    "physical_cursor_position, canonical_count, end_anchor, prefix_hash, "
+                    "invalidated_from_position, failure_reason, updated_at) "
+                    "VALUES (?, ?, ?, ?, 'building', ?, ?, ?, 0, 0, 0, '', ?, NULL, '', ?)",
+                    (
+                        domain_id,
+                        topology,
+                        HISTORY_RULE_VERSION,
+                        state["activation_epoch"],
+                        current_max_id,
+                        current_seq,
+                        current_seq,
+                        _prefix_zero(domain_id),
+                        time.time(),
+                    ),
+                )
+                existing = conn.execute(
+                    "SELECT * FROM hermes_history_domains WHERE domain_id=?",
+                    (domain_id,),
+                ).fetchone()
+            domain = dict(existing)
+            if domain["activation_epoch"] != state["activation_epoch"]:
+                domain["activation_epoch"] = state["activation_epoch"]
+                self._history_reset_suffix(conn, domain, 1)
+                domain["target_max_message_id"] = current_max_id
+                domain["scan_base_change_seq"] = current_seq
+                domain["failure_reason"] = "activation_epoch_changed"
+            if domain["topology_revision"] != topology:
+                domain["topology_revision"] = topology
