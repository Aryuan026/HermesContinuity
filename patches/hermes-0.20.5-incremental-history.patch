+    def invalidate_history_for_rollback(self) -> Dict[str, Any]:
+        """Invalidate proofs and detach capture before an older host takes over."""
+
+        if self.read_only:
+            return self._history_with_writer("invalidate_history_for_rollback")
+
+        def _do(conn: sqlite3.Connection) -> Dict[str, Any]:
+            state = dict(
+                conn.execute(
+                    "SELECT * FROM hermes_history_state WHERE singleton=1"
+                ).fetchone()
+            )
+            disabled = conn.execute(
+                "SELECT 1 FROM state_meta WHERE key='history_capture_disabled'"
+            ).fetchone()
+            if state["capture_enabled"] or disabled is None:
+                epoch = _new_marker("hha_")
+                conn.execute(
+                    "UPDATE hermes_history_state SET capture_enabled=0, "
+                    "activation_epoch=?, activation_process='', owner_id='', "
+                    "lease_expires_at=0 WHERE singleton=1",
+                    (epoch,),
+                )
+                conn.execute(
+                    "UPDATE hermes_history_domains SET activation_epoch=?, "
+                    "phase='reverification_required', invalidated_from_position=1, "
+                    "failure_reason='history_rollback_handoff'",
+                    (epoch,),
+                )
+            else:
+                epoch = str(state["activation_epoch"])
+            conn.execute(
+                "INSERT INTO state_meta(key, value) VALUES "
+                "('history_capture_disabled', 'rollback') "
+                "ON CONFLICT(key) DO UPDATE SET value='rollback'"
+            )
+            self._drop_history_triggers(conn)
+            return {
+                "schema": HISTORY_INVALIDATION_SCHEMA,
+                "status": "invalidated",
+                "reason": "rollback_handoff",
+                "activation_epoch": epoch,
+                "capture_enabled": False,
+            }
+
+        return self._execute_write(_do)
+
+    @staticmethod
+    def _history_validation_result(
+        status: str,
+        reason: str,
+        *,
+        current_seq: int = 0,
+        invalidated_from: Optional[int] = None,
+    ) -> Dict[str, Any]:
+        return {
+            "schema": HISTORY_VALIDATION_SCHEMA,
+            "status": status,
+            "reason": reason,
+            "current_indexed_change_seq": current_seq,
+            "invalidated_from_position": invalidated_from,
+        }
+
+    def _history_validate_token_conn(
+        self, conn: sqlite3.Connection, token: Mapping[str, Any]
+    ) -> Dict[str, Any]:
+        try:
+            normalized = _normalize_prefix_token(token)
+        except ValueError as exc:
+            return self._history_validation_result("incompatible", str(exc))
+        if not self._history_contract_ok(conn):
+            return self._history_validation_result(
+                "incompatible", "history_contract_missing"
+            )
+        state_row = conn.execute(
+            "SELECT * FROM hermes_history_state WHERE singleton=1"
+        ).fetchone()
+        domain_row = conn.execute(
+            "SELECT * FROM hermes_history_domains WHERE domain_id=?",
+            (normalized["domain_id"],),
+        ).fetchone()
+        if state_row is None or domain_row is None:
+            return self._history_validation_result("incompatible", "history_domain_missing")
+        state = dict(state_row)
+        domain = dict(domain_row)
+        current_seq = int(domain["indexed_change_seq"])
+        if not state["capture_enabled"] or not self._history_journal_contiguous(
+            conn, state
+        ):
+            return self._history_validation_result(
+                "incompatible", "history_journal_untrusted", current_seq=current_seq
+            )
+        if (
+            normalized["realm_id"] != state["realm_id"]
+            or normalized["incarnation"] != state["incarnation"]
+            or normalized["activation_epoch"] != domain["activation_epoch"]
+            or normalized["topology_revision"] != domain["topology_revision"]
+        ):
+            return self._history_validation_result(
+                "incompatible", "history_identity_changed", current_seq=current_seq
+            )
+        current_topology = self._history_domain_topology(
+            conn, normalized["domain_id"]
+        )
+        if current_topology != domain["topology_revision"]:
+            return self._history_validation_result(
+                "incompatible", "history_topology_changed", current_seq=current_seq
+            )
+        if int(normalized["indexed_change_seq"]) > current_seq:
+            return self._history_validation_result(
+                "incompatible", "history_watermark_from_future", current_seq=current_seq
+            )
+        pending = conn.execute(
+            "SELECT 1 FROM hermes_history_changes WHERE change_seq>? "
+            "AND (old_session_id=? OR new_session_id=?) LIMIT 1",
+            (
+                current_seq,
+                normalized["domain_id"],
+                normalized["domain_id"],
+            ),
+        ).fetchone()
+        if pending is not None or domain["phase"] != "ready":
+            return self._history_validation_result(
+                "pending",
+                "history_changes_pending",
+                current_seq=current_seq,
+                invalidated_from=domain["invalidated_from_position"],
+            )
+        count = int(normalized["canonical_count"])
+        if count == 0:
+            actual_anchor = ""
+            actual_hash = _prefix_zero(normalized["domain_id"])
+            physical_prefix_max = 0
+        else:
+            row = conn.execute(
+                "SELECT anchor, prefix_hash, physical_prefix_max_seq "
+                "FROM hermes_history_buckets "
+                "WHERE domain_id=? AND position=?",
+                (normalized["domain_id"], count),
+            ).fetchone()
+            if row is None:
+                return self._history_validation_result(
+                    "changed", "history_prefix_shortened", current_seq=current_seq
+                )
+            actual_anchor, actual_hash = str(row["anchor"]), str(row["prefix_hash"])
+            physical_prefix_max = int(row["physical_prefix_max_seq"])
+        if (
+            actual_anchor != normalized["end_anchor"]
+            or actual_hash != normalized["prefix_hash"]
+        ):
+            return self._history_validation_result(
+                "changed",
+                "history_prefix_changed",
+                current_seq=current_seq,
+                invalidated_from=domain["invalidated_from_position"],
+            )
+        physical_refresh = None
+        watermark = int(normalized["indexed_change_seq"])
+        if physical_prefix_max > watermark:
+            low, high = 1, count
+            while low < high:
+                middle = (low + high) // 2
+                probe = conn.execute(
+                    "SELECT physical_prefix_max_seq FROM hermes_history_buckets "
+                    "WHERE domain_id=? AND position=?",
+                    (normalized["domain_id"], middle),
+                ).fetchone()
+                if probe is None:
+                    return self._history_validation_result(
+                        "changed",
+                        "history_physical_prefix_missing",
+                        current_seq=current_seq,
+                    )
+                if int(probe[0]) > watermark:
+                    high = middle
+                else:
+                    low = middle + 1
+            physical_refresh = low
+        return self._history_validation_result(
+            "valid",
+            "",
+            current_seq=current_seq,
+            invalidated_from=physical_refresh,
+        )
+
+    def validate_history_prefix(self, token: Mapping[str, Any]) -> Dict[str, Any]:
+        """Validate a prefix proof without starting preparation or a model."""
+
+        with self._read_ctx() as conn:
+            conn.execute("BEGIN")
+            try:
+                return self._history_validate_token_conn(conn, token)
+            finally:
+                conn.rollback()
+
+    def seal_history_prefix(
+        self,
+        domain_id: str,
+        *,
+        activation_epoch: str,
+        end_anchor: Optional[str],
+    ) -> Dict[str, Any]:
+        """Mint a proof for a prepared complete prefix ending at ``anchor``."""
+
+        _require_code(domain_id, "domain_id")
+        _require_code(activation_epoch, "activation_epoch")
+        anchor = "" if end_anchor is None else _require_anchor(end_anchor, "end_anchor")
+        with self._read_ctx() as conn:
+            conn.execute("BEGIN")
+            try:
+                if not self._history_contract_ok(conn):
+                    return {
+                        "schema": HISTORY_SEAL_SCHEMA,
+                        "status": "incompatible",
+                        "reason": "history_contract_missing",
+                        "token": None,
+                    }
+                state_row = conn.execute(
+                    "SELECT * FROM hermes_history_state WHERE singleton=1"
+                ).fetchone()
+                domain_row = conn.execute(
+                    "SELECT * FROM hermes_history_domains WHERE domain_id=?",
+                    (domain_id,),
+                ).fetchone()
+                if state_row is None or domain_row is None:
+                    return {
+                        "schema": HISTORY_SEAL_SCHEMA,
+                        "status": "incompatible",
+                        "reason": "history_domain_missing",
+                        "token": None,
+                    }
+                state, domain = dict(state_row), dict(domain_row)
+                if domain["activation_epoch"] != activation_epoch:
+                    return {
+                        "schema": HISTORY_SEAL_SCHEMA,
+                        "status": "incompatible",
+                        "reason": "activation_epoch_changed",
+                        "token": None,
+                    }
+                validation = self._history_validate_token_conn(
+                    conn, self._history_prefix_token(state, domain)
+                )
+                if validation["status"] != "valid":
+                    return {
+                        "schema": HISTORY_SEAL_SCHEMA,
+                        "status": validation["status"],
+                        "reason": validation["reason"],
+                        "token": None,
+                    }
+                if anchor == "":
+                    token = self._history_prefix_token(
+                        state,
+                        domain,
+                        count=0,
+                        anchor="",
+                        prefix_hash=_prefix_zero(domain_id),
+                    )
+                else:
+                    row = conn.execute(
+                        "SELECT position, prefix_hash FROM hermes_history_buckets "
+                        "WHERE domain_id=? AND anchor=?",
+                        (domain_id, anchor),
+                    ).fetchone()
+                    if row is None:
+                        return {
+                            "schema": HISTORY_SEAL_SCHEMA,
+                            "status": "changed",
+                            "reason": "history_anchor_unknown",
+                            "token": None,
+                        }
+                    token = self._history_prefix_token(
+                        state,
+                        domain,
+                        count=int(row["position"]),
+                        anchor=anchor,
+                        prefix_hash=str(row["prefix_hash"]),
+                    )
+                return {
+                    "schema": HISTORY_SEAL_SCHEMA,
+                    "status": "valid",
+                    "reason": "",
+                    "token": token,
+                }
+            finally:
+                conn.rollback()
+
+    def read_history_page(
+        self,
+        domain_id: str,
+        *,
+        target: Mapping[str, Any],
+        cursor: Optional[Mapping[str, Any]] = None,
+        max_rows: int = 256,
+        max_bytes: int = 4 * 1024 * 1024,
+    ) -> Dict[str, Any]:
+        """Read one keyset page after proving the fixed target is current."""
+
+        _require_code(domain_id, "domain_id")
+        token = _normalize_prefix_token(target)
+        if token["domain_id"] != domain_id:
+            raise ValueError("target belongs to a different history domain")
+        if type(max_rows) is not int or max_rows <= 0:
+            raise ValueError("max_rows must be a positive integer")
+        if type(max_bytes) is not int or max_bytes <= 0:
+            raise ValueError("max_bytes must be a positive integer")
+        page_cursor = (
+            make_history_cursor(token)
+            if cursor is None
+            else _normalize_cursor(cursor, token)
+        )
+        with self._read_ctx() as conn:
+            conn.execute("BEGIN")
+            try:
+                validation = self._history_validate_token_conn(conn, token)
+                if validation["status"] != "valid":
+                    return {
+                        "schema": HISTORY_PAGE_SCHEMA,
+                        "status": validation["status"],
+                        "reason": validation["reason"],
+                        "target": token,
+                        "rows": [],
+                        "entries": [],
+                        "page_token": None,
+                        "next_cursor": None,
+                        "scan_complete": False,
+                        "returned_rows": 0,
+                        "stored_bytes": 0,
+                    }
+                index_rows = conn.execute(
+                    "SELECT * FROM hermes_history_buckets WHERE domain_id=? "
+                    "AND position>? AND position<=? ORDER BY position LIMIT ?",
+                    (
+                        domain_id,
+                        page_cursor["after_position"],
+                        token["canonical_count"],
+                        max_rows + 1,
+                    ),
+                ).fetchall()
+                selected = []
+                total = 0
+                for index_row in index_rows[:max_rows]:
+                    size = int(index_row["winner_stored_bytes"])
+                    if size > max_bytes and not selected:
+                        return {
+                            "schema": HISTORY_PAGE_SCHEMA,
+                            "status": "overflow",
+                            "reason": "history_row_byte_limit_exceeded",
+                            "target": token,
+                            "rows": [],
+                            "entries": [],
+                            "page_token": None,
+                            "next_cursor": None,
+                            "scan_complete": False,
+                            "returned_rows": 0,
+                            "stored_bytes": 0,
+                        }
+                    if total + size > max_bytes:
+                        break
+                    selected.append(index_row)
+                    total += size
+                if not selected and index_rows:
+                    raise AssertionError("history page budget selection made no progress")
+                winner_ids = [int(row["winner_message_id"]) for row in selected]
+                raw_rows: list[sqlite3.Row] = []
+                if winner_ids:
+                    placeholders = ",".join("?" for _ in winner_ids)
+                    fetched = conn.execute(
+                        f"SELECT * FROM messages WHERE session_id=? "
+                        f"AND id IN ({placeholders})",
+                        (domain_id, *winner_ids),
+                    ).fetchall()
+                    by_id = {int(row["id"]): row for row in fetched}
+                    if set(by_id) != set(winner_ids):
+                        return {
+                            "schema": HISTORY_PAGE_SCHEMA,
+                            "status": "changed",
+                            "reason": "history_winner_missing",
+                            "target": token,
+                            "rows": [],
+                            "entries": [],
+                            "page_token": None,
+                            "next_cursor": None,
+                            "scan_complete": False,
+                            "returned_rows": 0,
+                            "stored_bytes": 0,
+                        }
+                    raw_rows = [by_id[value] for value in winner_ids]
+                decoded = self._decode_message_rows(raw_rows)
+                entries = [
+                    {
+                        "anchor": str(row["anchor"]),
+                        "position": int(row["position"]),
+                        "canonical_count": int(row["position"]),
+                        "prefix_hash": str(row["prefix_hash"]),
+                        "stored_bytes": int(row["winner_stored_bytes"]),
+                        "physical_count": int(row["physical_count"]),
+                        "active": int(row["active"]),
+                        "compacted": int(row["compacted"]),
+                    }
+                    for row in selected
+                ]
+                if selected:
+                    last = selected[-1]
+                    page_token = {
+                        **token,
+                        "end_anchor": str(last["anchor"]),
+                        "canonical_count": int(last["position"]),
+                        "prefix_hash": str(last["prefix_hash"]),
+                    }
+                    next_cursor = make_history_cursor(
+                        token,
+                        after_position=int(last["position"]),
+                        pending_boundary_anchor=page_cursor["pending_boundary_anchor"],
+                    )
+                else:
+                    page_token = None
+                    next_cursor = page_cursor
+                complete = (
+                    not selected
+                    or int(selected[-1]["position"]) >= int(token["canonical_count"])
+                )
+                return {
+                    "schema": HISTORY_PAGE_SCHEMA,
+                    "status": "ready",
+                    "reason": "",
+                    "target": token,
+                    "rows": decoded,
+                    "entries": entries,
+                    "page_token": page_token,
+                    "next_cursor": None if complete else next_cursor,
+                    "scan_complete": complete,
+                    "returned_rows": len(decoded),
+                    "stored_bytes": total,
+                }
+            finally:
+                conn.rollback()
+
+
+__all__ = [
+    "HISTORY_PREFIX_SCHEMA",
+    "HISTORY_RULE_VERSION",
+    "SessionHistoryMixin",
+    "make_history_cursor",
+]
