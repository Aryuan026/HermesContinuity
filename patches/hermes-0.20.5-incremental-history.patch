+
+    def _slow_probe(conn, _domain, **_kwargs):
+        conn.execute(
+            "WITH RECURSIVE counter(value) AS ("
+            "VALUES(0) UNION ALL SELECT value + 1 FROM counter "
+            "WHERE value < 100000000) SELECT sum(value) FROM counter"
+        ).fetchone()
+        raise AssertionError("SQL progress handler did not interrupt the query")
