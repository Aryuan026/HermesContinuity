+                domain,
+                status="progress",
+                reason=str(domain.get("failure_reason") or ""),
+                pages=pages,
+                rows=physical_rows,
+                stored_bytes=byte_count,
+                more=True,
+            )
+
+        def _do(conn: sqlite3.Connection) -> Dict[str, Any]:
+            conn.set_progress_handler(
+                lambda: 1 if time.monotonic() >= deadline else 0,
+                1000,
+            )
+            try:
+                return _do_body(conn)
+            finally:
+                conn.set_progress_handler(None, 0)
+
+        total_pages = total_rows = total_bytes = 0
+        latest: Optional[Dict[str, Any]] = None
+        with self._history_worker_limits():
+            for _page in range(max_pages):
+                try:
+                    latest = self._execute_write(_do)
+                except sqlite3.OperationalError as exc:
+                    if "interrupted" not in str(exc).lower():
+                        raise
+                    with self._read_ctx() as conn:
+                        state_row = conn.execute(
+                            "SELECT * FROM hermes_history_state WHERE singleton=1"
+                        ).fetchone()
+                        domain_row = conn.execute(
+                            "SELECT * FROM hermes_history_domains WHERE domain_id=?",
+                            (domain_id,),
+                        ).fetchone()
+                    latest = self._history_result(
+                        dict(state_row or {}),
+                        dict(domain_row or {"domain_id": domain_id}),
+                        status="progress",
+                        reason="history_query_budget_exhausted",
+                        more=True,
+                    )
+                    latest["pages_processed"] = total_pages
+                    latest["physical_rows_processed"] = total_rows
+                    latest["stored_bytes_processed"] = total_bytes
+                    return latest
+                total_pages += int(latest["pages_processed"])
+                total_rows += int(latest["physical_rows_processed"])
+                total_bytes += int(latest["stored_bytes_processed"])
+                latest["pages_processed"] = total_pages
+                latest["physical_rows_processed"] = total_rows
+                latest["stored_bytes_processed"] = total_bytes
+                if latest["status"] != "progress" or not latest["more"]:
+                    return latest
+                if time.monotonic() >= deadline:
+                    return latest
+        assert latest is not None
+        return latest
