+                        domain["target_max_message_id"] = current_max_id
+                        domain["scan_base_change_seq"] = seal_seq
+                    else:
+                        domain["phase"] = (
+                            "physicalizing"
+                            if int(domain["canonical_count"]) > 0
+                            else "ready"
