+            if domain["phase"] in {"ready", "reverification_required", "fault"}:
+                pending = conn.execute(
+                    "SELECT * FROM hermes_history_changes WHERE change_seq>? "
+                    "AND change_seq<=? AND (old_session_id=? OR new_session_id=?) "
+                    "ORDER BY change_seq LIMIT ?",
+                    (
+                        domain["indexed_change_seq"],
+                        current_seq,
+                        domain_id,
+                        domain_id,
