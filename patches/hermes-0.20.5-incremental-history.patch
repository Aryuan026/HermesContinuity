+def _append_turn(db: SessionDB, number: int) -> None:
+    db.append_message("history", "user", f"user-{number}", timestamp=number * 2)
+    db.append_message(
+        "history", "assistant", f"assistant-{number}", timestamp=number * 2 + 1
+    )
+
+
+def _prepare(db: SessionDB, *, owner: str = "test-owner") -> dict:
+    epoch = None
+    for _ in range(20):
+        result = db.prepare_history_step(
+            "history",
+            owner_id=owner,
+            activation_epoch=epoch,
+            max_pages=2,
+            max_rows_per_page=2,
+        )
+        epoch = result["activation_epoch"] or epoch
+        if result["status"] != "progress":
+            return result
+    raise AssertionError("history preparation did not finish")
+
+
+def test_readonly_handle_prepares_and_reads_keyset_pages(history_db):
+    for number in range(3):
+        _append_turn(history_db, number)
+
+    with SessionDB(history_db.db_path, read_only=True) as reader:
+        prepared = _prepare(reader)
+        assert prepared["status"] == "ready"
+        token = prepared["head_token"]
+        assert token["schema"] == HISTORY_PREFIX_SCHEMA
+        assert set(token) == {
+            "schema",
+            "realm_id",
+            "incarnation",
+            "activation_epoch",
+            "domain_id",
+            "topology_revision",
+            "canonical_rule_version",
+            "indexed_change_seq",
+            "end_anchor",
+            "canonical_count",
+            "prefix_hash",
+        }
+
+        first = reader.read_history_page(
+            "history", target=token, max_rows=2, max_bytes=1024 * 1024
+        )
+        assert first["status"] == "ready"
+        assert [row["content"] for row in first["rows"]] == ["user-0", "assistant-0"]
+        assert first["scan_complete"] is False
+        assert first["next_cursor"]["schema"] == HISTORY_CURSOR_SCHEMA
+
+        second = reader.read_history_page(
+            "history",
+            target=token,
+            cursor=first["next_cursor"],
+            max_rows=2,
+            max_bytes=1024 * 1024,
+        )
+        assert [row["content"] for row in second["rows"]] == [
+            "user-1",
+            "assistant-1",
+        ]
+
+        random_access = reader.read_history_page(
+            "history",
+            target=token,
+            cursor=make_history_cursor(token, after_position=4),
+            max_rows=2,
+        )
+        assert [row["content"] for row in random_access["rows"]] == [
+            "user-2",
+            "assistant-2",
+        ]
