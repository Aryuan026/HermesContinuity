+        lambda conn: conn.executemany(
+            "INSERT INTO messages(session_id, role, content, timestamp, active, compacted) "
+            "VALUES ('history', 'user', ?, ?, 1, 0)",
+            [(f"message-{number}", number) for number in range(512)],
+        )
+    )
+    old = history_db.prepare_history_step(
+        "history",
+        owner_id="physical-proof",
+        max_pages=8,
+        max_rows_per_page=256,
+        deadline_ms=1_000,
+    )
+    assert old["status"] == "ready"
+    history_db.archive_and_compact(
+        "history", history_db.get_messages("history", include_compacted=True)
+    )
+    refreshed = {"status": "progress"}
+    for _ in range(8):
+        refreshed = history_db.prepare_history_step(
+            "history",
+            owner_id="physical-proof",
+            activation_epoch=old["activation_epoch"],
+            max_pages=8,
+            max_rows_per_page=256,
+            deadline_ms=1_000,
+        )
+        if refreshed["status"] == "ready":
+            break
+    assert refreshed["status"] == "ready"
+
+    plan = history_db._conn.execute(
+        "EXPLAIN QUERY PLAN SELECT physical_prefix_max_seq "
+        "FROM hermes_history_buckets WHERE domain_id=? AND position=?",
+        ("history", 256),
+    ).fetchall()
+    assert "index" in " ".join(str(row[3]).lower() for row in plan)
+
+    def _validation_steps(token):
+        steps = 0
+
+        def _step():
+            nonlocal steps
+            steps += 1
+            return 0
+
+        history_db._conn.set_progress_handler(_step, 1)
+        try:
+            return history_db._history_validate_token_conn(history_db._conn, token), steps
+        finally:
+            history_db._conn.set_progress_handler(None, 0)
+
+    current_result, current_steps = _validation_steps(refreshed["head_token"])
+    old_result, old_steps = _validation_steps(old["head_token"])
+    assert current_result["status"] == "valid"
+    assert old_result["status"] == "valid"
+    assert old_result["invalidated_from_position"] == 1
+    assert old_steps <= current_steps + 600
