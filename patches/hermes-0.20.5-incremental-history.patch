+                        domain["scan_base_change_seq"] = seal_seq
+                        self._history_save_domain(conn, domain)
+                        return self._history_result(
+                            state, domain, status="progress", more=True
+                        )
+                    message_changes = any(
+                        change["object_kind"] == "message" for change in changes
+                    )
