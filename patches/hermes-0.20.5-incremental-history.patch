+++ b/hermes_state_history.py
@@ -0,0 +1,2637 @@
+"""Bounded canonical-history preparation for :class:`hermes_state.SessionDB`.
+
+The canonical transcript remains in ``messages``.  The tables in this module
+contain only locators, digests, counters, and progress.  Public methods expose
+bounded pages through a closed proof token; callers never receive a writable
+SQLite handle.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+import re
+import sqlite3
+import threading
+import time
+import uuid
+from contextlib import contextmanager
+from typing import Any, Callable, Dict, Mapping, Optional, Sequence
+
+
+HISTORY_RULE_VERSION = "hermes.canonical_history_rule.v1"
+HISTORY_PREFIX_SCHEMA = "hermes.canonical_history_prefix.v1"
+HISTORY_CURSOR_SCHEMA = "hermes.canonical_history_cursor.v1"
+HISTORY_PREPARE_SCHEMA = "hermes.canonical_history_prepare.v1"
+HISTORY_PAGE_SCHEMA = "hermes.canonical_history_page.v1"
+HISTORY_SEAL_SCHEMA = "hermes.canonical_history_seal.v1"
+HISTORY_VALIDATION_SCHEMA = "hermes.canonical_history_validation.v1"
+HISTORY_INVALIDATION_SCHEMA = "hermes.canonical_history_invalidation.v1"
+
+_PREFIX_KEYS = frozenset(
+    {
+        "schema",
+        "realm_id",
+        "incarnation",
+        "activation_epoch",
+        "domain_id",
+        "topology_revision",
+        "canonical_rule_version",
+        "indexed_change_seq",
+        "end_anchor",
+        "canonical_count",
+        "prefix_hash",
+    }
+)
+_CURSOR_KEYS = frozenset(
+    {
+        "schema",
+        "realm_id",
+        "incarnation",
+        "activation_epoch",
+        "domain_id",
+        "topology_revision",
+        "canonical_rule_version",
+        "indexed_change_seq",
+        "target_end_anchor",
+        "target_count",
+        "after_position",
+        "pending_boundary_anchor",
+    }
+)
+_CODE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:@/+~=-]{0,511}$")
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_ANCHOR_RE = re.compile(r"^hca_[0-9a-f]{64}$")
+_PROCESS_NONCE = "hhp_" + uuid.uuid4().hex
+_LEASE_SECONDS = 30.0
+_WORKER_CACHE_KIB = 8 * 1024
+_MAX_LISTENER_DOMAINS = 32
+_LISTENER_LOCK = threading.RLock()
+_LISTENERS: Dict[str, Dict[str, Dict[str, Callable[[str, int], None]]]] = {}
+logger = logging.getLogger(__name__)
+
+
+class HistoryListenerRegistration:
+    """Identity-bound handle for one process-local history listener."""
+
+    def __init__(self, path: str, domain_id: str, token: str) -> None:
+        self._path = path
+        self._domain_id = domain_id
+        self._token = token
+        self._closed = False
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        with _LISTENER_LOCK:
+            by_domain = _LISTENERS.get(self._path)
+            callbacks = by_domain.get(self._domain_id) if by_domain else None
+            if callbacks is not None:
+                callbacks.pop(self._token, None)
+                if not callbacks:
+                    by_domain.pop(self._domain_id, None)
+            if by_domain is not None and not by_domain:
+                _LISTENERS.pop(self._path, None)
+
+_TRIGGER_NAMES = (
+    "hermes_history_messages_insert",
+    "hermes_history_messages_update",
+    "hermes_history_messages_delete",
+    "hermes_history_sessions_insert",
+    "hermes_history_sessions_update",
+    "hermes_history_sessions_delete",
+    "hermes_history_changes_insert_guard",
+    "hermes_history_changes_update_guard",
+    "hermes_history_changes_delete_guard",
+)
+_TABLE_COLUMNS = {
+    "hermes_history_state": {
+        "singleton",
+        "realm_id",
+        "realm_binding",
+        "incarnation",
+        "activation_epoch",
+        "activation_process",
+        "owner_id",
+        "lease_expires_at",
+        "capture_enabled",
+        "message_columns_digest",
+        "retained_floor",
+        "journal_tail",
+        "retained_count",
+    },
+    "hermes_history_changes": {
+        "change_seq",
+        "object_kind",
+        "operation",
+        "old_session_id",
+        "old_row_id",
+        "new_session_id",
+        "new_row_id",
+    },
+    "hermes_history_domains": {
+        "domain_id",
+        "topology_revision",
+        "canonical_rule_version",
+        "activation_epoch",
+        "phase",
+        "target_max_message_id",
+        "scan_base_change_seq",
+        "indexed_change_seq",
+        "cursor_message_id",
+        "physical_cursor_position",
+        "canonical_count",
+        "end_anchor",
+        "prefix_hash",
+        "invalidated_from_position",
+        "failure_reason",
+        "updated_at",
+    },
+    "hermes_history_buckets": {
+        "domain_id",
+        "anchor",
+        "position",
+        "raw_key_digest",
+        "semantic_key_digest",
+        "raw_signature",
+        "semantic_signature",
+        "earliest_message_id",
+        "winner_message_id",
+        "winner_stored_bytes",
+        "physical_count",
+        "active_count",
+        "active",
+        "compacted",
+        "last_physical_change_seq",
+        "physical_prefix_max_seq",
+        "canonical_digest",
+        "prefix_hash",
+    },
+    "hermes_history_members": {
+        "domain_id",
+        "message_id",
+        "anchor",
+        "raw_key_digest",
+        "semantic_key_digest",
+        "raw_signature",
+        "semantic_signature",
+        "stored_bytes",
+        "active",
+        "compacted",
+    },
+}
+
+_HISTORY_SCHEMA_SQL = """
+CREATE TABLE IF NOT EXISTS hermes_history_state (
+    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
+    realm_id TEXT NOT NULL,
+    realm_binding TEXT NOT NULL,
+    incarnation TEXT NOT NULL,
+    activation_epoch TEXT NOT NULL,
+    activation_process TEXT NOT NULL,
+    owner_id TEXT NOT NULL,
+    lease_expires_at REAL NOT NULL,
+    capture_enabled INTEGER NOT NULL CHECK (capture_enabled IN (0, 1)),
+    message_columns_digest TEXT NOT NULL,
+    retained_floor INTEGER NOT NULL DEFAULT 0,
+    journal_tail INTEGER NOT NULL DEFAULT 0,
+    retained_count INTEGER NOT NULL DEFAULT 0
+);
+
+CREATE TABLE IF NOT EXISTS hermes_history_changes (
+    change_seq INTEGER PRIMARY KEY AUTOINCREMENT,
+    object_kind TEXT NOT NULL,
+    operation TEXT NOT NULL,
+    old_session_id TEXT,
+    old_row_id INTEGER,
+    new_session_id TEXT,
+    new_row_id INTEGER
+);
+CREATE INDEX IF NOT EXISTS idx_hermes_history_changes_old
+    ON hermes_history_changes(old_session_id, change_seq);
+CREATE INDEX IF NOT EXISTS idx_hermes_history_changes_new
+    ON hermes_history_changes(new_session_id, change_seq);
+
+CREATE TABLE IF NOT EXISTS hermes_history_domains (
+    domain_id TEXT PRIMARY KEY,
+    topology_revision TEXT NOT NULL,
+    canonical_rule_version TEXT NOT NULL,
+    activation_epoch TEXT NOT NULL,
+    phase TEXT NOT NULL,
+    target_max_message_id INTEGER NOT NULL,
+    scan_base_change_seq INTEGER NOT NULL,
+    indexed_change_seq INTEGER NOT NULL,
+    cursor_message_id INTEGER NOT NULL,
+    physical_cursor_position INTEGER NOT NULL,
+    canonical_count INTEGER NOT NULL,
+    end_anchor TEXT NOT NULL,
+    prefix_hash TEXT NOT NULL,
+    invalidated_from_position INTEGER,
+    failure_reason TEXT NOT NULL DEFAULT '',
+    updated_at REAL NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_hermes_history_domains_watermark
+    ON hermes_history_domains(indexed_change_seq);
+
+CREATE TABLE IF NOT EXISTS hermes_history_buckets (
+    domain_id TEXT NOT NULL,
+    anchor TEXT NOT NULL,
+    position INTEGER NOT NULL,
+    raw_key_digest TEXT NOT NULL,
+    semantic_key_digest TEXT NOT NULL,
+    raw_signature TEXT NOT NULL,
+    semantic_signature TEXT NOT NULL,
+    earliest_message_id INTEGER NOT NULL,
+    winner_message_id INTEGER NOT NULL,
+    winner_stored_bytes INTEGER NOT NULL,
+    physical_count INTEGER NOT NULL,
+    active_count INTEGER NOT NULL,
+    active INTEGER NOT NULL,
+    compacted INTEGER NOT NULL,
+    last_physical_change_seq INTEGER NOT NULL,
+    physical_prefix_max_seq INTEGER NOT NULL,
+    canonical_digest TEXT NOT NULL,
+    prefix_hash TEXT NOT NULL,
+    PRIMARY KEY (domain_id, anchor),
+    UNIQUE (domain_id, position),
+    UNIQUE (domain_id, semantic_key_digest)
+);
+CREATE INDEX IF NOT EXISTS idx_hermes_history_buckets_winner
+    ON hermes_history_buckets(domain_id, winner_message_id);
+
+CREATE TABLE IF NOT EXISTS hermes_history_members (
+    domain_id TEXT NOT NULL,
+    message_id INTEGER NOT NULL,
+    anchor TEXT NOT NULL,
+    raw_key_digest TEXT NOT NULL,
+    semantic_key_digest TEXT NOT NULL,
+    raw_signature TEXT NOT NULL,
+    semantic_signature TEXT NOT NULL,
+    stored_bytes INTEGER NOT NULL,
+    active INTEGER NOT NULL,
+    compacted INTEGER NOT NULL,
+    PRIMARY KEY (domain_id, message_id)
+);
+CREATE INDEX IF NOT EXISTS idx_hermes_history_members_anchor
+    ON hermes_history_members(domain_id, anchor, message_id);
+"""
+
+_HISTORY_TRIGGER_SQL = """
+CREATE TRIGGER IF NOT EXISTS hermes_history_messages_insert
+AFTER INSERT ON messages BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, new_session_id, new_row_id)
+  VALUES ('message', 'insert', new.session_id, new.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_messages_update
+AFTER UPDATE ON messages BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, old_session_id, old_row_id,
+     new_session_id, new_row_id)
+  VALUES ('message', 'update', old.session_id, old.id,
+          new.session_id, new.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_messages_delete
+AFTER DELETE ON messages BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, old_session_id, old_row_id)
+  VALUES ('message', 'delete', old.session_id, old.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_sessions_insert
+AFTER INSERT ON sessions BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, new_session_id)
+  VALUES ('session', 'insert', new.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_sessions_update
+AFTER UPDATE OF source, user_id, session_key, chat_id, chat_type, thread_id,
+  origin_json, model_config, parent_session_id, started_at, ended_at, end_reason
+ON sessions BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, old_session_id, new_session_id)
+  VALUES ('session', 'update', old.id, new.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_sessions_delete
+AFTER DELETE ON sessions BEGIN
+  INSERT INTO hermes_history_changes
+    (object_kind, operation, old_session_id)
+  VALUES ('session', 'delete', old.id);
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_changes_insert_guard
+AFTER INSERT ON hermes_history_changes BEGIN
+  UPDATE hermes_history_state SET journal_tail = new.change_seq,
+    retained_count = retained_count + 1
+  WHERE singleton = 1;
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_changes_update_guard
+AFTER UPDATE ON hermes_history_changes BEGIN
+  UPDATE hermes_history_state SET capture_enabled=0, activation_epoch='',
+    activation_process='', owner_id='', lease_expires_at=0
+  WHERE singleton = 1;
+  UPDATE hermes_history_domains SET phase='reverification_required',
+    invalidated_from_position=1, failure_reason='history_journal_modified';
+END;
+CREATE TRIGGER IF NOT EXISTS hermes_history_changes_delete_guard
+AFTER DELETE ON hermes_history_changes BEGIN
+  UPDATE hermes_history_state SET retained_count = retained_count - 1
+  WHERE singleton = 1 AND old.change_seq > retained_floor;
+  UPDATE hermes_history_state SET capture_enabled=0, activation_epoch='',
+    activation_process='', owner_id='', lease_expires_at=0
+  WHERE singleton = 1 AND old.change_seq > retained_floor;
+  UPDATE hermes_history_domains SET phase='reverification_required',
+    invalidated_from_position=1, failure_reason='history_journal_gap'
+  WHERE old.change_seq > (
+    SELECT retained_floor FROM hermes_history_state WHERE singleton = 1
+  );
+END;
+"""
+
+
+def _expected_table_shapes() -> Dict[str, tuple[tuple[Any, ...], ...]]:
+    conn = sqlite3.connect(":memory:")
+    try:
+        conn.executescript(_HISTORY_SCHEMA_SQL)
+        return {
+            table: tuple(
+                (
+                    str(row[1]),
+                    str(row[2]).upper(),
+                    int(row[3]),
+                    row[4],
+                    int(row[5]),
+                )
+                for row in conn.execute(f"PRAGMA table_info({table})").fetchall()
+            )
+            for table in _TABLE_COLUMNS
+        }
+    finally:
+        conn.close()
+
+
+_EXPECTED_TABLE_SHAPES = _expected_table_shapes()
+
+_HISTORY_INDEX_COLUMNS = {
+    "idx_hermes_history_changes_old": ("old_session_id", "change_seq"),
+    "idx_hermes_history_changes_new": ("new_session_id", "change_seq"),
+    "idx_hermes_history_domains_watermark": ("indexed_change_seq",),
+    "idx_hermes_history_buckets_winner": ("domain_id", "winner_message_id"),
+    "idx_hermes_history_members_anchor": ("domain_id", "anchor", "message_id"),
+}
+
+
+def _normalize_sql(sql: str) -> str:
+    normalized = " ".join(str(sql or "").strip().rstrip(";").split()).lower()
+    return normalized.replace("create trigger if not exists", "create trigger", 1)
+
+
+def _trigger_declarations() -> tuple[Dict[str, str], Dict[str, str]]:
+    declarations: Dict[str, str] = {}
+    expected: Dict[str, str] = {}
+    pattern = re.compile(
+        r"CREATE TRIGGER IF NOT EXISTS\s+(\w+)\s+(.*?\bEND;)",
+        re.IGNORECASE | re.DOTALL,
+    )
+    for match in pattern.finditer(_HISTORY_TRIGGER_SQL):
+        name = match.group(1)
+        declaration = f"CREATE TRIGGER IF NOT EXISTS {name} {match.group(2)}"
+        declarations[name] = declaration
+        expected[name] = _normalize_sql(declaration)
+    if set(expected) != set(_TRIGGER_NAMES):  # import-time authoring guard
+        raise RuntimeError("history trigger declaration set is inconsistent")
+    return declarations, expected
+
+
+_TRIGGER_DECLARATIONS, _EXPECTED_TRIGGER_SQL = _trigger_declarations()
+
+
+def _new_marker(prefix: str) -> str:
+    return prefix + uuid.uuid4().hex
+
+
+def _is_nonnegative_int(value: Any) -> bool:
+    return type(value) is int and value >= 0
+
+
+def _require_code(value: Any, name: str) -> str:
+    if not isinstance(value, str) or not _CODE_RE.fullmatch(value):
+        raise ValueError(f"{name} is invalid")
+    return value
+
+
+def _require_digest(value: Any, name: str) -> str:
+    if not isinstance(value, str) or not _SHA256_RE.fullmatch(value):
+        raise ValueError(f"{name} must be a sha256 digest")
+    return value
+
+
+def _require_anchor(value: Any, name: str, *, empty: bool = False) -> str:
+    if empty and value == "":
+        return ""
+    if not isinstance(value, str) or not _ANCHOR_RE.fullmatch(value):
+        raise ValueError(f"{name} is invalid")
+    return value
+
+
+def _json_value(value: Any) -> Any:
+    if isinstance(value, bytes):
+        return {"$bytes": value.hex()}
+    if isinstance(value, tuple):
+        return [_json_value(item) for item in value]
+    if isinstance(value, list):
+        return [_json_value(item) for item in value]
+    if isinstance(value, Mapping):
+        return {str(key): _json_value(item) for key, item in value.items()}
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    return {"$type": type(value).__name__, "$repr": repr(value)}
+
+
+def _json_bytes(value: Any) -> bytes:
+    return json.dumps(
+        _json_value(value), ensure_ascii=True, sort_keys=True, separators=(",", ":")
+    ).encode("ascii")
+
+
+def _digest(value: Any) -> str:
+    return hashlib.sha256(_json_bytes(value)).hexdigest()
+
+
+def _chain_digest(*parts: Any) -> str:
+    digest = hashlib.sha256()
+    for part in parts:
+        payload = _json_bytes(part)
+        digest.update(len(payload).to_bytes(8, "big"))
+        digest.update(payload)
+    return digest.hexdigest()
+
+
+def _prefix_zero(domain_id: str) -> str:
+    return _chain_digest(
+        "hermes.canonical_history_prefix_chain.v1",
+        domain_id,
+        HISTORY_RULE_VERSION,
+    )
+
+
+def _normalize_prefix_token(value: Mapping[str, Any]) -> Dict[str, Any]:
+    if not isinstance(value, Mapping) or set(value) != _PREFIX_KEYS:
+        raise ValueError("history prefix token fields are invalid")
+    token = dict(value)
+    if token.get("schema") != HISTORY_PREFIX_SCHEMA:
+        raise ValueError("history prefix token schema is unsupported")
+    for key in (
+        "realm_id",
+        "incarnation",
+        "activation_epoch",
+        "domain_id",
+        "topology_revision",
+        "canonical_rule_version",
+    ):
+        _require_code(token.get(key), key)
+    if token["canonical_rule_version"] != HISTORY_RULE_VERSION:
+        raise ValueError("history rule version is unsupported")
+    if not _is_nonnegative_int(token.get("indexed_change_seq")):
+        raise ValueError("indexed_change_seq is invalid")
+    if not _is_nonnegative_int(token.get("canonical_count")):
+        raise ValueError("canonical_count is invalid")
+    count = token["canonical_count"]
+    _require_anchor(token.get("end_anchor"), "end_anchor", empty=count == 0)
+    if count == 0 and token["end_anchor"] != "":
+        raise ValueError("empty prefix must have an empty anchor")
+    if count > 0 and token["end_anchor"] == "":
+        raise ValueError("non-empty prefix must have an anchor")
+    _require_digest(token.get("prefix_hash"), "prefix_hash")
+    if count == 0 and token["prefix_hash"] != _prefix_zero(token["domain_id"]):
+        raise ValueError("empty prefix hash is invalid")
+    return token
+
+
+def make_history_cursor(
+    target: Mapping[str, Any],
+    *,
+    after_position: int = 0,
+    pending_boundary_anchor: str = "",
+) -> Dict[str, Any]:
+    """Construct a closed keyset cursor bound to one prefix token."""
+
+    token = _normalize_prefix_token(target)
+    if not _is_nonnegative_int(after_position) or after_position > token["canonical_count"]:
+        raise ValueError("after_position is outside the target prefix")
+    _require_anchor(
+        pending_boundary_anchor,
+        "pending_boundary_anchor",
+        empty=True,
+    )
+    return {
+        "schema": HISTORY_CURSOR_SCHEMA,
+        "realm_id": token["realm_id"],
+        "incarnation": token["incarnation"],
+        "activation_epoch": token["activation_epoch"],
+        "domain_id": token["domain_id"],
+        "topology_revision": token["topology_revision"],
+        "canonical_rule_version": token["canonical_rule_version"],
+        "indexed_change_seq": token["indexed_change_seq"],
+        "target_end_anchor": token["end_anchor"],
+        "target_count": token["canonical_count"],
+        "after_position": after_position,
+        "pending_boundary_anchor": pending_boundary_anchor,
+    }
+
+
+def _normalize_cursor(value: Mapping[str, Any], target: Mapping[str, Any]) -> Dict[str, Any]:
+    if not isinstance(value, Mapping) or set(value) != _CURSOR_KEYS:
+        raise ValueError("history cursor fields are invalid")
+    cursor = dict(value)
+    if cursor.get("schema") != HISTORY_CURSOR_SCHEMA:
+        raise ValueError("history cursor schema is unsupported")
+    expected = make_history_cursor(
+        target,
+        after_position=cursor.get("after_position"),
+        pending_boundary_anchor=cursor.get("pending_boundary_anchor"),
+    )
+    if cursor != expected:
+        raise ValueError("history cursor does not belong to target")
+    return cursor
