--- /dev/null
+++ b/tests/test_plugin_doctor_joint.py
@@ -0,0 +1,192 @@
+from __future__ import annotations
+
+import argparse
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from hermes_cli.plugin_dev import _doctor_runtime, doctor_plugin
+from hermes_cli.subcommands.plugins import build_plugins_parser
+
+
+def _write_plugin(
+    root: Path,
+    *,
+    name: str,
+    source: str,
+    requires: str | None = None,
+    hooks: tuple[str, ...] = (),
+) -> Path:
+    plugin = root / name
+    plugin.mkdir(parents=True)
+    manifest = [
+        "manifest_version: 2",
+        f"name: {name}",
+        "version: 1.0.0",
+        "description: joint Doctor fixture",
+        "provides_tools: []",
+        f"provides_hooks: [{', '.join(hooks)}]",
+    ]
+    if requires is not None:
+        manifest.extend(
+            [
+                "requires_plugins:",
+                f"  - id: {requires}",
+                "    version_range: '>=1,<2'",
+            ]
+        )
+    (plugin / "plugin.yaml").write_text(
+        "\n".join(manifest) + "\n", encoding="utf-8"
+    )
+    (plugin / "__init__.py").write_text(source, encoding="utf-8")
+    return plugin
+
+
+def _joint_plugins(root: Path) -> tuple[Path, Path]:
+    provider = _write_plugin(
+        root,
+        name="doctor-provider",
+        source=(
+            "import os\n"
+            "from pathlib import Path\n"
+            "from hermes_constants import get_hermes_home\n"
+            "from hermes_state import SessionDB\n\n"
+            "def _unloaded():\n"
+            "    marker = os.environ.get('DOCTOR_UNLOAD_MARKER')\n"
+            "    if marker:\n"
+            "        with Path(marker).open('a', encoding='utf-8') as stream:\n"
+            "            stream.write('provider\\n')\n\n"
+            "def register(ctx):\n"
+            "    db = SessionDB(get_hermes_home() / 'state.db', read_only=True)\n"
+            "    ctx.on_unload(db.close)\n"
+            "    ctx.on_unload(_unloaded)\n"
+            "    ctx.register_service('ready.v1', {'ready': True})\n"
+        ),
+    )
+    consumer = _write_plugin(
+        root,
+        name="doctor-consumer",
+        requires="doctor-provider",
+        hooks=("pre_llm_call",),
+        source=(
+            "import os\n"
+            "from pathlib import Path\n\n"
+            "def _hook(**_kwargs):\n"
+            "    return None\n\n"
+            "def _unloaded():\n"
+            "    marker = os.environ.get('DOCTOR_UNLOAD_MARKER')\n"
+            "    if marker:\n"
+            "        with Path(marker).open('a', encoding='utf-8') as stream:\n"
+            "            stream.write('consumer\\n')\n\n"
+            "def register(ctx):\n"
+            "    service = ctx.get_service('doctor-provider:ready.v1')\n"
+            "    if service is None:\n"
+            "        raise RuntimeError('provider service missing')\n"
+            "    ctx.on_unload(_unloaded)\n"
+            "    ctx.register_hook('pre_llm_call', _hook)\n"
+        ),
+    )
+    return provider, consumer
+
+
+class JointPluginDoctorTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self._temporary.name)
+
+    def tearDown(self) -> None:
+        self._temporary.cleanup()
+
+    def test_joint_doctor_initializes_state_and_loads_dependencies_first(self) -> None:
+        provider, consumer = _joint_plugins(self.root)
+
+        report = doctor_plugin(consumer, with_plugins=[provider])
+
+        self.assertTrue(report.ok, report.format_text())
+        self.assertEqual(report.registered_hooks, ("pre_llm_call",))
+        self.assertEqual(report.companion_paths, (provider.resolve(),))
+        self.assertIn("joint companions:", report.format_text())
+
+    def test_single_plugin_doctor_keeps_missing_dependency_visible(self) -> None:
+        _provider, consumer = _joint_plugins(self.root)
+
+        report = doctor_plugin(consumer)
+
+        self.assertFalse(report.ok)
+        self.assertTrue(
+            any(
+                "provider service missing" in finding.message
+                for finding in report.findings
+            )
+        )
+
+    def test_joint_runtime_unloads_every_owner_in_reverse_load_order(self) -> None:
+        provider, consumer = _joint_plugins(self.root)
+        marker = self.root / "unloaded.txt"
+
+        with patch.dict(
+            os.environ, {"DOCTOR_UNLOAD_MARKER": str(marker)}, clear=False
+        ):
+            with _doctor_runtime(consumer, (provider,)) as host:
+                manager = host.manager
+                self.assertIsNotNone(
+                    manager._get_plugin_service("doctor-provider:ready.v1")
+                )
+
+        self.assertEqual(marker.read_text(encoding="utf-8").splitlines(), [
+            "consumer",
+            "provider",
+        ])
+        self.assertEqual(manager._services, {})
+        self.assertEqual(manager._hooks, {})
+        self.assertEqual(manager._plugins, {})
+
+    def test_missing_companion_is_reported_without_partial_runtime(self) -> None:
+        _provider, consumer = _joint_plugins(self.root)
+
+        report = doctor_plugin(
+            consumer,
+            with_plugins=[self.root / "does-not-exist"],
+        )
+
+        self.assertFalse(report.ok)
+        self.assertTrue(
+            any("not found" in finding.message for finding in report.findings)
+        )
+
+    def test_duplicate_companion_path_is_loaded_once(self) -> None:
+        provider, consumer = _joint_plugins(self.root)
+
+        report = doctor_plugin(
+            consumer,
+            with_plugins=[provider, provider, consumer],
+        )
+
+        self.assertTrue(report.ok, report.format_text())
+        self.assertEqual(report.companion_paths, (provider.resolve(),))
+
+    def test_doctor_parser_accepts_repeated_joint_companions(self) -> None:
+        parser = argparse.ArgumentParser()
+        subparsers = parser.add_subparsers(dest="command")
+        build_plugins_parser(subparsers, cmd_plugins=lambda _args: None)
+
+        args = parser.parse_args(
+            [
+                "plugins",
+                "doctor",
+                "consumer",
+                "--with",
+                "provider-a",
+                "--with",
+                "provider-b",
+            ]
+        )
+
+        self.assertEqual(args.target, "consumer")
+        self.assertEqual(args.with_plugins, ["provider-a", "provider-b"])
+
+
+if __name__ == "__main__":
+    unittest.main()
