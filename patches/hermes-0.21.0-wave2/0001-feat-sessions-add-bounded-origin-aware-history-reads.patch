+    def _message_dedupe_key(self, row: Any) -> Tuple[Any, ...]:
+        """Canonical identity used by every compacted display read."""
+        dedupe_content = row["content"]
+        if row["role"] == "user":
+            from agent.context_compressor import split_user_originated_turn
+
+            candidate = {
+                "role": "user",
+                "content": self._decode_content(row["content"]),
+                "display_kind": row["display_kind"],
+                "display_metadata": self._decode_display_metadata(
+                    row["display_metadata"]
+                ),
+            }
+            handoff, live_view = split_user_originated_turn(candidate)
+            if handoff is not None and live_view is not None:
+                dedupe_content = self._encode_content(live_view.get("content"))
+        # Sidecars, including origin_proof, deliberately do not enter this key.
+        # A clone with conflicting sidecars is one logical identity whose raw
+        # generations must be audited, not two independently trusted messages.
+        return (
+            row["role"],
+            dedupe_content,
+            row["timestamp"],
+            row["tool_call_id"],
+            row["tool_calls"],
+            row["tool_name"],
+        )
+
+    def _dedupe_compacted_message_rows(self, rows: List[Any]) -> List[Any]:
+        """Collapse physical compaction generations to canonical messages."""
+        seen: Dict[Tuple[Any, ...], Any] = {}
+        for row in rows:
+            key = self._message_dedupe_key(row)
+            current = seen.get(key)
+            if current is None or (row["active"], row["id"]) > (
+                current["active"],
+                current["id"],
+            ):
+                seen[key] = row
+        return sorted(seen.values(), key=lambda row: row["id"])
+
+    def _decode_message_rows(self, rows: List[Any]) -> List[Dict[str, Any]]:
+        """Decode stored message rows using the public read representation."""
+        result: List[Dict[str, Any]] = []
+        for row in rows:
+            msg = dict(row)
+            if msg.pop("_compressed_summary", 0):
+                msg["_compressed_summary"] = True
+            if "content" in msg:
+                msg["content"] = self._decode_content(msg["content"])
+            if msg.get("tool_calls"):
+                try:
+                    msg["tool_calls"] = json.loads(msg["tool_calls"])
+                except (json.JSONDecodeError, TypeError):
+                    logger.warning(
+                        "Failed to deserialize tool_calls in get_messages, "
+                        "falling back to []"
+                    )
+                    msg["tool_calls"] = []
+            if msg.get("display_metadata") is not None:
+                msg["display_metadata"] = self._decode_display_metadata(
+                    msg["display_metadata"]
+                )
+            origin_proof = msg.pop("origin_proof", None)
+            if origin_proof is not None:
+                msg["origin_proof"] = self._decode_origin_proof(origin_proof)
+            result.append(msg)
+        return result
+
+    @staticmethod
+    def _project_compaction_live_views(
+        messages: List[Dict[str, Any]],
+    ) -> List[Dict[str, Any]]:
+        """Expose real content embedded in synthetic compaction carriers.
+
+        Lean compaction can persist one physical row containing both a model-
+        only handoff and a carried-forward live message.  Bounded history
+        consumers need the logical live message, while collision auditors
+        still need to distinguish physical carriers whose hidden handoffs
+        differ.  Reuse the compressor's grammar owner, and retain only a
+        body-free digest of the physical wrapper in Continuity's projection
+        namespace.  An assistant carrier published into a rotation child
+        remains synthetic because the closed parent still owns that turn;
+        user-leading carriers remain live so the child can receive its answer.
+
+        Pure handoffs and malformed/unhashable carriers remain unchanged so
+        downstream consumers continue to identify or reject them fail closed.
+        """
+        from agent.context_compressor import (
+            COMPRESSED_SUMMARY_METADATA_KEY,
+            ContextCompressor,
+            is_compaction_summary_message,
+        )
+
+        projected_messages: List[Dict[str, Any]] = []
+        for message in messages:
+            if not is_compaction_summary_message(message):
+                projected_messages.append(message)
+                continue
+            metadata = message.get("display_metadata")
+            if (
+                message.get("role") == "assistant"
+                and isinstance(metadata, dict)
+                and metadata.get("_continuity_rotation_shadow") is True
+            ):
+                projected_messages.append(message)
+                continue
+            live_view = ContextCompressor._strip_context_summary_handoff_message(
+                message
+            )
+            if live_view is None:
+                projected_messages.append(message)
+                continue
+            carrier = {
+                "content": message.get("content"),
+                "compressed_summary": bool(
+                    message.get(COMPRESSED_SUMMARY_METADATA_KEY)
+                ),
+                "display_kind": message.get("display_kind"),
+                "display_metadata": message.get("display_metadata"),
+            }
+            try:
+                encoded = json.dumps(
+                    carrier,
+                    allow_nan=False,
+                    ensure_ascii=True,
+                    sort_keys=True,
+                    separators=(",", ":"),
+                ).encode("utf-8")
+            except (TypeError, ValueError):
+                projected_messages.append(message)
+                continue
+
+            live_view = live_view.copy()
+            if live_view.get("display_kind") in {
+                "compaction_summary",
+                "context_compaction_summary",
+            }:
+                live_view.pop("display_kind", None)
+            metadata = live_view.get("display_metadata")
+            if isinstance(metadata, dict) and metadata.get(
+                COMPRESSED_SUMMARY_METADATA_KEY
+            ):
+                metadata = metadata.copy()
+                metadata.pop(COMPRESSED_SUMMARY_METADATA_KEY, None)
+                if metadata:
+                    live_view["display_metadata"] = metadata
+                else:
+                    live_view.pop("display_metadata", None)
+            live_view["_continuity_compaction_live_view"] = {
+                "schema": "hermes.compaction_live_view.v1",
+                "carrier_sha256": hashlib.sha256(encoded).hexdigest(),
+            }
+            projected_messages.append(live_view)
+        return projected_messages
+
