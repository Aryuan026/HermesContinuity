+        for message in compressed
+    ]
+    carrier = composite[0]
+    live = ContextCompressor._strip_context_summary_handoff_message(carrier)
+    assert live is not None
+    if force_user_leading:
+        assert _SUMMARY_END_MARKER in carrier["content"]
+        assert _MERGED_SUMMARY_DELIMITER not in carrier["content"]
+    else:
+        assert _MERGED_SUMMARY_DELIMITER in carrier["content"]
+
+    tail_count = sum(
+        1
+        for message in compressed
+        if isinstance(message, dict) and message.pop("_compaction_tail", None)
+    )
+    if rotate:
