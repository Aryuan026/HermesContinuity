+"""Bounded 0.21 SessionDB reads and durable origin-proof lifecycle."""
+
+from __future__ import annotations
+
+import hashlib
+import sqlite3
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from hermes_state import SessionDB
+
+from agent.context_compressor import (
+    COMPRESSED_SUMMARY_METADATA_KEY,
+    ContextCompressor,
+    _MERGED_SUMMARY_DELIMITER,
+    _SUMMARY_END_MARKER,
+)
+
+
+ORIGIN_A = {
+    "schema": "hermes.message_origin.v1",
+    "issuer": "test-writer-a",
+    "opaque": "proof-a",
+}
+ORIGIN_B = {
+    "schema": "hermes.message_origin.v1",
+    "issuer": "test-writer-b",
+    "opaque": "proof-b",
+}
+
+
+@pytest.fixture()
+def db(tmp_path: Path):
+    store = SessionDB(tmp_path / "state.db")
+    store.create_session("window", source="test")
+    try:
+        yield store
+    finally:
+        store.close()
+
+
+def _read(db: SessionDB, session_id: str = "window", **overrides):
+    options = {
+        "start_timestamp": 0.0,
+        "end_timestamp": 1_000.0,
+        "max_physical_rows": 100,
+    }
+    options.update(overrides)
+    return db.get_messages_time_window(session_id, **options)
+
+
+def _real_compression(messages, *, force_user_leading: bool = False):
+    with patch(
