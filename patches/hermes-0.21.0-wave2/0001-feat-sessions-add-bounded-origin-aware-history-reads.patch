+    @staticmethod
+    def _encode_origin_proof(origin_proof: Any) -> Optional[str]:
+        """Serialize one host-owned per-message origin proof.
+
+        Wave 2 only owns the durable storage substrate.  Writer-specific
+        classification (human, scheduled, internal, delegated) lands later,
+        so the store deliberately treats the proof as an opaque JSON object.
+        Strings are accepted only for lossless store/read/store round trips
+        and must themselves decode to an object.
+        """
+        if origin_proof is None:
+            return None
+        parsed = origin_proof
+        if isinstance(origin_proof, str):
+            try:
+                parsed = json.loads(origin_proof)
+            except (json.JSONDecodeError, TypeError) as exc:
+                raise ValueError("origin_proof must be a JSON object") from exc
+        if not isinstance(parsed, dict):
+            raise ValueError("origin_proof must be a JSON object")
+        try:
+            return json.dumps(
+                parsed,
+                ensure_ascii=True,
+                allow_nan=False,
+                sort_keys=True,
+                separators=(",", ":"),
+            )
+        except (TypeError, ValueError) as exc:
+            raise ValueError("origin_proof must be JSON serializable") from exc
+
+    @staticmethod
+    def _decode_origin_proof(origin_proof: Any) -> Any:
+        """Decode a stored origin proof without hiding corrupt storage.
+
+        Invalid TEXT remains visible as TEXT.  A future classifier can then
+        fail closed for that message/group instead of mistaking corruption for
+        an absent proof.
+        """
+        if not isinstance(origin_proof, str):
+            return origin_proof
+
+        def reject_nonfinite(value: str) -> None:
+            raise ValueError(f"invalid JSON constant: {value}")
+
+        try:
+            parsed = json.loads(
+                origin_proof,
+                parse_constant=reject_nonfinite,
+            )
+        except (json.JSONDecodeError, TypeError, ValueError):
+            logger.warning("Invalid origin_proof JSON on message row")
+            return origin_proof
+        if not isinstance(parsed, dict):
+            logger.warning("Non-object origin_proof JSON on message row")
+            return origin_proof
+        return parsed
+
