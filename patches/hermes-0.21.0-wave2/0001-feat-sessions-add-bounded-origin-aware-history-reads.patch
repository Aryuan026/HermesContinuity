+    def get_messages_time_window(
+        self,
+        session_id: str,
+        *,
+        start_timestamp: float,
+        end_timestamp: float,
+        include_inactive: bool = False,
+        include_compacted: bool = False,
+        max_physical_rows: int,
+    ) -> Dict[str, Any]:
+        """Read one bounded inclusive message timestamp window.
+
+        SQLite applies the lifecycle and time predicates before the physical
+        row cap. The extra row is only an overflow sentinel; overflow returns
+        no message bodies because a later row could be the canonical winner
+        for an earlier compaction generation.
+
+        Complete canonical reads reuse :meth:`get_messages` generation
+        collapse and decoding. ``include_inactive`` takes precedence and
+        exposes every physical row for collision/lifecycle audit. Eligible
+        composite compaction carriers expose their logical live content in
+        both views, plus a private body-free digest of the physical wrapper;
+        pure handoffs and rotation-child assistant shadows remain identifiable
+        as synthetic. Persisted ``api_content`` is exposed as a private
+        body-free digest so same-session physical generations remain
+        auditable without making provider-side context part of cross-lineage
+        logical identity. Exact empty provider scaffolds also retain one fixed
+        body-free presence sentinel so downstream readers can exclude them.
+        Rows remain in AUTOINCREMENT order,
+        so a regressing wall clock affects membership in the requested window
+        but never reorders matching rows.
+        """
+        try:
+            start = float(start_timestamp)
+            end = float(end_timestamp)
+        except (TypeError, ValueError) as exc:
+            raise ValueError("timestamps must be finite numbers") from exc
+        if not math.isfinite(start) or not math.isfinite(end):
+            raise ValueError("timestamps must be finite numbers")
+        if start > end:
+            raise ValueError("start_timestamp must be <= end_timestamp")
+        if (
+            isinstance(max_physical_rows, bool)
+            or not isinstance(max_physical_rows, int)
+            or max_physical_rows <= 0
+        ):
+            raise ValueError("max_physical_rows must be a positive integer")
+
+        if include_inactive:
+            lifecycle_clause = ""
+        elif include_compacted:
+            lifecycle_clause = " AND (active = 1 OR compacted = 1)"
+        else:
+            lifecycle_clause = " AND active = 1"
+        with self._read_ctx() as conn:
+            rows = conn.execute(
+                "SELECT * FROM messages WHERE session_id = ? "
+                "AND timestamp >= ? AND timestamp <= ?"
+                f"{lifecycle_clause} ORDER BY id ASC LIMIT ?",
+                (session_id, start, end, max_physical_rows + 1),
+            ).fetchall()
+
+        physical_row_count = len(rows)
+        if physical_row_count > max_physical_rows:
+            return {
+                "messages": [],
+                "scan_complete": False,
+                "overflow": True,
+                "physical_row_count": physical_row_count,
+                "max_physical_rows": max_physical_rows,
+            }
+        if include_compacted and not include_inactive:
+            rows = self._dedupe_compacted_message_rows(rows)
+        decoded = self._decode_message_rows(rows)
+        projected = self._project_compaction_live_views(decoded)
+        for message in projected:
+            if "api_content" not in message:
+                continue
+            api_content = message.pop("api_content")
+            if api_content is None:
+                continue
+            if not isinstance(api_content, str):
+                raise ValueError("persisted api_content must be text or null")
+            message["_continuity_api_content_sha256"] = hashlib.sha256(
+                api_content.encode("utf-8")
+            ).hexdigest()
+            if (
+                api_content.strip()
+                and not message.get("content")
+                and not message.get("platform_message_id")
+                and (
+                    str(message.get("role") or "").strip().lower() == "user"
+                    or str(message.get("display_kind") or "").strip().lower()
+                    == "hidden"
+                )
+            ):
+                message["api_content"] = "[continuity provider scaffold]"
+        return {
+            "messages": projected,
+            "scan_complete": True,
+            "overflow": False,
+            "physical_row_count": physical_row_count,
+            "max_physical_rows": max_physical_rows,
+        }
 
