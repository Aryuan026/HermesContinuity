+def test_api_self_post_over_real_loopback_socket(tmp_path: Path):
+    if not api_server_module.AIOHTTP_AVAILABLE:
+        pytest.skip("aiohttp is not installed in this test runtime")
+
+    async def scenario():
+        from aiohttp import web
+
+        db = SessionDB(tmp_path / "state.db")
