+            )
+        )
+        adapter._session_db = db
+        calls = []
+        adapter._create_agent = lambda **_kwargs: _PersistingRunAgent(
+            db, session_id, calls
+        )
+        app = web.Application()
+        app.router.add_post(
+            "/v1/chat/completions", adapter._handle_chat_completions
+        )
+        runner = web.AppRunner(app)
+        await runner.setup()
+        site = web.TCPSite(runner, "127.0.0.1", 0)
+        await site.start()
+        adapter._port = site._server.sockets[0].getsockname()[1]
+        try:
+            await deliver_wake(
