+            )
+            user, _assistant = _rows(db, session_id)
+            assert user["display_kind"] == "internal_notification"
+            assert user["display_metadata"] == {"internal_kind": "wakeup"}
+            assert calls[0]["persist_user_display_metadata"] == {
+                "internal_kind": "wakeup"
+            }
+        finally:
+            await runner.cleanup()
+            adapter._response_store.close()
+            db.close()
