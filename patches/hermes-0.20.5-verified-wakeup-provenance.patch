+    @staticmethod
+    def _request_peer_is_loopback(request: "web.Request") -> bool:
+        """Check the socket peer, never proxy-controlled forwarding headers."""
+        peer_ip = ""
+        try:
+            peer = request.transport.get_extra_info("peername") if request.transport else None
+            if isinstance(peer, (tuple, list)) and peer:
+                peer_ip = str(peer[0])
+        except Exception:
+            peer_ip = ""
+        if not peer_ip:
+            peer_ip = str(getattr(request, "remote", "") or "")
+        try:
+            address = ipaddress.ip_address(peer_ip.split("%", 1)[0])
+            if isinstance(address, ipaddress.IPv6Address) and address.ipv4_mapped:
+                address = address.ipv4_mapped
+            return address.is_loopback
+        except ValueError:
+            return False
+
+    def _verify_internal_wakeup_request(
+        self, request: "web.Request"
+    ) -> tuple[bool, Optional["web.Response"]]:
+        """Authenticate the private loopback self-post provenance header.
+
+        An absent header is an ordinary API request.  A present but invalid
+        claim fails closed instead of silently becoming a human turn.
+        """
+        claimed_token = request.headers.get(INTERNAL_WAKE_HEADER, "")
+        if not claimed_token:
+            return False, None
+        token_ok = hmac.compare_digest(
+            claimed_token.encode(), self._internal_wakeup_token.encode()
+        )
+        if self._request_peer_is_loopback(request) and token_ok:
+            return True, None
+        logger.warning(
+            "API server rejected invalid internal wakeup claim: %s",
+            self._request_audit_log_suffix(request),
+        )
+        return False, web.json_response(
+            _openai_error(
+                "Invalid internal wakeup provenance",
+                err_type="gateway_auth_error",
+                code="invalid_internal_wakeup_provenance",
+            ),
+            status=403,
+        )
+
