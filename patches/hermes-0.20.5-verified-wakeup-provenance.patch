@@ -0,0 +1,409 @@
+"""Durable provenance for the two real gateway wake delivery paths."""
+
+from __future__ import annotations
+
+import asyncio
+import sys
+import types
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from agent.turn_context import build_turn_context
+from gateway.config import PlatformConfig
+from gateway.platforms import api_server as api_server_module
+from gateway.platforms.api_server import APIServerAdapter
+from gateway.platforms.base import MessageEvent, MessageType
+from gateway.wake import (
+    INTERNAL_WAKE_HEADER,
+    deliver_wake,
+    event_wakeup_display_metadata,
+)
+from hermes_state import SessionDB
+from run_agent import AIAgent
+
+
+API_KEY = "test-api-key-long-enough-for-auth"
+
+
+class _Response:
+    def __init__(self, payload, *, status=200, headers=None):
+        self.payload = payload
+        self.status = status
+        self.headers = headers or {}
+
+    async def read(self):
+        return b""
+
+    async def text(self):
+        return str(self.payload)
+
+
+class _Web:
+    @staticmethod
+    def json_response(payload, *, status=200, headers=None):
+        return _Response(payload, status=status, headers=headers)
+
+
+class _Transport:
+    def __init__(self, peer_ip="127.0.0.1"):
+        self.peer_ip = peer_ip
+
+    def get_extra_info(self, name):
+        assert name == "peername"
+        return (self.peer_ip, 43120)
+
+
+class _Request:
+    def __init__(self, payload, headers, *, peer_ip="127.0.0.1"):
+        self._payload = payload
+        self.headers = headers
+        self.transport = _Transport(peer_ip)
+        self.remote = peer_ip
+        self.method = "POST"
+        self.path_qs = "/v1/chat/completions"
+
+    async def json(self):
+        return self._payload
+
+
+class _ResponseContext:
+    def __init__(self, response_coro):
+        self.response_coro = response_coro
+
+    async def __aenter__(self):
+        return await self.response_coro
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+def _fake_aiohttp_for(adapter):
+    class ClientError(Exception):
+        pass
+
+    class ClientSession:
+        def __init__(self, *, timeout):
+            self.timeout = timeout
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, exc_type, exc, tb):
+            return False
+
+        def post(self, _url, *, json, headers):
+            request = _Request(json, headers)
+            return _ResponseContext(adapter._handle_chat_completions(request))
+
+    return types.SimpleNamespace(
+        ClientError=ClientError,
+        ClientSession=ClientSession,
+        ClientTimeout=lambda *, total: types.SimpleNamespace(total=total),
+    )
+
+
+def _persist_user_row(
+    db: SessionDB,
+    session_id: str,
+    content: str,
+    *,
+    display_kind: str | None,
+    display_metadata: dict | None,
+) -> None:
+    """Exercise the production turn-start persistence seam without an LLM call."""
+    with patch.object(AIAgent, "_create_openai_client", return_value=object()):
+        agent = AIAgent(
+            api_key="test-key",
+            base_url="https://openrouter.ai/api/v1",
+            model="test/model",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+            session_db=db,
+            session_id=session_id,
+        )
+    agent._session_db_created = True
+    agent._cached_system_prompt = "SYSTEM"
+    agent._skip_mcp_refresh = True
+    with (
+        patch("agent.auxiliary_client.set_runtime_main", lambda *a, **k: None),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+    ):
+        build_turn_context(
+            agent=agent,
+            user_message=content,
+            system_message=None,
+            conversation_history=None,
+            task_id=None,
+            stream_callback=None,
+            persist_user_message=None,
+            persist_user_display_kind=display_kind,
+            persist_user_display_metadata=display_metadata,
+            restore_or_build_system_prompt=lambda *a, **k: None,
+            install_safe_stdio=lambda: None,
+            sanitize_surrogates=lambda value: value,
+            summarize_user_message_for_log=lambda value: str(value),
+            set_session_context=lambda _sid: None,
+            set_current_write_origin=lambda _origin: None,
+            ra=lambda: types.SimpleNamespace(_set_interrupt=lambda *a, **k: None),
+        )
+
+
+def _append_assistant(db: SessionDB, session_id: str, content: str = "done") -> None:
+    db.append_message(session_id, "assistant", content)
+
+
+def _rows(db: SessionDB, session_id: str) -> list[dict]:
+    return [
+        row
+        for row in db.get_messages_as_conversation(session_id)
+        if row.get("role") in {"user", "assistant"}
+    ]
+
+
+class _PersistingRunAgent:
+    """Minimal provider-free agent used behind the real API `_run_agent`."""
+
+    def __init__(self, db: SessionDB, session_id: str, calls: list[dict]):
+        self.db = db
+        self.session_id = session_id
+        self.calls = calls
+        self.session_prompt_tokens = 1
+        self.session_completion_tokens = 1
+        self.session_total_tokens = 2
+        self._last_compaction_in_place = False
+
+    def run_conversation(self, **kwargs):
+        self.calls.append(kwargs)
+        _persist_user_row(
+            self.db,
+            self.session_id,
+            kwargs["user_message"],
+            display_kind=kwargs.get("persist_user_display_kind"),
+            display_metadata=kwargs.get("persist_user_display_metadata"),
+        )
+        _append_assistant(self.db, self.session_id)
+        return {
+            "final_response": "done",
+            "messages": [],
+            "completed": True,
+            "session_id": self.session_id,
+        }
+
+
+def test_push_wake_persists_a_closed_wakeup_pair(tmp_path: Path):
+    db = SessionDB(tmp_path / "state.db")
+    session_id = "push-wake"
+    db.create_session(session_id=session_id, source="telegram", model="test-model")
+
+    class PushAdapter:
+        supports_async_delivery = True
+
+        async def handle_message(self, event):
+            self.event = event
+
+    adapter = PushAdapter()
+    source = types.SimpleNamespace(platform="telegram", chat_id="chat-1")
+    try:
+        asyncio.run(deliver_wake(adapter, text="wake text", source=source))
+        adapter.event.metadata["untrusted_extra"] = "must-not-persist"
+        metadata = event_wakeup_display_metadata(adapter.event)
+        _persist_user_row(
+            db,
+            session_id,
+            adapter.event.text,
+            display_kind="internal_notification" if adapter.event.internal else None,
+            display_metadata=metadata,
+        )
+        _append_assistant(db, session_id)
+
+        user, assistant = _rows(db, session_id)
+        assert user["content"] == "wake text"
+        assert user["display_kind"] == "internal_notification"
+        assert user["display_metadata"] == {"internal_kind": "wakeup"}
+        assert assistant.get("display_metadata") is None
+    finally:
+        db.close()
+
+
+def test_api_self_post_authenticates_and_persists_wakeup_pair(tmp_path: Path):
+    db = SessionDB(tmp_path / "state.db")
+    session_id = "api-wake"
+    db.create_session(session_id=session_id, source="api_server", model="test-model")
+    adapter = APIServerAdapter(
+        PlatformConfig(enabled=True, extra={"host": "127.0.0.1", "key": API_KEY})
+    )
