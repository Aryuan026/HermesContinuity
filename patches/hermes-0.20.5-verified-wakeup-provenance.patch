@@ -31,6 +31,30 @@ from typing import Any, Optional
 
 logger = logging.getLogger(__name__)
 
+# Private hop-by-hop proof used only by the in-process API-server wake path.
+# The value is a per-adapter random token; the header name alone grants
+# nothing.  APIServerAdapter also requires the real socket peer to be
+# loopback before it accepts this provenance.
+INTERNAL_WAKE_HEADER = "X-Hermes-Internal-Wakeup"
+INTERNAL_WAKE_KIND = "wakeup"
+
+
+def event_wakeup_display_metadata(event: Any) -> Optional[dict[str, str]]:
+    """Return the only durable wakeup sidecar accepted from a gateway event.
+
+    Platform metadata is free-form and may be externally influenced, so the
+    provenance is honored only on an already-trusted internal event and is
+    copied into a closed one-key shape.
+    """
+    metadata = getattr(event, "metadata", None)
+    if (
+        getattr(event, "internal", False)
+        and isinstance(metadata, dict)
+        and metadata.get("internal_kind") == INTERNAL_WAKE_KIND
+    ):
+        return {"internal_kind": INTERNAL_WAKE_KIND}
+    return None
+
 # A wake self-post runs the entire agent turn synchronously (stream=false);
 # generous ceiling so long tool-using turns aren't killed mid-flight.
 WAKE_TURN_TIMEOUT_SECONDS = 600.0
