+from __future__ import annotations
+
+import copy
+import unittest
+from unittest.mock import patch
+
+from hermes_cli import middleware
+from hermes_cli import request_overlay as request_overlay_module
+from hermes_cli.request_overlay import (
+    OVERLAY_DRIFTED,
+    OVERLAY_KEPT,
+    OVERLAY_REMOVED_ESTIMATE_UNPROVEN,
+    OVERLAY_REMOVED_FINAL_BUDGET,
+    REQUEST_OVERLAY_SCHEMA_VERSION,
+    project_request_overlay,
+)
+
+
+NAMESPACE = "[TEST QUOTED REFERENCE"
+END = "[END TEST QUOTED REFERENCE]"
+MARKER = f"{NAMESPACE} marker=one]"
+BODY = f"quoted material\n{END}"
+BLOCK = f"{MARKER}\n{BODY}"
+
+
+def project(request, **kwargs):
+    return project_request_overlay(
+        request,
+        marker_namespace=NAMESPACE,
+        end_boundary=END,
+        marker=MARKER,
+        body=BODY,
+        **kwargs,
+    )
+
+
+class _FilterRecord:
+    schema_version = middleware.TRANSPORT_SCHEMA_VERSION
+
+    def __init__(self) -> None:
+        self.callback = None
+        self.phase = ""
+
+    def register_provider_body_filter(self, callback, *, phase="transform"):
+        self.callback = callback
+        self.phase = phase
+
+
+class RequestOverlayProjectionTests(unittest.TestCase):
+    def assert_projected(self, overlay) -> None:
+        self.assertEqual(overlay.status, "projected")
+        self.assertEqual(overlay.schema_version, REQUEST_OVERLAY_SCHEMA_VERSION)
+        self.assertTrue(overlay.verify_exact(overlay.request))
+        self.assertFalse(overlay.proof["body_included"])
+        self.assertNotIn(BODY, repr(overlay.proof))
+
+    def test_string_carrier_is_cloned_and_exact(self) -> None:
+        original = {
+            "model": "test",
+            "messages": [
+                {"role": "system", "content": "fixed"},
+                {"role": "user", "content": "current exact user body"},
+            ],
+        }
+        before = copy.deepcopy(original)
+
+        overlay = project(original)
+
+        self.assert_projected(overlay)
+        self.assertEqual(original, before)
+        self.assertEqual(
+            overlay.request["messages"][1]["content"],
+            f"{BLOCK}\n\ncurrent exact user body",
+        )
+        self.assertEqual(overlay.carrier_kind, "messages:string")
+        self.assertEqual(overlay.native_request(overlay.request), original)
+
+    def test_multimodal_and_image_only_carriers_preserve_provider_shape(self) -> None:
+        cases = (
+            (
+                {"type": "image_url", "image_url": {"url": "data:image/png;base64,AA"}},
+                "messages:text",
+                {"type": "text", "text": BLOCK},
+            ),
+            (
+                {"type": "input_image", "image_url": "data:image/png;base64,AA"},
+                "input:input_text",
+                {"type": "input_text", "text": BLOCK},
+            ),
+            (
+                {"image": {"format": "png", "source": {"bytes": b"x"}}},
+                "messages:bedrock_text",
+                {"text": BLOCK},
+            ),
+            (
+                {"type": "document", "source": {"data": "AA"}},
+                "messages:text",
+                {"type": "text", "text": BLOCK},
+            ),
+        )
+        for attachment, carrier_kind, expected_block in cases:
+            with self.subTest(carrier_kind=carrier_kind):
+                key = "input" if carrier_kind.startswith("input:") else "messages"
+                request = {key: [{"role": "user", "content": [attachment]}]}
+                overlay = project(request)
+                self.assert_projected(overlay)
+                self.assertEqual(overlay.carrier_kind, carrier_kind)
+                self.assertEqual(
+                    overlay.request[key][0]["content"],
+                    [expected_block, attachment],
+                )
+                self.assertEqual(overlay.native_request(overlay.request), request)
+
+    def test_tool_result_only_tail_does_not_steal_anthropic_carrier(self) -> None:
+        request = {
+            "messages": [
+                {"role": "user", "content": [{"type": "text", "text": "current"}]},
+                {"role": "assistant", "content": [{"type": "tool_use", "id": "t"}]},
+                {
+                    "role": "user",
+                    "content": [{"type": "tool_result", "tool_use_id": "t"}],
+                },
+            ]
+        }
+        overlay = project(request)
+        self.assert_projected(overlay)
+        self.assertEqual(overlay.carrier_index, 0)
+
+    def test_ambiguous_or_missing_carrier_fails_closed(self) -> None:
+        cases = (
+            ({"messages": [], "input": []}, "request_carrier_ambiguous"),
+            (
+                {"messages": [{"role": "assistant", "content": "answer"}]},
+                "real_user_carrier_missing",
+            ),
+            (
+                {"messages": [{"role": "user", "content": 7}]},
+                "real_user_carrier_missing",
+            ),
+        )
+        for request, reason in cases:
+            with self.subTest(reason=reason):
+                overlay = project(request)
+                self.assertEqual(overlay.status, "blocked")
+                self.assertEqual(overlay.reason, reason)
+                self.assertEqual(overlay.request, request)
+
+    def test_size_and_projection_material_are_closed(self) -> None:
+        request = {"messages": [{"role": "user", "content": "current"}]}
+        too_large = project(request, max_projection_chars=1)
+        self.assertEqual(too_large.reason, "projection_too_large")
+        invalid = project_request_overlay(
+            request,
+            marker_namespace=NAMESPACE,
+            end_boundary=END,
+            marker="wrong",
+            body=BODY,
+        )
+        self.assertEqual(invalid.reason, "projection_material_invalid")
+
+    def test_namespace_collision_in_any_provider_visible_field_fails_closed(
+        self,
+    ) -> None:
+        for field in ("system", "instructions"):
+            with self.subTest(field=field):
+                request = {
+                    field: f"user-authored {NAMESPACE}",
+                    "messages": [{"role": "user", "content": "current"}],
+                }
+                overlay = project(request)
+                self.assertEqual(overlay.status, "blocked")
+                self.assertEqual(overlay.reason, "projection_namespace_conflict")
+
+    def test_same_projection_is_idempotent_but_another_marker_is_blocked(self) -> None:
+        request = {"messages": [{"role": "user", "content": "current"}]}
+        first = project(request)
+        second = project(first.request)
+        self.assert_projected(second)
+        self.assertEqual(second.request, first.request)
+
+        other = project_request_overlay(
+            first.request,
+            marker_namespace=NAMESPACE,
+            end_boundary=END,
+            marker=f"{NAMESPACE} marker=two]",
+            body=f"other\n{END}",
+        )
+        self.assertEqual(other.status, "blocked")
+        self.assertEqual(other.reason, "projection_namespace_conflict")
+
+    def test_exact_verification_rejects_any_request_or_proof_material_drift(
+        self,
+    ) -> None:
+        overlay = project({"messages": [{"role": "user", "content": "current"}]})
+        changed = copy.deepcopy(overlay.request)
+        changed["model"] = "other"
+        self.assertFalse(overlay.verify_exact(changed))
+
+        replaced = copy.deepcopy(overlay.request)
+        replaced["messages"][0]["content"] = f"{BLOCK}\n\nreplacement"
+        self.assertIsNone(overlay.native_request(replaced))
+
+    def test_scoped_removal_preserves_independent_string_and_list_additions(
+        self,
+    ) -> None:
+        string_request = {"messages": [{"role": "user", "content": "current"}]}
+        string_overlay = project(string_request)
+        string_changed = copy.deepcopy(string_overlay.request)
+        string_changed["messages"][0]["content"] += "\n\n<other>keep</other>"
+        string_changed["other_proof"] = {"status": "keep"}
+        native = string_overlay.native_request(string_changed)
+        self.assertEqual(native["other_proof"], {"status": "keep"})
+        self.assertEqual(
+            native["messages"][0]["content"],
+            "current\n\n<other>keep</other>",
+        )
+
+        original_parts = [{"type": "text", "text": "current"}]
+        list_request = {"messages": [{"role": "user", "content": original_parts}]}
+        list_overlay = project(list_request)
+        list_changed = copy.deepcopy(list_overlay.request)
+        downstream = {"type": "text", "text": "downstream"}
+        list_changed["messages"][0]["content"].append(downstream)
+        self.assertEqual(
+            list_overlay.native_request(list_changed)["messages"][0]["content"],
+            [*original_parts, downstream],
+        )
+
+    def test_canonical_hash_distinguishes_mapping_key_types(self) -> None:
+        left = project({"messages": [{"role": "user", "content": "x"}], 1: "v"})
+        right = project({"messages": [{"role": "user", "content": "x"}], "1": "v"})
+        self.assertNotEqual(left.request_sha256, right.request_sha256)
+
+    def test_canonical_hash_is_stable_across_mapping_key_order(self) -> None:
+        left = {"model": "test", "messages": [{"role": "user", "content": "x"}]}
+        right = {"messages": [{"content": "x", "role": "user"}], "model": "test"}
+        self.assertEqual(
+            request_overlay_module.canonical_request_sha256(left),
+            request_overlay_module.canonical_request_sha256(right),
+        )
+
+    def test_large_carrier_proof_hashes_one_adjacent_slice_per_check(self) -> None:
+        carriers = (
+            "x" * 1_000_000,
+            [
+                {"type": "input_text", "text": f"part-{index}"}
+                for index in range(10_000)
+            ],
+        )
+        for content in carriers:
+            with self.subTest(kind=type(content).__name__):
+                overlay = project({"messages": [{"role": "user", "content": content}]})
+                calls = 0
+                original_hash = request_overlay_module.canonical_request_sha256
+
+                def counted(value):
+                    nonlocal calls
+                    calls += 1
+                    return original_hash(value)
+
+                with patch.object(
+                    request_overlay_module,
+                    "canonical_request_sha256",
+                    side_effect=counted,
+                ):
+                    for _ in range(3):
+                        self.assertIsNotNone(overlay.native_request(overlay.request))
+                self.assertEqual(calls, 3)
+
+
+class RequestOverlayBudgetTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.overlay = project({
+            "messages": [{"role": "user", "content": "current"}],
+            "max_tokens": 32,
+        })
+
+    def register(self, record, *, window):
+        token = middleware._CURRENT_MIDDLEWARE_OWNER.set("test-plugin")
+        try:
+            return self.overlay.register_final_budget_guard(
+                record,
+                context_window_tokens=window,
+                reserve_tokens=lambda body, _window: body.get("max_tokens", 32),
+                validator=lambda _body, native: (
+                    native["messages"][0]["content"] == "current"
+                ),
+            )
+        finally:
+            middleware._CURRENT_MIDDLEWARE_OWNER.reset(token)
+
+    def test_final_budget_guard_keeps_fitting_overlay(self) -> None:
+        record = middleware.TransportRecord()
+        self.assertTrue(self.register(record, window=100_000))
+        filtered = record.filter_provider_body(self.overlay.request)
+        self.assertEqual(filtered, self.overlay.request)
+        self.assertEqual(self.overlay.disposition, OVERLAY_KEPT)
+
+    def test_final_budget_guard_removes_only_owned_overlay_on_overflow(self) -> None:
+        record = middleware.TransportRecord()
+        self.assertTrue(self.register(record, window=1))
+        filtered = record.filter_provider_body(self.overlay.request)
+        self.assertEqual(filtered["messages"][0]["content"], "current")
+        self.assertEqual(self.overlay.disposition, OVERLAY_REMOVED_FINAL_BUDGET)
+
+    def test_unproven_estimate_has_a_distinct_removal_disposition(self) -> None:
+        record = _FilterRecord()
+        self.assertTrue(self.register(record, window=100_000))
+        filtered = record.callback(
+            copy.deepcopy(self.overlay.request),
+            estimated_tokens=None,
+            estimate_source="unknown",
+            estimate_confidence="unknown",
+        )
+        self.assertEqual(filtered["messages"][0]["content"], "current")
+        self.assertEqual(
+            self.overlay.disposition,
+            OVERLAY_REMOVED_ESTIMATE_UNPROVEN,
+        )
+
+    def test_final_carrier_drift_is_visible_and_provider_is_not_blocked(self) -> None:
+        record = middleware.TransportRecord()
+        self.assertTrue(self.register(record, window=100_000))
+        changed = copy.deepcopy(self.overlay.request)
+        changed["messages"][0]["content"] = f"{BLOCK}\n\nreplacement"
+        filtered = record.filter_provider_body(changed)
+        self.assertEqual(filtered, changed)
+        self.assertTrue(record.ambiguous)
+        self.assertEqual(self.overlay.disposition, OVERLAY_DRIFTED)
+
+    def test_composed_overlays_can_both_shrink_in_either_guard_order(self) -> None:
+        native = {
+            "messages": [{"role": "user", "content": "current"}],
+            "max_tokens": 32,
+        }
+        for owners in (("first", "second"), ("second", "first")):
+            with self.subTest(owners=owners):
+                first = project_request_overlay(
+                    native,
+                    marker_namespace="[FIRST QUOTED REFERENCE",
+                    end_boundary="[END FIRST QUOTED REFERENCE]",
+                    marker="[FIRST QUOTED REFERENCE marker=one]",
+                    body="first\n[END FIRST QUOTED REFERENCE]",
+                )
+                second = project_request_overlay(
+                    first.request,
+                    marker_namespace="[SECOND QUOTED REFERENCE",
+                    end_boundary="[END SECOND QUOTED REFERENCE]",
+                    marker="[SECOND QUOTED REFERENCE marker=two]",
+                    body="second\n[END SECOND QUOTED REFERENCE]",
+                )
+                overlays = {"first": first, "second": second}
+                record = middleware.TransportRecord()
+                for owner in owners:
+                    token = middleware._CURRENT_MIDDLEWARE_OWNER.set(owner)
+                    try:
+                        self.assertTrue(
+                            overlays[owner].register_final_budget_guard(
+                                record,
+                                context_window_tokens=1,
+                                reserve_tokens=lambda _body, _window: 32,
+                                validator=lambda _body, candidate: candidate[
+                                    "messages"
+                                ][0]["content"].endswith("current"),
+                            )
+                        )
+                    finally:
+                        middleware._CURRENT_MIDDLEWARE_OWNER.reset(token)
+
+                first_removed = first.native_request(
+                    second.request,
+                    require_original_material=False,
+                )
+                self.assertIsNotNone(first_removed)
+                self.assertIsNone(second.native_request(first_removed))
+
+                filtered = record.filter_provider_body(second.request)
+                self.assertEqual(filtered, native)
+                self.assertFalse(record.ambiguous)
+                self.assertEqual(
+                    first.disposition,
+                    OVERLAY_REMOVED_FINAL_BUDGET,
+                )
+                self.assertEqual(
+                    second.disposition,
+                    OVERLAY_REMOVED_FINAL_BUDGET,
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
