+    def _history_recover_notification_clone(self, conn, domain_id, bucket, row):
+        """Recover a lost tag from an older archived, otherwise exact clone.
+
+        This is a derived view only. Physical members keep their original
+        signatures; missing metadata never independently grants human origin.
+        """
+        if (row["role"] != "user" or row["display_kind"] is not None
+                or int(row["id"]) <= int(bucket["earliest_message_id"])):
+            return None
+        origin = conn.execute(
+            "SELECT CASE WHEN display_kind='internal_notification' "
+            "AND active=0 AND compacted=1 THEN 1 ELSE 0 END "
+            "FROM messages WHERE session_id=? AND id=?",
+            (domain_id, bucket["earliest_message_id"]),
+        ).fetchone()
+        if origin is None or origin[0] != 1:
+            return None
+        recovered = dict(row, display_kind="internal_notification")
+        material = self._history_row_material(recovered, 0)
+        if any(bucket[key] != material[key] for key in (
+                "raw_key_digest", "semantic_key_digest", "raw_signature", "semantic_signature")):
+            return None
+        return recovered
+
