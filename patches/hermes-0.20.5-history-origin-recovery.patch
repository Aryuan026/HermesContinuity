+def _notification_clones(db, **changed):
+    db.append_message("history", "user", "notification", timestamp=1,
+                      display_kind="internal_notification")
+    original = db.get_messages("history")
+    missing = dict(original[0], display_kind=None, **changed)
+    db.archive_and_compact("history", [missing])
+    db.archive_and_compact("history", [missing])
+    db.append_message("history", "assistant", "reply", timestamp=2)
+
+
+def test_notification_clone_recovers_content_without_rewriting_physical_rows(history_db):
+    _notification_clones(history_db)
+    before = [tuple(row) for row in history_db._conn.execute("SELECT * FROM messages ORDER BY id")]
+    ready = _prepare(history_db)
+    assert ready["status"] == "ready"
+    assert ready["canonical_count"] == 2
+    page = history_db.read_history_page("history", target=ready["head_token"])
+    assert [row["content"] for row in page["rows"]] == ["notification", "reply"]
+    assert page["rows"][0]["display_kind"] == "internal_notification"
+    assert page["entries"][0]["physical_count"] == 3
+    assert [tuple(row) for row in history_db._conn.execute("SELECT * FROM messages ORDER BY id")] == before
+    members = history_db._conn.execute(
+        "SELECT COUNT(DISTINCT raw_signature), COUNT(DISTINCT semantic_signature) "
+        "FROM hermes_history_members WHERE domain_id='history' AND anchor=?",
+        (page["entries"][0]["anchor"],),
+    ).fetchone()
+    assert tuple(members) == (2, 2)  # Original evidence, not normalized physical signatures.
+    size = page["entries"][0]["stored_bytes"]
+    exact = history_db.read_history_page("history", target=ready["head_token"], max_rows=1, max_bytes=size)
+    assert exact["status"] == "ready"
+    too_small = history_db.read_history_page("history", target=ready["head_token"], max_rows=1, max_bytes=size-1)
+    assert too_small["status"] == "overflow" and not too_small["rows"]
+
+
+@pytest.mark.parametrize("changed", [
+    {"api_content": "different API material"},
+    {"display_metadata": {"internal_kind": "wakeup"}},
+    {"platform_message_id": "different-platform-id"},
+    {"finish_reason": "stop"},
+])
+def test_notification_recovery_does_not_hide_other_persisted_conflicts(history_db, changed):
+    _notification_clones(history_db, **changed)
+    result = _prepare(history_db)
+    assert result["reason"] == "canonical_clone_audit_collision"
+
+
+def test_recovered_origin_mutation_invalidates_and_rejects_recovery(history_db):
+    _notification_clones(history_db)
+    ready = _prepare(history_db)
+    with history_db._conn:
+        history_db._conn.execute("UPDATE messages SET display_kind='hidden' WHERE id=(SELECT MIN(id) FROM messages)")
+    assert history_db.validate_history_prefix(ready["head_token"])["status"] != "valid"
+    assert _prepare(history_db)["reason"] == "canonical_clone_audit_collision"
+
+
+def test_rule_change_resets_existing_domain_before_minting_new_proof(history_db):
+    _append_turn(history_db, 1)
+    ready = _prepare(history_db)
+    old_token = dict(ready["head_token"], canonical_rule_version="hermes.canonical_history_rule.v1")
+    assert history_db.validate_history_prefix(old_token)["status"] == "incompatible"
+    with history_db._conn:
+        history_db._conn.execute("UPDATE hermes_history_domains SET canonical_rule_version='hermes.canonical_history_rule.v1'")
+    assert history_db.validate_history_prefix(ready["head_token"])["reason"] == "canonical_rule_changed"
+    sealed = history_db.seal_history_prefix("history", activation_epoch=ready["activation_epoch"], end_anchor=None)
+    assert sealed["reason"] == "canonical_rule_changed" and sealed["token"] is None
+    step = history_db.prepare_history_step("history", owner_id="test-owner", activation_epoch=ready["activation_epoch"], max_pages=1)
+    assert step["status"] == "progress" and step["head_token"] is None
+    assert _prepare(history_db)["status"] == "ready"
+
+
+@pytest.mark.parametrize("original_kind,clone_kind", [
+    ("hidden", None), (None, "internal_notification"),
+    ("internal_notification", "hidden"),
+])
+def test_recovery_requires_earlier_explicit_notification_and_missing_clone(history_db, original_kind, clone_kind):
+    history_db.append_message("history", "user", "notification", timestamp=1,
+                              display_kind=original_kind)
+    clone = dict(history_db.get_messages("history")[0], display_kind=clone_kind)
+    history_db.archive_and_compact("history", [clone])
+    history_db.append_message("history", "assistant", "reply", timestamp=2)
+    assert _prepare(history_db)["reason"] == "canonical_clone_audit_collision"
+
+
