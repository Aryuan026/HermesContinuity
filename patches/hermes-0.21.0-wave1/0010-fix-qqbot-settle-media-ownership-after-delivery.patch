+@pytest.mark.asyncio
+async def test_final_waits_for_pending_interim_attempt(tmp_path, monkeypatch):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "report.pdf")
+    adapter = _adapter()
+    started = asyncio.Event()
+    release = asyncio.Event()
+
+    async def delayed_success(**_kwargs):
+        started.set()
+        await release.wait()
+        return SendResult(success=True, message_id="interim-doc")
+
+    adapter.send_document.side_effect = delayed_success
+    reservations = {}
+    response = f"Report ready.\nMEDIA:{media_file}"
+    interim = asyncio.create_task(
+        GatewayRunner._deliver_interim_assistant_response(
+            _runner(),
+            response,
+            _source(),
+            adapter,
+            send_text=False,
+            media_reservations=reservations,
+            run_generation=37,
+        )
+    )
+    await started.wait()
+    final = asyncio.create_task(
+        GatewayRunner._deliver_media_from_response(
+            _runner(),
+            response,
+            SimpleNamespace(source=_source()),
+            adapter,
+            media_reservations=reservations,
+            run_generation=37,
+        )
+    )
+    await asyncio.sleep(0)
+
+    assert adapter.send_document.await_count == 1
+    assert not final.done()
+    release.set()
+    await asyncio.gather(interim, final)
+    assert adapter.send_document.await_count == 1
+
