+    @staticmethod
+    async def _reserve_media_delivery(
+        reservations: dict,
+        identity: tuple,
+    ) -> Optional[asyncio.Future]:
+        """Wait for the current owner and reserve only undelivered media."""
+        loop = asyncio.get_running_loop()
+        while True:
+            current = reservations.get(identity)
+            if current is None:
+                reservation = loop.create_future()
+                reservations[identity] = reservation
+                return reservation
+            disposition = await asyncio.shield(current)
+            if disposition != "definite_failed":
+                return None
+            reservation = loop.create_future()
+            if reservations.get(identity) is current:
+                reservations[identity] = reservation
+                return reservation
+
+    @staticmethod
+    async def _run_reserved_media_delivery(
+        *,
+        adapter,
+        event: MessageEvent,
+        media_path: str,
+        is_voice: bool,
+        metadata: Dict[str, Any],
+        reservation: asyncio.Future,
+        send_media: Callable[[], Awaitable[Any]],
+        final_delivery: bool,
+    ) -> None:
+        disposition = "ambiguous"
+        error = None
+        try:
+            result = await send_media()
+            if getattr(result, "success", False):
+                disposition = "delivered"
+            elif (
+                getattr(result, "delivery_disposition", None)
+                == MEDIA_DELIVERY_NOT_DELIVERED
+            ):
+                disposition = "definite_failed"
+                error = getattr(result, "error", None)
+            else:
+                error = getattr(result, "error", None)
+        except MediaDeliveryNotAttemptedError as exc:
+            disposition = "definite_failed"
+            error = str(exc)
+        except asyncio.CancelledError:
+            if not reservation.done():
+                reservation.set_result("ambiguous")
+            raise
+        except Exception as exc:
+            error = str(exc) or type(exc).__name__
+        if not reservation.done():
+            reservation.set_result(disposition)
+        if disposition == "definite_failed" and final_delivery:
+            await adapter._notify_media_delivery_failure(
+                event.source.chat_id,
+                media_path,
+                is_voice=is_voice,
+                metadata=metadata,
+            )
+        elif disposition == "ambiguous":
+            logger.warning(
+                "[%s] Media delivery outcome is ambiguous for %s: %s",
+                adapter.name,
+                Path(media_path).name,
+                error or "provider returned no delivery truth",
+            )
+
