+    async def _deliver_interim_assistant_response(
+        self,
+        response: str,
+        source: SessionSource,
+        adapter,
+        chat_id: Optional[str] = None,
+        metadata: Optional[Dict[str, Any]] = None,
+        event_message_id: Optional[str] = None,
+        send_text: bool = True,
+    ) -> None:
+        """Deliver interim QQ text and explicit attachments without path leaks."""
+        media_files, cleaned = adapter.extract_media(response)
+
+        if send_text and str(cleaned or "").strip():
+            interim_metadata = dict(metadata or {})
+            interim_metadata["_interim_send"] = True
+            await adapter.send(
+                chat_id or source.chat_id,
+                cleaned,
+                metadata=interim_metadata,
+            )
+
+        if media_files:
+            event = MessageEvent(
+                text=response,
+                message_type=MessageType.TEXT,
+                source=source,
+                message_id=event_message_id,
+            )
+            await self._deliver_media_from_response(
+                response,
+                event,
+                adapter,
+                thread_metadata=metadata,
+            )
+
     async def _deliver_media_from_response(
