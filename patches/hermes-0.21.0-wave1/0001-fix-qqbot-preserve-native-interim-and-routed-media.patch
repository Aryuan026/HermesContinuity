diff --git a/tests/gateway/test_qqbot_interim_media_delivery.py b/tests/gateway/test_qqbot_interim_media_delivery.py
new file mode 100644
index 0000000..ffc453f
--- /dev/null
+++ b/tests/gateway/test_qqbot_interim_media_delivery.py
@@ -0,0 +1,124 @@
+"""QQ interim responses keep text clean and deliver explicit media natively."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+
+
+def _source():
+    return SessionSource(
+        platform=Platform.QQBOT,
+        chat_id="qq-chat",
+        chat_type="private",
+        thread_id=None,
+    )
+
+
+def _runner():
+    runner = object.__new__(GatewayRunner)
+    runner._thread_metadata_for_source = lambda source, anchor=None: {}
+    runner._reply_anchor_for_event = lambda event: None
+    return runner
+
+
+def _adapter():
+    return SimpleNamespace(
+        name="qqbot",
+        extract_media=BasePlatformAdapter.extract_media,
+        extract_images=BasePlatformAdapter.extract_images,
+        send=AsyncMock(return_value=SendResult(success=True, message_id="text")),
+        send_voice=AsyncMock(return_value=SendResult(success=True, message_id="voice")),
+        send_document=AsyncMock(return_value=SendResult(success=True, message_id="doc")),
+        send_video=AsyncMock(return_value=SendResult(success=True, message_id="video")),
+        send_multiple_images=AsyncMock(return_value=SendResult(success=True, message_id="image")),
+    )
+
+
+def _allowed_media_path(tmp_path, monkeypatch, name):
+    root = tmp_path / "media-cache"
+    media_file = root / name
+    media_file.parent.mkdir(parents=True, exist_ok=True)
+    media_file.write_bytes(b"media")
+    monkeypatch.setattr("gateway.platforms.base.MEDIA_DELIVERY_SAFE_ROOTS", (root,))
+    return media_file.resolve()
+
+
+@pytest.mark.asyncio
+async def test_interim_image_hides_path_and_preserves_interim_metadata(tmp_path, monkeypatch):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "chart.png")
+    adapter = _adapter()
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        _runner(),
+        f"Here is the chart.\nMEDIA:{media_file}",
+        _source(),
+        adapter,
+        metadata={"thread_id": "thread-1"},
+        event_message_id="message-1",
+    )
+
+    adapter.send.assert_awaited_once()
+    sent_text = adapter.send.await_args.args[1]
+    sent_metadata = adapter.send.await_args.kwargs["metadata"]
+    assert "Here is the chart." in sent_text
+    assert str(media_file) not in sent_text
+    assert sent_metadata == {"thread_id": "thread-1", "_interim_send": True}
+    adapter.send_multiple_images.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_stream_consumer_lane_delivers_media_without_duplicate_text(tmp_path, monkeypatch):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "chart.png")
+    adapter = _adapter()
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        _runner(),
+        f"Here is the chart.\nMEDIA:{media_file}",
+        _source(),
+        adapter,
+        send_text=False,
+    )
+
+    adapter.send.assert_not_awaited()
+    adapter.send_multiple_images.assert_awaited_once()
+
+
+@pytest.mark.parametrize("name", ["notes.txt", "paper.pdf"])
+@pytest.mark.asyncio
+async def test_interim_files_use_document_delivery(tmp_path, monkeypatch, name):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, name)
+    adapter = _adapter()
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        _runner(),
+        f"Requested file.\nMEDIA:{media_file}",
+        _source(),
+        adapter,
+    )
+
+    adapter.send_multiple_images.assert_not_awaited()
+    adapter.send_document.assert_awaited_once()
+    assert adapter.send_document.await_args.kwargs["file_path"] == str(media_file)
+
+
+@pytest.mark.asyncio
+async def test_as_document_preserves_image_bytes_as_file(tmp_path, monkeypatch):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "original.png")
+    adapter = _adapter()
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        _runner(),
+        f"Original file.\n[[as_document]]\nMEDIA:{media_file}",
+        _source(),
+        adapter,
+    )
+
+    adapter.send_multiple_images.assert_not_awaited()
+    adapter.send_document.assert_awaited_once()
+    assert adapter.send_document.await_args.kwargs["file_path"] == str(media_file)
diff --git a/tests/tools/test_send_message_qqbot_media.py b/tests/tools/test_send_message_qqbot_media.py
new file mode 100644
index 0000000..c930948
--- /dev/null
+++ b/tests/tools/test_send_message_qqbot_media.py
@@ -0,0 +1,136 @@
+"""QQ send_message delivery uses the connected native adapter for media."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.base import SendResult
+from tools.send_message_tool import _send_to_platform, _send_via_adapter
+
+
+class _Adapter:
+    def __init__(self):
+        self.send_mock = AsyncMock(return_value=SendResult(success=True, message_id="text"))
+        self.send_image_file_mock = AsyncMock(
+            return_value=SendResult(success=True, message_id="image")
+        )
+        self.send_voice_mock = AsyncMock(
+            return_value=SendResult(success=True, message_id="voice")
+        )
+        self.send_video_mock = AsyncMock(
+            return_value=SendResult(success=True, message_id="video")
+        )
+        self.send_document_mock = AsyncMock(
+            return_value=SendResult(success=True, message_id="document")
+        )
+
+    async def send(self, *args, **kwargs):
+        return await self.send_mock(*args, **kwargs)
+
+    async def send_image_file(self, *args, **kwargs):
+        return await self.send_image_file_mock(*args, **kwargs)
+
+    async def send_voice(self, *args, **kwargs):
+        return await self.send_voice_mock(*args, **kwargs)
+
+    async def send_video(self, *args, **kwargs):
+        return await self.send_video_mock(*args, **kwargs)
+
+    async def send_document(self, *args, **kwargs):
+        return await self.send_document_mock(*args, **kwargs)
+
+
+@pytest.mark.asyncio
+async def test_qqbot_text_and_image_use_live_native_adapter(tmp_path):
+    image = tmp_path / "chart.png"
+    image.write_bytes(b"image")
+    adapter = _Adapter()
+    runner = SimpleNamespace(adapters={Platform.QQBOT: adapter}, _gateway_loop=None)
+
+    with patch("gateway.run._gateway_runner_ref", return_value=runner):
+        result = await _send_via_adapter(
+            Platform.QQBOT,
+            SimpleNamespace(),
+            "qq-chat",
+            "Here is the image.",
+            media_files=[(str(image), False)],
+        )
+
+    assert result["success"] is True
+    adapter.send_mock.assert_not_awaited()
+    adapter.send_image_file_mock.assert_awaited_once_with(
+        "qq-chat",
+        str(image),
+        caption="Here is the image.",
+        reply_to=None,
+        metadata=None,
+    )
+
+
+@pytest.mark.asyncio
+async def test_qqbot_as_document_preserves_image_bytes(tmp_path):
+    image = tmp_path / "original.png"
+    image.write_bytes(b"image")
+    adapter = _Adapter()
+    runner = SimpleNamespace(adapters={Platform.QQBOT: adapter}, _gateway_loop=None)
+
+    with patch("gateway.run._gateway_runner_ref", return_value=runner):
+        result = await _send_via_adapter(
+            Platform.QQBOT,
+            SimpleNamespace(),
+            "qq-chat",
+            "Original file.",
+            media_files=[(str(image), False)],
+            force_document=True,
+        )
+
+    assert result["success"] is True
+    adapter.send_image_file_mock.assert_not_awaited()
+    adapter.send_document_mock.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_qqbot_media_fails_explicitly_without_live_adapter(tmp_path):
+    image = tmp_path / "chart.png"
+    image.write_bytes(b"image")
+
+    with patch("gateway.run._gateway_runner_ref", return_value=None):
+        result = await _send_via_adapter(
+            Platform.QQBOT,
+            SimpleNamespace(),
+            "qq-chat",
+            "Attachment follows.",
+            media_files=[(str(image), False)],
+        )
+
+    assert "error" in result
+    assert "live adapter" in result["error"].lower()
+
+
+@pytest.mark.asyncio
+async def test_send_to_platform_routes_qq_media_to_generic_native_helper():
+    media_files = [("/tmp/chart.png", False)]
+    native_send = AsyncMock(return_value={"success": True, "message_id": "image"})
+
+    with patch("tools.send_message_tool._send_via_adapter", native_send):
+        result = await _send_to_platform(
+            Platform.QQBOT,
+            SimpleNamespace(token="unused", extra={}),
+            "qq-chat",
+            "Here is the image.",
+            media_files=media_files,
+            force_document=True,
+        )
+
+    assert result["success"] is True
+    native_send.assert_awaited_once_with(
+        Platform.QQBOT,
+        SimpleNamespace(token="unused", extra={}),
+        "qq-chat",
+        "Here is the image.",
+        thread_id=None,
+        media_files=media_files,
+        force_document=True,
+    )
