diff --git a/tests/test_middleware.py b/tests/test_middleware.py
index e1bc8d9..214a8f3 100644
--- a/tests/test_middleware.py
+++ b/tests/test_middleware.py
@@ -10,6 +10,11 @@ class _OpaqueLeaf:
         raise TypeError("host-private leaf")
 
 
+class _AliasingDict(dict):
+    def __deepcopy__(self, memo):
+        return self
+
+
 def _install_request_callbacks(monkeypatch, callbacks_by_kind):
     monkeypatch.setattr(middleware, "_has_middleware", lambda kind: True)
     monkeypatch.setattr(
@@ -264,6 +269,99 @@ def test_accepted_payload_is_detached_from_callback_reference(monkeypatch):
     assert baseline["metadata"]["steps"] == []
 
 
+def test_llm_request_rejects_top_level_deepcopy_alias_before_callbacks(monkeypatch):
+    baseline = _AliasingDict(
+        messages=[{"role": "user", "content": "clean"}],
+    )
+    calls = []
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.LLM_REQUEST_MIDDLEWARE: [lambda **_kwargs: calls.append(True)]},
+    )
+    result = middleware.apply_llm_request_middleware(baseline)
+
+    assert calls == []
+    assert result.payload is baseline
+    assert result.changed is False
+    assert result.trace == []
+
+
+def test_tool_request_rejects_nested_mutable_deepcopy_alias(monkeypatch):
+    shared = _AliasingDict(steps=[])
+    baseline = {"query": "clean", "options": shared}
+    calls = []
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.TOOL_REQUEST_MIDDLEWARE: [lambda **_kwargs: calls.append(True)]},
+    )
+    result = middleware.apply_tool_request_middleware(
+        "web_search", baseline, skip_relay=True
+    )
+
+    assert calls == []
+    assert result.payload is baseline
+    assert shared["steps"] == []
+    assert result.changed is False
+    assert result.trace == []
+
+
+def test_callback_alias_failure_rolls_back_the_whole_llm_pass(monkeypatch):
+    baseline = {
+        "messages": [{"role": "user", "content": "clean"}],
+        "metadata": {"steps": []},
+    }
+    shared = _AliasingDict(
+        messages=[{"role": "user", "content": "clean"}],
+        metadata={"steps": ["first"]},
+    )
+    calls = []
+
+    def first(**_kwargs):
+        calls.append("first")
+        return {"request": shared, "source": "first"}
+
+    def poison(*, request, **_kwargs):
+        calls.append("poison")
+        request["messages"][0]["content"] = "poisoned"
+        raise RuntimeError("boom")
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.LLM_REQUEST_MIDDLEWARE: [first, poison]},
+    )
+    result = middleware.apply_llm_request_middleware(baseline)
+
+    assert calls == ["first"]
+    assert result.payload is baseline
+    assert baseline["messages"][0]["content"] == "clean"
+    assert result.changed is False
+    assert result.trace == []
+
+
+def test_uncopyable_mid_pass_replacement_rolls_back_to_native(monkeypatch):
+    baseline = {"messages": [], "metadata": {"steps": []}}
+
+    def accepted(*, request, **_kwargs):
+        request["metadata"]["steps"].append("accepted")
+        return {"request": request, "source": "accepted"}
+
+    def uncopyable(*, request, **_kwargs):
+        return {"request": {**request, "_client": _OpaqueLeaf()}}
+
+    _install_request_callbacks(
+        monkeypatch,
+        {middleware.LLM_REQUEST_MIDDLEWARE: [accepted, uncopyable]},
+    )
+    result = middleware.apply_llm_request_middleware(baseline)
+
+    assert result.payload is baseline
+    assert baseline["metadata"]["steps"] == []
+    assert result.changed is False
+    assert result.trace == []
+
+
