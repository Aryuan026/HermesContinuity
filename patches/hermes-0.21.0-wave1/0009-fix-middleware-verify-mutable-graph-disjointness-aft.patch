     """The payload cannot be detached safely for plugin-visible mutation."""
 
 
+_IMMUTABLE_PAYLOAD_LEAVES = (str, bytes, int, float, complex, bool, type(None))
+
+
+def _mutable_payload_node_ids(payload: Any) -> set[int]:
+    """Return identities of every potentially mutable node in ``payload``."""
+    mutable: set[int] = set()
+    seen: set[int] = set()
+
+    def visit(value: Any) -> None:
+        identity = id(value)
+        if identity in seen:
+            return
+        seen.add(identity)
+        if isinstance(value, _IMMUTABLE_PAYLOAD_LEAVES):
+            return
+        if isinstance(value, (tuple, frozenset)):
+            for item in value:
+                visit(item)
+            return
+
+        mutable.add(identity)
+        if isinstance(value, Mapping):
+            for key, item in value.items():
+                visit(key)
+                visit(item)
+            return
+        if isinstance(value, (list, set)):
+            for item in value:
+                visit(item)
+            return
+
+        try:
+            attributes = vars(value)
+        except TypeError:
+            attributes = None
+        if attributes:
+            for item in attributes.values():
+                visit(item)
+
+        for cls in type(value).__mro__:
+            slots = getattr(cls, "__slots__", ())
+            if isinstance(slots, str):
+                slots = (slots,)
+            for slot in slots:
+                if slot in {"__dict__", "__weakref__"}:
+                    continue
+                try:
+                    visit(getattr(value, slot))
+                except (AttributeError, TypeError):
+                    pass
+
+    visit(payload)
+    return mutable
+
+
