+@pytest.mark.parametrize("final_first", [False, True])
+@pytest.mark.asyncio
+async def test_interim_and_streamed_final_claim_same_image_once(
+    tmp_path, monkeypatch, final_first
+):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "chart.png")
+    adapter = _adapter()
+    runner = _runner()
+    claims = set()
+    response = f"Here is the chart.\nMEDIA:{media_file}"
+    event = SimpleNamespace(source=_source())
+
+    interim = lambda: GatewayRunner._deliver_interim_assistant_response(
+        runner,
+        response,
+        _source(),
+        adapter,
+        send_text=False,
+        media_claims=claims,
+        run_generation=7,
+    )
+    final = lambda: GatewayRunner._deliver_media_from_response(
+        runner,
+        response,
+        event,
+        adapter,
+        media_claims=claims,
+        run_generation=7,
+    )
+
+    await (final() if final_first else interim())
+    await (interim() if final_first else final())
+
+    adapter.send_multiple_images.assert_awaited_once()
+
+
+@pytest.mark.parametrize(
+    ("name", "directive", "method"),
+    [
+        ("original.png", "[[as_document]]\n", "send_document"),
+        ("voice.ogg", "[[audio_as_voice]]\n", "send_voice"),
+        ("clip.mp4", "", "send_video"),
+    ],
+)
+@pytest.mark.asyncio
+async def test_media_claim_identity_preserves_delivery_mode(
+    tmp_path, monkeypatch, name, directive, method
+):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, name)
+    adapter = _adapter()
+    runner = _runner()
+    claims = set()
+    response = f"{directive}MEDIA:{media_file}"
+    event = SimpleNamespace(source=_source())
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        runner,
+        response,
+        _source(),
+        adapter,
+        send_text=False,
+        media_claims=claims,
+        run_generation=11,
+    )
+    await GatewayRunner._deliver_media_from_response(
+        runner,
+        response,
+        event,
+        adapter,
+        media_claims=claims,
+        run_generation=11,
+    )
+
+    getattr(adapter, method).assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_final_delivers_attachment_not_seen_by_interim(tmp_path, monkeypatch):
+    first = _allowed_media_path(tmp_path, monkeypatch, "first.png")
+    second = _allowed_media_path(tmp_path, monkeypatch, "second.pdf")
+    adapter = _adapter()
+    runner = _runner()
+    claims = set()
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        runner,
+        f"Preview.\nMEDIA:{first}",
+        _source(),
+        adapter,
+        send_text=False,
+        media_claims=claims,
+        run_generation=13,
+    )
+    await GatewayRunner._deliver_media_from_response(
+        runner,
+        f"Final.\nMEDIA:{first}\nMEDIA:{second}",
+        SimpleNamespace(source=_source()),
+        adapter,
+        media_claims=claims,
+        run_generation=13,
+    )
+
+    adapter.send_multiple_images.assert_awaited_once()
+    adapter.send_document.assert_awaited_once()
+    assert adapter.send_document.await_args.kwargs["file_path"] == str(second)
+
+
+@pytest.mark.asyncio
+async def test_non_stream_interim_leaves_media_to_final_owner(tmp_path, monkeypatch):
+    media_file = _allowed_media_path(tmp_path, monkeypatch, "report.pdf")
+    adapter = _adapter()
+    runner = _runner()
+    claims = set()
+    response = f"Report ready.\nMEDIA:{media_file}"
+
+    await GatewayRunner._deliver_interim_assistant_response(
+        runner,
+        response,
+        _source(),
+        adapter,
+        deliver_media=False,
+        media_claims=claims,
+        run_generation=17,
+    )
+    await GatewayRunner._deliver_media_from_response(
+        runner,
+        response,
+        SimpleNamespace(source=_source()),
+        adapter,
+        media_claims=claims,
+        run_generation=17,
+    )
+
+    adapter.send.assert_awaited_once()
+    adapter.send_document.assert_awaited_once()
