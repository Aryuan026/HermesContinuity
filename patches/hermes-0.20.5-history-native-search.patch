@@ -2681,6 +2681,75 @@ class SessionHistoryMixin:
             finally:
                 conn.rollback()
 
+    def search_history_matches(self, domain_id, *, target, query, max_matches=64,
+                               deadline_ms=50):
+        """Native search locators, restricted to one verified canonical domain.
+
+        Reuse SessionSearchMixin's routing and query grammar. Unlike interactive
+        search, this foreground projection never asks FTS to construct snippets
+        or decode neighboring bodies, repair an index, or start a writer.
+        """
+        token = _normalize_prefix_token(target)
+        if token["domain_id"] != domain_id:
+            raise ValueError("history_search_domain_mismatch")
+        if (not isinstance(query, str) or not 1 <= len(query) <= 512
+                or type(max_matches) is not int or not 1 <= max_matches <= 128
+                or type(deadline_ms) is not int or not 1 <= deadline_ms <= 250):
+            raise ValueError("history_search_budget_invalid")
+        query = self._sanitize_fts5_query(query)
+        if not query:
+            return {"status": "ready", "matches": []}
+        self._refresh_fts_stale_state()
+        route = self._describe_search_path(query)
+        table = {"fts5": "messages_fts", "fts_cjk": "messages_fts_cjk",
+                 "trigram": "messages_fts_trigram"}.get(route)
+        if table and not self._fts_enabled:
+            return {"status": "unavailable", "reason": "native_search_unavailable", "matches": []}
+        if table:
+            if table != "messages_fts":
+                query = " ".join(part if part.upper() in {"AND", "OR", "NOT"}
+                                 else '"' + part.replace('"', '""') + '"'
+                                 for part in query.strip('"').split())
+            predicate, params = f"{table} MATCH ?", [query]
+            # The owner-copy plan otherwise rescans a whole domain for each
+            # FTS hit; BM25 also scores all matching compaction clones before
+            # LIMIT. Seek existing winners from bounded newest postings instead.
+            source = (f"{table} CROSS JOIN hermes_history_buckets b "
+                      f"INDEXED BY idx_hermes_history_buckets_winner ON b.winner_message_id={table}.rowid "
+                      "CROSS JOIN messages m ON m.id=b.winner_message_id")
+            order = f"{table}.rowid DESC"
+        else:
+            predicate, params, _ = self._compile_like_boolean_query(query)
+            if not predicate:
+                return {"status": "ready", "matches": []}
+            predicate = "(" + predicate + ")"
+            source = ("hermes_history_buckets b CROSS JOIN messages m "
+                      "ON m.id=b.winner_message_id")
+            order = "b.position DESC"
+        sql = (
+            "SELECT b.position FROM " + source +
+            " WHERE b.domain_id=? AND b.position<=? AND " + predicate +
+            " AND (m.active=1 OR m.compacted=1) AND m.role IN ('user','assistant') "
+            "ORDER BY " + order + " LIMIT ?"
+        )
+        deadline = time.monotonic() + deadline_ms / 1000
+        with self._read_ctx() as conn, self._history_value_limit(conn, 4*1024*1024):
+            conn.execute("SAVEPOINT history_search")
+            conn.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
+            try:
+                validation = self._history_validate_token_conn(conn, token)
+                if validation["status"] != "valid" or validation.get("invalidated_from_position"):
+                    return {"status": "pending", "reason": "history_source_changed", "matches": []}
+                matches = [int(row[0]) for row in conn.execute(
+                    sql, [domain_id, token["canonical_count"], *params, max_matches])]
+                return {"status": "ready", "matches": matches, "route": route}
+            except sqlite3.Error as error:
+                code = getattr(error, "sqlite_errorname", "SQLITE_ERROR").lower()
+                return {"status": "unavailable", "reason": "native_search_" + code, "matches": []}
+            finally:
+                conn.set_progress_handler(None, 0)
+                conn.execute("RELEASE history_search")
+
     def seal_history_prefix(
