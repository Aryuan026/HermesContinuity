diff --git a/tests/test_history_search.py b/tests/test_history_search.py
new file mode 100644
index 00000000..ccb55c49
--- /dev/null
+++ b/tests/test_history_search.py
@@ -0,0 +1,71 @@
+"""Native bounded ID search must not hydrate transcripts or mint source proof."""
+import pytest
+from contextlib import contextmanager
+
+from hermes_state import SessionDB
+
+
+def prepare(db, session):
+    for _ in range(2000):
+        result = db.prepare_history_step(session, owner_id="search-test", deadline_ms=50)
+        if result["status"] == "ready":
+            return result["head_token"]
+        assert result["status"] == "progress", result
+    raise AssertionError("preparation stalled")
+
+
+def test_native_id_search_preserves_scope_grammar_and_large_value_bound(tmp_path, monkeypatch):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("one", "cli")
+        db.create_session("other", "cli")
+        db.append_message("one", "user", "樱桃项目 cherry budget", timestamp=1)
+        db.append_message("one", "assistant", "12万元，未确认", timestamp=2)
+        db.append_message("one", "user", [{"type": "text", "text": "information-figure"},
+            {"type": "image_url", "image_url": {"url": "A"*(5*1024*1024)}}], timestamp=3)
+        db.append_message("other", "user", "cherry 樱桃项目", timestamp=1)
+        token = prepare(db, "one")
+        monkeypatch.setattr(db, "_decode_message_rows", lambda *a: pytest.fail("no body decoder"))
+        for query in ("cherry", "樱桃项目", "cherry OR unknown", "information-figure"):
+            result = db.search_history_matches("one", target=token, query=query)
+            assert result["status"] == "ready", result
+            assert result["matches"] == ([3] if query == "information-figure" else [1])
+            assert set(result) == {"status", "matches", "route"}
+        assert db.search_history_matches("one", target=token, query="cherry NOT budget")["matches"] == []
+        original_read, queries = db._read_ctx, []
+        @contextmanager
+        def traced():
+            with original_read() as connection:
+                connection.set_trace_callback(lambda sql: queries.append(sql) if sql.startswith("SELECT b.position") else None)
+                try:
+                    yield connection
+                finally:
+                    connection.set_trace_callback(None)
+        monkeypatch.setattr(db, "_read_ctx", traced)
+        assert db.search_history_matches("one", target=token, query="cherry")["matches"] == [1]
+        with original_read() as connection:
+            plan = [row[3] for row in connection.execute("EXPLAIN QUERY PLAN " + queries[-1])]
+        assert "messages_fts VIRTUAL TABLE" in plan[0], plan
+        assert any("idx_hermes_history_buckets_winner" in detail for detail in plan), plan
+        assert not any("TEMP B-TREE" in detail for detail in plan), plan
+        with pytest.raises(ValueError, match="domain"):
+            db.search_history_matches("other", target=token, query="cherry")
+        with pytest.raises(ValueError, match="budget"):
+            db.search_history_matches("one", target=token, query="x"*513)
+        db._execute_write(lambda connection: connection.execute(
+            "UPDATE messages SET content='changed' WHERE session_id='one' AND id=1"))
+        assert db.search_history_matches("one", target=token, query="cherry")["status"] == "pending"
+
+
+def test_search_deadline_or_sql_error_does_not_become_empty_success(tmp_path, monkeypatch):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("one", "cli")
+        db.append_message("one", "user", "cherry", timestamp=1)
+        token = prepare(db, "one")
+        db._execute_write(lambda connection: connection.execute("DROP TABLE messages_fts"))
+        monkeypatch.setattr(db, "_describe_search_path", lambda _: "fts5")
+        result = db.search_history_matches("one", target=token, query="cherry")
+        # A missing native index must not become an empty successful lookup.
+        assert result["status"] == "unavailable", result
+        # Cleanup resets the query controls even on an actual SQL failure.
+        with db._read_ctx() as connection:
+            assert connection.execute("SELECT 1").fetchone()[0] == 1
