+class TestCodexAuxiliaryFinishTruth:
+    @staticmethod
+    def _call(response):
+        class FakeResponses:
+            def create(self, **kwargs):
+                assert kwargs["stream"] is True
+                return response
+
+        client = SimpleNamespace(responses=FakeResponses())
+        adapter = _CodexCompletionsAdapter(client, "gpt-test")
+        return adapter.create(messages=[{"role": "user", "content": "summarize"}])
+
+    @staticmethod
+    def _message_response(status, *, text="partial", reason=None):
+        return SimpleNamespace(
+            status=status,
+            output=[SimpleNamespace(
+                type="message",
+                status="completed",
+                content=[SimpleNamespace(type="output_text", text=text)],
+            )],
+            output_text="",
+            incomplete_details=(
+                SimpleNamespace(reason=reason) if reason is not None else None
+            ),
+            error=None,
+            usage=None,
+        )
+
+    @pytest.mark.parametrize(
+        ("status", "reason", "expected"),
+        [
+            ("completed", None, "stop"),
+            ("incomplete", "max_output_tokens", "incomplete"),
+            ("provider_added_a_new_status", None, "unknown"),
+        ],
+    )
+    def test_text_status_uses_shared_responses_normalizer(
+        self, status, reason, expected
+    ):
+        result = self._call(self._message_response(status, reason=reason))
+        assert result.choices[0].message.content == "partial"
+        assert result.choices[0].finish_reason == expected
+
+    def test_content_filter_and_tool_call_remain_distinct(self):
+        filtered = SimpleNamespace(
+            status="incomplete",
+            output=[],
+            output_text="",
+            incomplete_details=SimpleNamespace(reason="content_filter"),
+            error=None,
+            usage=None,
+        )
+        assert self._call(filtered).choices[0].finish_reason == "content_filter"
+
+        tool = SimpleNamespace(
+            status="completed",
+            output=[SimpleNamespace(
+                type="function_call",
+                status="completed",
+                call_id="call_1",
+                id="fc_1",
+                name="lookup",
+                arguments='{"q":"x"}',
+            )],
+            output_text="",
+            incomplete_details=None,
+            error=None,
+            usage=None,
+        )
+        assert self._call(tool).choices[0].finish_reason == "tool_calls"
+
+    @pytest.mark.parametrize("status", ["failed", "cancelled"])
+    def test_terminal_failure_raises_instead_of_synthesizing_stop(self, status):
+        response = self._message_response(status)
+        response.error = {"code": status, "message": "terminal failure"}
+        with pytest.raises(RuntimeError, match="terminal failure"):
+            self._call(response)
+
+    @pytest.mark.parametrize(
+        ("status", "expected"),
+        [
+            ("completed", "stop"),
+            ("incomplete", "incomplete"),
+            ("provider_added_a_new_status", "unknown"),
+        ],
+    )
+    def test_generic_responses_recovery_uses_same_finish_truth(self, status, expected):
+        from agent.auxiliary_client import _recover_aux_response_message
+
+        response = self._message_response(status)
+        recovered = _recover_aux_response_message(response)
+        assert recovered.choices[0].finish_reason == expected
+
+    def test_generic_text_recovery_without_status_keeps_reason_unknown(self):
+        from agent.auxiliary_client import _recover_aux_response_message
+
+        recovered = _recover_aux_response_message(
+            SimpleNamespace(output_text="partial")
+        )
+        assert recovered.choices[0].finish_reason is None
+
+
