-        normalize_message_origin_proof(existing)
+        if normalize_message_origin_proof(existing) != normalized:
+            raise ValueError("message origin proof conflicts with existing row")
         return
     message["_origin_proof"] = normalized
 
 
+def busy_input_origin_matches(
+    agent: Any, incoming_proof: Optional[Mapping[str, Any]]
+) -> bool:
+    """Whether busy input may mutate the agent's current durable turn.
+
+    Unknown, invalid, and cross-writer inputs must cross a turn boundary.  The
+    ingress surface keeps ownership of queueing or rejecting the new turn; this
+    helper only answers whether ``steer``/``redirect`` is provenance-safe.
+    """
+    running_proof = getattr(agent, "_current_message_origin_proof", None)
+    if running_proof is None or incoming_proof is None:
+        return False
+    try:
+        return normalize_message_origin_proof(
+            running_proof
+        ) == normalize_message_origin_proof(incoming_proof)
+    except ValueError:
+        return False
+
+
 def stamp_turn_message_origins(
     messages: Sequence[Any],
     start_index: Any,
