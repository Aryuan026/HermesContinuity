+def test_busy_input_may_only_mutate_the_same_verified_writer():
+    human = build_message_origin_proof(CLI_USER)
+    scheduled = build_message_origin_proof(CRON_BOT_CHAT)
+
+    class Agent:
+        _current_message_origin_proof = human
+
+    assert busy_input_origin_matches(Agent(), human) is True
+    assert busy_input_origin_matches(Agent(), scheduled) is False
+    assert busy_input_origin_matches(
+        Agent(), build_message_origin_proof(ROOM_DISPATCH)
+    ) is False
+    assert busy_input_origin_matches(Agent(), None) is False
+    Agent._current_message_origin_proof = None
+    assert busy_input_origin_matches(Agent(), human) is False
+
