+def test_stamping_is_idempotent_but_rejects_cross_origin_relabeling():
+    human = build_message_origin_proof(CLI_USER)
+    scheduled = build_message_origin_proof(CRON_BOT_CHAT)
+    message = {"role": "user", "content": "visible"}
+
+    stamp_message_origin(message, human)
