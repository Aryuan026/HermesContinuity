+def test_two_origins_remain_two_verified_groups_after_compaction_and_restart(
+    tmp_path,
+):
+    path = tmp_path / "state.db"
+    store = SessionDB(path)
+    store.create_session("mixed", source="qq")
+    human = build_message_origin_proof(CLI_USER)
+    scheduled = build_message_origin_proof(CRON_BOT_CHAT)
+    for index, (proof, label) in enumerate(
+        ((scheduled, "wake"), (human, "human"))
+    ):
+        store.append_message(
+            "mixed", "user", label, timestamp=index * 2, origin_proof=proof
+        )
+        store.append_message(
+            "mixed",
+            "assistant",
+            f"{label}-answer",
+            timestamp=index * 2 + 1,
+            origin_proof=proof,
+        )
+    store.archive_and_compact(
+        "mixed", store.get_messages("mixed"), tail_count=2
+    )
+    store.close()
+
+    reopened = SessionDB(path, read_only=True)
+    try:
+        rows = reopened.get_messages_time_window(
+            "mixed",
+            start_timestamp=0,
+            end_timestamp=4,
+            include_compacted=True,
+            max_physical_rows=8,
+        )["messages"]
+    finally:
+        reopened.close()
+
+    groups = [rows[index : index + 2] for index in range(0, len(rows), 2)]
+    assert [classify_message_origin_group(group) for group in groups] == [
+        (SCHEDULED, "verified"),
+        (HUMAN, "verified"),
+    ]
+
+
