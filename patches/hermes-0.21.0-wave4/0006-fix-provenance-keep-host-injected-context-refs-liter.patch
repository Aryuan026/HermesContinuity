+def test_host_enveloped_at_references_stay_literal_with_their_origin():
+    cli = _make_cli()
+    cli_globals = cli.__class__.chat.__globals__
+    agent = _CaptureStagingAgent(cli.session_id)
+    cli.agent = agent
+    cli._interrupt_queue = queue.Queue()
+    cases = [
+        QueuedInput("@file:sentinel.txt", None),
+        QueuedInput("@diff", None),
+        QueuedInput(
+            "@url:https://example.invalid",
+            build_message_origin_proof(CRON_AGENT),
+        ),
+        QueuedInput(
+            "@custom:item",
+            build_message_origin_proof(SUBAGENT),
+        ),
+    ]
+    preprocessor = MagicMock()
+
+    with patch.object(cli, "_ensure_runtime_credentials", return_value=True), \
+         patch.object(cli, "_resolve_turn_agent_config", return_value={
+             "signature": cli._active_agent_route_signature,
+             "model": None, "runtime": None, "request_overrides": None,
+         }), \
+         patch.object(cli, "_init_agent", return_value=True), \
+         patch(
+             "agent.context_references.preprocess_context_references",
+             preprocessor,
+         ):
+        for entry in cases:
+            payload, origin, producer_enveloped = (
+                cli_globals["_unwrap_cli_queue_entry"](entry)
+            )
+            cli.chat(
+                payload,
+                message_origin_proof=origin,
+                allow_cli_content_expansion=not producer_enveloped,
+            )
+            cli.conversation_history = []
+
+    preprocessor.assert_not_called()
+    assert [message["content"] for message in agent.staged] == [
+        entry.payload for entry in cases
+    ]
+    for message in agent.staged[:2]:
+        assert MESSAGE_ORIGIN_DECLARED_FIELD in message
+        assert "_origin_proof" not in message
+    assert agent.staged[2]["_origin_proof"] == build_message_origin_proof(
+        CRON_AGENT
+    )
+    assert agent.staged[3]["_origin_proof"] == build_message_origin_proof(
+        SUBAGENT
+    )
+
+
+def test_process_loop_carries_queue_literal_capability_into_chat():
+    cli = _make_cli()
+    cli._pending_input = queue.Queue()
+    cli._pending_input.put(QueuedInput("@file:sentinel.txt", None))
+
+    entry = cli._pending_input.get_nowait()
+    payload, origin, producer_enveloped = (
+        cli.__class__.chat.__globals__["_unwrap_cli_queue_entry"](entry)
+    )
+    with patch.object(cli, "chat") as chat:
+        cli._dispatch_process_loop_chat(
+            payload,
+            images=None,
+            voice_input=False,
+            message_origin_proof=origin,
+            producer_enveloped=producer_enveloped,
+        )
+
+    chat.assert_called_once_with(
+        "@file:sentinel.txt",
+        images=None,
+        voice_input=False,
+        allow_cli_content_expansion=False,
+        message_origin_proof=None,
+    )
+    assert "self._dispatch_process_loop_chat(" in inspect.getsource(cli.run)
+
+
