     assert result == "[expanded body]"
 
 
+@pytest.mark.asyncio
+async def test_non_control_plugin_event_keeps_at_reference_literal(monkeypatch):
+    runner = _make_runner()
+    source = _source()
+    _patch_runtime_resolution(monkeypatch)
+    calls = []
+
+    async def _unexpected_preprocess(*args, **kwargs):
+        calls.append((args, kwargs))
+        raise AssertionError("non-control plugin text must not expand @ references")
+
+    import agent.context_references as ctx_mod
+
+    monkeypatch.setattr(
+        ctx_mod,
+        "preprocess_context_references_async",
+        _unexpected_preprocess,
+    )
+    message = "@file:sentinel.txt @diff @url:https://example.invalid @custom:item"
+    event = MessageEvent(
+        text=message,
+        source=source,
+        internal=True,
+        allow_gateway_control=False,
+        metadata={"hermes_plugin_injection": True},
+    )
+
+    result = await runner._prepare_inbound_message_text(
+        event=event,
+        source=source,
+        history=[],
+    )
+
+    assert calls == []
+    assert result == message
+
+
 @pytest.mark.asyncio
 async def test_at_reference_ignores_global_context_for_runtime_route_override(monkeypatch):
     """Context expansion must not inherit a global pin from another route."""
