@@ -4,10 +4,12 @@ from __future__ import annotations
 
 import os
 from collections.abc import Mapping, MutableMapping, Sequence
+from dataclasses import dataclass
 from typing import Any, Optional
 
 
 MESSAGE_ORIGIN_SCHEMA = "hermes.message_origin.v1"
+MESSAGE_ORIGIN_DECLARED_FIELD = "_origin_proof_declared"
 INTERNAL_ORIGIN_HEADER = "X-Hermes-Internal-Origin"
 CLI_ORIGIN_ENV = "HERMES_INTERNAL_MESSAGE_ORIGIN"
 CRON_BOT_CHAT_CLAIM = "cron.bot_chat"
@@ -111,6 +113,27 @@ def normalize_message_origin_proof(value: Any) -> dict[str, str]:
     return {"schema": schema, "kind": kind, "writer": writer}
 
 
+@dataclass(frozen=True)
+class QueuedInput:
+    """CLI queue payload whose producer origin has been decided by the host.
+
+    ``origin_proof=None`` is meaningful: the producer is explicitly
+    unclassified and must not inherit ``cli.user`` merely because the CLI
+    transports the payload to the next turn.
+    """
+
+    payload: Any
+    origin_proof: Optional[dict[str, str]]
+
+    def __post_init__(self) -> None:
+        if self.origin_proof is not None:
+            object.__setattr__(
+                self,
+                "origin_proof",
+                normalize_message_origin_proof(self.origin_proof),
+            )
+
+
 def message_origin_for_platform(platform: Any) -> Optional[dict[str, str]]:
     """Return the default proof for this live execution surface.
 
@@ -182,6 +205,14 @@ def stamp_message_origin(
     message["_origin_proof"] = normalized
 
 
+def declare_message_origin(
+    message: MutableMapping[str, Any], proof: Optional[Mapping[str, Any]]
+) -> None:
+    """Record that the host classified this message, including as unknown."""
+    message[MESSAGE_ORIGIN_DECLARED_FIELD] = True
+    stamp_message_origin(message, proof)
+
+
 def busy_input_origin_matches(
     agent: Any, incoming_proof: Optional[Mapping[str, Any]]
 ) -> bool:
