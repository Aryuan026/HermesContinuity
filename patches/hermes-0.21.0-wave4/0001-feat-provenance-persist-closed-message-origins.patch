+@pytest.mark.asyncio
+async def test_api_wake_crosses_real_loopback_handler_with_scheduled_proof(tmp_path):
+    from aiohttp import web
+    from hermes_state import SessionDB
+
+    adapter = _adapter()
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("wake-real", source="api_server")
+    adapter._session_db = db
+    adapter._run_agent = AsyncMock(
+        return_value=({"final_response": "done", "session_id": "wake-real"}, {})
+    )
+    app = web.Application()
+    app.router.add_post("/v1/chat/completions", adapter._handle_chat_completions)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    adapter._port = site._server.sockets[0].getsockname()[1]
+    try:
+        await deliver_wake(adapter, text="real wake", session_id="wake-real")
+        assert adapter._run_agent.await_args.kwargs[
+            "message_origin_proof"
+        ] == build_message_origin_proof(GATEWAY_WAKEUP)
+    finally:
+        await runner.cleanup()
+        adapter._response_store.close()
+        db.close()
+
