new file mode 100644
index 0000000..11f15ac
--- /dev/null
+++ b/tests/agent/test_message_origin.py
@@ -0,0 +1,207 @@
+"""Closed H13 message-origin contracts and canonical group behavior."""
+
+from __future__ import annotations
+
+from agent.message_origin import (
+    API_USER,
+    CLI_ORIGIN_ENV,
+    CLI_USER,
+    CRON_AGENT,
+    CRON_BOT_CHAT,
+    CRON_BOT_CHAT_CLAIM,
+    DELEGATED,
+    GATEWAY_USER,
+    HUMAN,
+    INTERNAL,
+    MESSAGE_ORIGIN_SCHEMA,
+    PEER_DM,
+    ROOM_DISPATCH,
+    SCHEDULED,
+    build_message_origin_proof,
+    classify_message_origin_group,
+    message_origin_for_platform,
+    normalize_message_origin_proof,
+    stamp_turn_message_origins,
+    take_cli_message_origin_proof,
+)
+from hermes_state import SessionDB
+
+
+def _row(role: str, proof, content: str = "visible"):
+    return {"role": role, "content": content, "origin_proof": proof}
+
+
+def test_proof_shape_is_closed_and_writer_owns_kind():
+    proof = build_message_origin_proof(CLI_USER)
+    assert proof == {
+        "schema": MESSAGE_ORIGIN_SCHEMA,
+        "kind": HUMAN,
+        "writer": CLI_USER,
+    }
+    assert normalize_message_origin_proof(proof) == proof
+
+    for invalid in (
+        {**proof, "extra": True},
+        {**proof, "kind": SCHEDULED},
+        {**proof, "writer": "plugin.claim"},
+        {"schema": MESSAGE_ORIGIN_SCHEMA},
+    ):
+        try:
+            normalize_message_origin_proof(invalid)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"accepted invalid origin proof: {invalid!r}")
+
+
+def test_execution_surfaces_map_without_using_session_labels():
+    for platform in (
+        "qq",
+        "wechat",
+        "browser",
+        "hermes_browser",
+        "desktop",
+        "dashboard",
+    ):
+        assert message_origin_for_platform(platform) == build_message_origin_proof(
+            GATEWAY_USER
+        )
+    assert message_origin_for_platform("api_server") == build_message_origin_proof(
+        API_USER
+    )
+    assert message_origin_for_platform("cron") == build_message_origin_proof(
+        CRON_AGENT
+    )
+    for unproved in ("webhook", "homeassistant", "relay", "plugin_name", ""):
+        assert message_origin_for_platform(unproved) is None
+
+
+def test_cron_bot_chat_claim_is_one_shot_and_closed():
+    env = {CLI_ORIGIN_ENV: CRON_BOT_CHAT_CLAIM}
+    assert take_cli_message_origin_proof(env) == build_message_origin_proof(
+        CRON_BOT_CHAT
+    )
+    assert CLI_ORIGIN_ENV not in env
+    assert take_cli_message_origin_proof(env) is None
+
+    bad = {CLI_ORIGIN_ENV: "scheduled job, not the user"}
+    try:
+        take_cli_message_origin_proof(bad)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("visible text was accepted as a host claim")
+    assert CLI_ORIGIN_ENV not in bad
+
+
+def test_turn_stamping_covers_live_rows_but_not_synthetic_summary_shell():
+    proof = build_message_origin_proof(CRON_AGENT)
+    messages = [
