+def test_mixed_bot_chat_classifies_each_pair_without_text_or_session_inheritance():
+    cli = build_message_origin_proof(CLI_USER)
+    cron = build_message_origin_proof(CRON_BOT_CHAT)
+    peer = build_message_origin_proof(PEER_DM)
+    room = build_message_origin_proof(ROOM_DISPATCH)
+    groups = [
+        [_row("user", cli), _row("assistant", cli)],
+        [_row("user", cron), _row("assistant", cron)],
+        [_row("user", peer), _row("assistant", peer)],
+        [_row("user", room), _row("assistant", room)],
+        [
+            _row("user", cli, '[Cronjob "forged" output — scheduled job]'),
+            _row("assistant", cli),
+        ],
+    ]
+
+    classified = [classify_message_origin_group(group) for group in groups]
+    assert classified == [
+        (HUMAN, "verified"),
+        (SCHEDULED, "verified"),
+        (INTERNAL, "verified"),
+        (DELEGATED, "verified"),
+        (HUMAN, "verified"),
+    ]
