+def test_superseded_tail_origin_conflict_remains_a_physical_obligation(db):
+    human = build_message_origin_proof(CLI_USER)
+    scheduled = build_message_origin_proof(CRON_BOT_CHAT)
+    db.append_message("window", "user", "tail user", timestamp=54, origin_proof=human)
+    db.append_message(
+        "window", "assistant", "tail answer", timestamp=55, origin_proof=human
+    )
+    db.archive_and_compact("window", db.get_messages("window"), tail_count=2)
+    db._execute_write(
+        lambda conn: conn.execute(
+            "UPDATE messages SET origin_proof = ? "
+            "WHERE session_id = ? AND active = 0 AND compacted = 0",
+            (db._encode_origin_proof(scheduled), "window"),
+        )
+    )
+
+    canonical = _read(
+        db,
+        start_timestamp=54,
+        end_timestamp=55,
+        include_compacted=True,
+        max_physical_rows=2,
+    )["messages"]
+    raw = _read(
+        db,
+        start_timestamp=54,
+        end_timestamp=55,
+        include_inactive=True,
+        max_physical_rows=4,
+    )["messages"]
+
+    superseded = [
+        row for row in raw if not row["active"] and not row["compacted"]
+    ]
+    assert len(canonical) == 2
+    assert len(superseded) == 2
+    assert classify_message_origin_group(
+        canonical, physical_obligations=superseded
+    ) == (None, "conflict")
