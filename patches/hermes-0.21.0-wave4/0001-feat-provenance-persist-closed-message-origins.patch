             status=401,
         )
 
+    @staticmethod
+    def _request_peer_is_loopback(request: "web.Request") -> bool:
+        """Check the real socket peer, never proxy forwarding headers."""
+        peer_ip = ""
+        try:
+            peer = (
+                request.transport.get_extra_info("peername")
+                if request.transport
+                else None
+            )
+            if isinstance(peer, (tuple, list)) and peer:
+                peer_ip = str(peer[0])
+        except Exception:
+            peer_ip = ""
+        if not peer_ip:
+            peer_ip = str(getattr(request, "remote", "") or "")
+        try:
+            address = ipaddress.ip_address(peer_ip.split("%", 1)[0])
+            if isinstance(address, ipaddress.IPv6Address) and address.ipv4_mapped:
+                address = address.ipv4_mapped
+            return address.is_loopback
+        except ValueError:
+            return False
+
+    def _verify_internal_wakeup_request(
+        self, request: "web.Request"
+    ) -> tuple[Optional[dict[str, str]], Optional["web.Response"]]:
+        """Authenticate the API server's private loopback wake self-post."""
+        claimed = request.headers.get(INTERNAL_WAKE_HEADER, "")
+        if not claimed:
+            return None, None
+        valid = self._request_peer_is_loopback(request) and hmac.compare_digest(
+            claimed.encode(), self._internal_wakeup_token.encode()
+        )
+        if valid:
+            from agent.message_origin import (
+                GATEWAY_WAKEUP,
+                build_message_origin_proof,
+            )
+
+            return build_message_origin_proof(GATEWAY_WAKEUP), None
+        logger.warning(
+            "API server rejected invalid internal wakeup claim: %s",
+            self._request_audit_log_suffix(request),
+        )
+        return None, web.json_response(
+            _openai_error(
+                "Invalid internal wakeup provenance",
+                err_type="gateway_auth_error",
+                code="invalid_internal_wakeup_provenance",
+            ),
+            status=403,
+        )
+
+    def _verify_peer_origin_request(
+        self, request: "web.Request", *, expected_claim: str
+    ) -> tuple[Optional[dict[str, str]], Optional["web.Response"]]:
+        """Accept a per-request peer claim only with the profile API key."""
+        from agent.message_origin import (
+            INTERNAL_ORIGIN_HEADER,
+            PEER_DM,
+            PEER_DM_CLAIM,
+            PEER_RUN,
+            PEER_RUN_CLAIM,
+            build_message_origin_proof,
+        )
+
+        claim = request.headers.get(INTERNAL_ORIGIN_HEADER, "").strip()
+        if not claim:
+            return None, None
+        writers = {
+            PEER_DM_CLAIM: PEER_DM,
+            PEER_RUN_CLAIM: PEER_RUN,
+        }
+        if (
+            claim != expected_claim
+            or not self._expected_api_key()
+            or self._check_auth(request) is not None
+        ):
+            logger.warning(
+                "API server rejected invalid peer-origin claim: %s",
+                self._request_audit_log_suffix(request),
+            )
+            return None, web.json_response(
+                _openai_error(
+                    "Invalid peer message provenance",
+                    err_type="gateway_auth_error",
+                    code="invalid_peer_message_provenance",
+                ),
+                status=403,
+            )
+        return build_message_origin_proof(writers[claim]), None
+
