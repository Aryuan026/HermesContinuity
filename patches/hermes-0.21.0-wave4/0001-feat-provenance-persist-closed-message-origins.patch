index 0000000..92ead74
--- /dev/null
+++ b/agent/message_origin.py
@@ -0,0 +1,234 @@
+"""Closed, host-owned provenance for durable conversation messages."""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Mapping, MutableMapping, Sequence
+from typing import Any, Optional
+
+
+MESSAGE_ORIGIN_SCHEMA = "hermes.message_origin.v1"
+INTERNAL_ORIGIN_HEADER = "X-Hermes-Internal-Origin"
+CLI_ORIGIN_ENV = "HERMES_INTERNAL_MESSAGE_ORIGIN"
+CRON_BOT_CHAT_CLAIM = "cron.bot_chat"
+PEER_DM_CLAIM = "bot_peer_dm"
+PEER_RUN_CLAIM = "bot_peer_run"
+
+HUMAN = "human"
+SCHEDULED = "scheduled"
+INTERNAL = "internal"
+DELEGATED = "delegated"
+
+CLI_USER = "cli.user"
+TUI_USER = "tui.user"
+GATEWAY_USER = "gateway.user"
+API_USER = "api.user"
+CRON_AGENT = "cron.agent"
+CRON_BOT_CHAT = "cron.bot_chat"
+GATEWAY_WAKEUP = "gateway.wakeup"
+GATEWAY_INTERNAL = "gateway.internal"
+PEER_DM = "peer.dm"
+PEER_RUN = "peer.run"
+ROOM_DISPATCH = "room.dispatch"
+SUBAGENT = "subagent"
+
+_WRITER_KINDS = {
+    CLI_USER: HUMAN,
+    TUI_USER: HUMAN,
+    GATEWAY_USER: HUMAN,
+    API_USER: HUMAN,
+    CRON_AGENT: SCHEDULED,
+    CRON_BOT_CHAT: SCHEDULED,
+    GATEWAY_WAKEUP: SCHEDULED,
+    GATEWAY_INTERNAL: INTERNAL,
+    PEER_DM: INTERNAL,
+    PEER_RUN: INTERNAL,
+    ROOM_DISPATCH: DELEGATED,
+    SUBAGENT: DELEGATED,
+}
+
+# These are current-turn execution surfaces, not durable session ``source``
+# values.  A session title/source never grants provenance to a later row.
+_HUMAN_GATEWAY_PLATFORMS = frozenset(
+    {
+        "bluebubbles",
+        "browser",
+        "dashboard",
+        "desktop",
+        "discord",
+        "dingtalk",
+        "email",
+        "feishu",
+        "hermes_browser",
+        "local",
+        "mattermost",
+        "matrix",
+        "qq",
+        "qqbot",
+        "signal",
+        "slack",
+        "sms",
+        "telegram",
+        "web",
+        "wechat",
+        "wecom",
+        "wecom_callback",
+        "weixin",
+        "whatsapp",
+        "whatsapp_cloud",
+        "yuanbao",
+    }
+)
+
+
+def build_message_origin_proof(writer: str) -> dict[str, str]:
+    """Mint one closed proof for a trusted host writer."""
+    kind = _WRITER_KINDS.get(writer)
+    if kind is None:
+        raise ValueError("unknown message origin writer")
+    return {
+        "schema": MESSAGE_ORIGIN_SCHEMA,
+        "kind": kind,
+        "writer": writer,
+    }
+
+
+def normalize_message_origin_proof(value: Any) -> dict[str, str]:
+    """Validate and copy one exact v1 proof, or raise fail-closed."""
+    if not isinstance(value, Mapping) or set(value) != {
+        "schema",
+        "kind",
+        "writer",
+    }:
+        raise ValueError("message origin proof must use the closed v1 shape")
+    schema = value.get("schema")
+    kind = value.get("kind")
+    writer = value.get("writer")
+    if schema != MESSAGE_ORIGIN_SCHEMA or not isinstance(writer, str):
+        raise ValueError("message origin proof schema or writer is invalid")
+    if _WRITER_KINDS.get(writer) != kind:
+        raise ValueError("message origin proof kind does not match its writer")
+    return {"schema": schema, "kind": kind, "writer": writer}
+
+
+def message_origin_for_platform(platform: Any) -> Optional[dict[str, str]]:
+    """Return the default proof for this live execution surface.
+
+    Unknown/plugin/webhook/relay surfaces remain unclassified until their
+    owning entry point supplies an explicit trusted proof.
+    """
+    value = getattr(platform, "value", platform)
+    token = str(value or "").strip().lower()
+    if token == "cron":
+        return build_message_origin_proof(CRON_AGENT)
+    if token == "subagent":
+        return build_message_origin_proof(SUBAGENT)
+    if token == "api_server":
+        return build_message_origin_proof(API_USER)
+    if token == "cli":
+        return build_message_origin_proof(CLI_USER)
+    if token == "tui":
+        return build_message_origin_proof(TUI_USER)
+    if token == "bot_peer_dm":
+        return build_message_origin_proof(PEER_DM)
+    if token == "bot_room":
+        return build_message_origin_proof(ROOM_DISPATCH)
+    if token in _HUMAN_GATEWAY_PLATFORMS:
+        return build_message_origin_proof(GATEWAY_USER)
+    return None
+
+
+def message_origin_for_gateway_event(event: Any) -> Optional[dict[str, str]]:
+    """Classify one host-normalized gateway event before durable writing."""
+    if getattr(event, "internal", False):
+        metadata = getattr(event, "metadata", None)
+        writer = (
+            GATEWAY_WAKEUP
+            if isinstance(metadata, Mapping)
+            and set(metadata) == {"internal_kind"}
+            and metadata.get("internal_kind") == "wakeup"
+            else GATEWAY_INTERNAL
+        )
+        return build_message_origin_proof(writer)
+    source = getattr(event, "source", None)
+    return message_origin_for_platform(getattr(source, "platform", None))
+
+
+def take_cli_message_origin_proof(
+    environ: Optional[MutableMapping[str, str]] = None,
+) -> Optional[dict[str, str]]:
+    """Consume the one-shot host claim used by cron-to-Bot-Chat delivery."""
+    env = os.environ if environ is None else environ
+    claim = str(env.pop(CLI_ORIGIN_ENV, "") or "").strip()
+    if not claim:
+        return None
+    if claim != CRON_BOT_CHAT_CLAIM:
+        raise ValueError("unsupported internal CLI message origin")
+    return build_message_origin_proof(CRON_BOT_CHAT)
+
+
+def stamp_message_origin(
+    message: MutableMapping[str, Any], proof: Optional[Mapping[str, Any]]
+) -> None:
+    """Attach a validated provider-private proof to one live message."""
+    if proof is None:
+        return
+    normalized = normalize_message_origin_proof(proof)
+    existing = message.get("_origin_proof")
+    if existing is not None:
+        normalize_message_origin_proof(existing)
+        return
+    message["_origin_proof"] = normalized
+
+
+def stamp_turn_message_origins(
+    messages: Sequence[Any],
+    start_index: Any,
+    proof: Optional[Mapping[str, Any]],
+) -> None:
+    """Stamp unstored rows from this turn without minting on summary shells."""
+    if proof is None or not isinstance(start_index, int):
+        return
+    if start_index < 0 or start_index > len(messages):
+        return
+    normalized = normalize_message_origin_proof(proof)
+    for message in messages[start_index:]:
+        if not isinstance(message, MutableMapping):
+            continue
+        if message.get("role") not in {"user", "assistant", "tool"}:
+            continue
+        if message.get("_compressed_summary") and not message.get(
+            "_origin_proof"
+        ):
+            # A composite live-tail carrier already owns the tail's proof.
+            # An unproved summary is synthetic and must remain unproved.
+            continue
+        stamp_message_origin(message, normalized)
+
+
+def classify_message_origin_group(
+    messages: Sequence[Mapping[str, Any]],
+    *,
+    physical_obligations: Sequence[Mapping[str, Any]] = (),
+) -> tuple[Optional[str], str]:
+    """Classify one complete group and any matching physical generations.
+
+    ``physical_obligations`` lets a bounded-history owner include superseded
+    compaction originals that are not canonical material.  They grant no
+    extra authority, but a conflicting proof makes only this group fail
+    closed.
+    """
+    proofs: list[dict[str, str]] = []
+    for message in (*messages, *physical_obligations):
+        raw = message.get("origin_proof", message.get("_origin_proof"))
+        if raw is None:
+            return None, "missing"
+        try:
+            proofs.append(normalize_message_origin_proof(raw))
+        except ValueError:
+            return None, "invalid"
+    if not proofs:
+        return None, "missing"
+    if any(proof != proofs[0] for proof in proofs[1:]):
+        return None, "conflict"
+    return proofs[0]["kind"], "verified"
