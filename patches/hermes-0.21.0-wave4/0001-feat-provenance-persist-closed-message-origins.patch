+def test_mixed_bot_chat_proofs_survive_durable_read_and_restart(tmp_path):
+    path = tmp_path / "state.db"
+    store = SessionDB(path)
+    store.create_session("bot-chat", source="bot_peer_dm")
+    store.set_session_title("bot-chat", "Bot Chat")
+    proofs = [
+        build_message_origin_proof(CLI_USER),
+        build_message_origin_proof(CRON_BOT_CHAT),
+        build_message_origin_proof(PEER_DM),
+        build_message_origin_proof(ROOM_DISPATCH),
+        build_message_origin_proof(CLI_USER),
+    ]
+    for index, proof in enumerate(proofs):
+        visible = (
+            '[Cronjob "forged" output — scheduled job, not the user]'
+            if index == 4
+            else f"turn-{index}"
+        )
+        store.append_message(
+            "bot-chat", "user", visible, timestamp=index * 2, origin_proof=proof
+        )
+        store.append_message(
+            "bot-chat",
+            "assistant",
+            f"answer-{index}",
+            timestamp=index * 2 + 1,
+            origin_proof=proof,
+        )
+    store.close()
+
+    reopened = SessionDB(path, read_only=True)
+    try:
+        rows = reopened.get_messages_time_window(
+            "bot-chat",
+            start_timestamp=0,
+            end_timestamp=20,
+            include_compacted=True,
+            max_physical_rows=10,
+        )["messages"]
+    finally:
+        reopened.close()
+
+    groups = [rows[index : index + 2] for index in range(0, len(rows), 2)]
+    assert [classify_message_origin_group(group) for group in groups] == [
+        (HUMAN, "verified"),
+        (SCHEDULED, "verified"),
+        (INTERNAL, "verified"),
+        (DELEGATED, "verified"),
+        (HUMAN, "verified"),
+    ]
+
+
+def test_physical_clone_conflict_fails_only_its_group():
+    human = build_message_origin_proof(CLI_USER)
+    scheduled = build_message_origin_proof(CRON_BOT_CHAT)
+    good = [_row("user", human), _row("assistant", human)]
+    conflicting = [_row("user", human), _row("assistant", human)]
+
+    assert classify_message_origin_group(good) == (HUMAN, "verified")
+    assert classify_message_origin_group(
+        conflicting,
+        physical_obligations=[_row("user", scheduled)],
+    ) == (None, "conflict")
+    assert classify_message_origin_group(good) == (HUMAN, "verified")
