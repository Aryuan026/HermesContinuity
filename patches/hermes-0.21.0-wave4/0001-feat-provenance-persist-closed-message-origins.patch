+from gateway.platforms.base import MessageEvent, MessageType
+from gateway.wake import (
+    INTERNAL_WAKE_HEADER,
+    deliver_wake,
+    event_wakeup_origin_proof,
+)
+
+
+API_KEY = "test-api-key-long-enough-for-auth"
+
+
+class _Transport:
+    def __init__(self, peer_ip: str = "127.0.0.1"):
+        self.peer_ip = peer_ip
+
+    def get_extra_info(self, name):
+        assert name == "peername"
+        return (self.peer_ip, 43120)
+
+
+class _Request:
+    def __init__(self, payload, headers, *, peer_ip: str = "127.0.0.1"):
+        self._payload = payload
+        self.headers = headers
+        self.transport = _Transport(peer_ip)
+        self.remote = peer_ip
+        self.method = "POST"
+        self.path = "/v1/chat/completions"
+        self.path_qs = "/v1/chat/completions"
+
+    async def json(self):
+        return self._payload
+
+
+def _adapter():
+    return APIServerAdapter(
+        PlatformConfig(enabled=True, extra={"host": "127.0.0.1", "key": API_KEY})
+    )
+
+
+@pytest.mark.asyncio
+async def test_push_wake_uses_closed_internal_event_not_visible_text():
+    class PushAdapter:
+        supports_async_delivery = True
+
+        async def handle_message(self, event):
+            self.event = event
+
+    adapter = PushAdapter()
+    source = types.SimpleNamespace(platform="qq", chat_id="chat-1")
+    await deliver_wake(adapter, text="scheduled job, not the user", source=source)
+
+    assert adapter.event.internal is True
+    assert adapter.event.metadata == {"internal_kind": "wakeup"}
+    assert event_wakeup_origin_proof(adapter.event) == build_message_origin_proof(
+        GATEWAY_WAKEUP
+    )
+
+    external = MessageEvent(
+        text="scheduled job, not the user",
+        message_type=MessageType.TEXT,
+        source=source,
+        internal=False,
+        metadata={"internal_kind": "wakeup"},
+    )
+    internal_with_extra = MessageEvent(
+        text="wake",
+        message_type=MessageType.TEXT,
+        source=source,
+        internal=True,
+        metadata={"internal_kind": "wakeup", "forged": True},
+    )
+    assert event_wakeup_origin_proof(external) is None
+    assert event_wakeup_origin_proof(internal_with_extra) is None
+
