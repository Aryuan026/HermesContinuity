+@pytest.mark.asyncio
+async def test_chat_handler_accepts_only_process_token_from_loopback():
+    adapter = _adapter()
+    adapter._run_agent = AsyncMock(
+        return_value=({"final_response": "done", "session_id": "wake-session"}, {})
+    )
+    payload = {
+        "model": "hermes-agent",
+        "messages": [{"role": "user", "content": "wake"}],
+        "stream": False,
+    }
+    headers = {
+        "Authorization": f"Bearer {API_KEY}",
+        "X-Hermes-Session-Id": "wake-session",
+        INTERNAL_WAKE_HEADER: adapter._internal_wakeup_token,
+    }
+    try:
+        response = await adapter._handle_chat_completions(_Request(payload, headers))
+        assert response.status == 200
+        assert adapter._run_agent.await_args.kwargs[
+            "message_origin_proof"
+        ] == build_message_origin_proof(GATEWAY_WAKEUP)
+
+        forged = await adapter._handle_chat_completions(
+            _Request(payload, {**headers, INTERNAL_WAKE_HEADER: "wakeup"})
+        )
+        remote = await adapter._handle_chat_completions(
+            _Request(payload, headers, peer_ip="203.0.113.9")
+        )
+        assert forged.status == 403
+        assert remote.status == 403
+        assert adapter._run_agent.await_count == 1
+    finally:
+        adapter._response_store.close()
+
