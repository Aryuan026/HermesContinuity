+            "final_response": "done",
+            "messages": [{"role": "assistant", "content": "done"}],
+            "api_calls": 1,
+            "completed": True,
+            "partial": True,
+            "response_previewed": True,
+        }
+
+
 def test_unacknowledged_interrupt_message_is_requeued_not_dropped():
     cli = _make_cli()
     agent = _StubAgent(cli.session_id)
@@ -222,24 +240,7 @@ def test_interrupt_requeue_never_merges_different_origin_states():
 
 def test_chat_stages_unclassified_plugin_input_but_keeps_human_defaults():
     cli = _make_cli()
