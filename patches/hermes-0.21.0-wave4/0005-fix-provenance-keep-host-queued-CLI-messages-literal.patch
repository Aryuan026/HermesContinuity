From: asherie <asherie@users.noreply.github.com>
Date: Tue, 8 Sep 2026 20:49:46 +0800
Subject: [PATCH] fix(provenance): keep host-queued CLI messages literal

---
 cli.py                                   |  52 ++++++++--
 tests/cli/test_cli_interrupt_ack_race.py | 125 +++++++++++++++++++----
 2 files changed, 149 insertions(+), 28 deletions(-)

diff --git a/cli.py b/cli.py
index faabe29..2907daa 100644
--- a/cli.py
+++ b/cli.py
@@ -107,6 +107,14 @@ import queue
 
 _DEFAULT_CLI_MESSAGE_ORIGIN = object()
 
+
+def _unwrap_cli_queue_entry(entry):
+    """Return payload, origin, and host-envelope control authority."""
+    if isinstance(entry, QueuedInput):
+        return entry.payload, entry.origin_proof, True
+    return entry, _DEFAULT_CLI_MESSAGE_ORIGIN, False
+
+
 def CanonicalUsage(*args, **kwargs):
     from agent.usage_pricing import CanonicalUsage as _CanonicalUsage
 
@@ -21018,14 +21026,20 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                                 pass
                         continue
 
-                    queued_origin = _DEFAULT_CLI_MESSAGE_ORIGIN
-                    if isinstance(user_input, QueuedInput):
-                        queued_origin = user_input.origin_proof
-                        user_input = user_input.payload
+                    user_input, queued_origin, producer_enveloped = (
+                        _unwrap_cli_queue_entry(user_input)
+                    )
+                    # A host envelope carries message data, never CLI composer
+                    # control text. Only bare keyboard/voice input may trigger
+                    # terminal cleanup, stop/resume, file/paste expansion,
+                    # bang shell, or slash/alias/skill dispatch below.
 
                     # Voice-transcribed messages arrive wrapped in a sentinel
                     # so only genuine STT output gets the voice prefix (#65827).
-                    is_voice_input = isinstance(user_input, _VoiceInputMessage)
+                    is_voice_input = (
+                        not producer_enveloped
+                        and isinstance(user_input, _VoiceInputMessage)
+                    )
                     if is_voice_input:
                         user_input = user_input.text
 
@@ -21033,7 +21047,10 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     # arbitrary launcher/script text that must be submitted
                     # LITERALLY — skip slash routing, ! shell dispatch, and
                     # file-drop detection for this one message.
-                    is_seeded_query = isinstance(user_input, _SeededQueryMessage)
+                    is_seeded_query = (
+                        not producer_enveloped
+                        and isinstance(user_input, _SeededQueryMessage)
+                    )
                     if is_seeded_query:
                         seeded = user_input
                         user_input = (
@@ -21054,7 +21071,7 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     if isinstance(user_input, tuple):
                         user_input, submit_images = user_input
 
-                    if isinstance(user_input, str):
+                    if isinstance(user_input, str) and not producer_enveloped:
                         user_input = _strip_leaked_bracketed_paste_wrappers(user_input)
                         user_input, _had_mouse_reports = _strip_leaked_terminal_responses_with_meta(user_input)
                         if _had_mouse_reports:
@@ -21065,7 +21082,11 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     # of sending the word to the agent. Voice transcripts are
                     # already stop-checked at the transcription points, so this
                     # only intercepts typed input.
-                    if not is_voice_input and self._typed_voice_stop(user_input):
+                    if (
+                        not producer_enveloped
+                        and not is_voice_input
+                        and self._typed_voice_stop(user_input)
+                    ):
                         continue
                     
                     # Check for commands — but detect dragged/pasted file paths first.
@@ -21073,7 +21094,11 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     # literal text: no file-drop detection, no !/slash dispatch.
                     _file_drop = (
                         _detect_file_drop(user_input)
-                        if isinstance(user_input, str) and not is_seeded_query
+                        if (
+                            isinstance(user_input, str)
+                            and not producer_enveloped
+                            and not is_seeded_query
+                        )
                         else None
                     )
                     if _file_drop:
@@ -21095,6 +21120,7 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     # the digit isn't sent to the agent as a message.
                     if (
                         not _file_drop
+                        and not producer_enveloped
                         and self._pending_resume_sessions
                         and isinstance(user_input, str)
                         and self._consume_pending_resume_selection(user_input)
@@ -21107,6 +21133,7 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     # turn is spent. See handle_bang_shell().
                     if (
                         not _file_drop
+                        and not producer_enveloped
                         and not is_seeded_query
                         and isinstance(user_input, str)
                         and self.handle_bang_shell(user_input)
@@ -21115,6 +21142,7 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
 
                     if (
                         not _file_drop
+                        and not producer_enveloped
                         and not is_seeded_query
                         and isinstance(user_input, str)
                         and _looks_like_slash_command(user_input)
@@ -21147,7 +21175,11 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                     
                     # Expand paste references back to full content
                     _paste_ref_re = re.compile(r'\[Pasted text #\d+: \d+ lines \u2192 (.+?)\]')
-                    paste_refs = list(_paste_ref_re.finditer(user_input)) if isinstance(user_input, str) else []
+                    paste_refs = (
+                        list(_paste_ref_re.finditer(user_input))
+                        if isinstance(user_input, str) and not producer_enveloped
+                        else []
+                    )
                     if paste_refs:
                         user_input = self._expand_paste_references(user_input)
                     print()
