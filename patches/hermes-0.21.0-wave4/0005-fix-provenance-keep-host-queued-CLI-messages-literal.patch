     assert voice["_origin_proof"] == build_message_origin_proof(CLI_USER)
 
 
+def test_host_enveloped_control_text_stays_literal_with_its_origin():
+    cli = _make_cli()
+    cli_globals = cli.__class__.chat.__globals__
+    agent = _CaptureStagingAgent(cli.session_id)
+    cli.agent = agent
+    cli._interrupt_queue = queue.Queue()
+    cases = [
+        QueuedInput("/queue webhook payload", None),
+        QueuedInput("/steer webhook payload", None),
+        QueuedInput("!echo webhook payload", None),
+        QueuedInput("stop", None),
+        QueuedInput("1", None),
+        QueuedInput("/tmp/webhook.txt", None),
+        QueuedInput(
+            "[Pasted text #1: 1 lines → /tmp/webhook.txt]",
+            None,
+        ),
+        QueuedInput(
+            "/queue scheduled payload",
+            build_message_origin_proof(CRON_AGENT),
+        ),
+        QueuedInput(
+            "/steer delegated payload",
+            build_message_origin_proof(SUBAGENT),
+        ),
+    ]
+
+    with patch.object(cli, "_ensure_runtime_credentials", return_value=True), \
+         patch.object(cli, "_resolve_turn_agent_config", return_value={
+             "signature": cli._active_agent_route_signature,
+             "model": None, "runtime": None, "request_overrides": None,
+         }), \
+         patch.object(cli, "_init_agent", return_value=True):
+        for entry in cases:
+            payload, origin, producer_enveloped = (
+                cli_globals["_unwrap_cli_queue_entry"](entry)
+            )
+            assert producer_enveloped is True
+            cli.chat(payload, message_origin_proof=origin)
+            cli.conversation_history = []
+
+    assert [message["content"] for message in agent.staged] == [
+        entry.payload for entry in cases
+    ]
+    for message in agent.staged[:7]:
+        assert MESSAGE_ORIGIN_DECLARED_FIELD in message
+        assert "_origin_proof" not in message
+    assert agent.staged[7]["_origin_proof"] == build_message_origin_proof(
+        CRON_AGENT
+    )
+    assert agent.staged[8]["_origin_proof"] == build_message_origin_proof(
+        SUBAGENT
+    )
+
+
+def test_keyboard_queue_command_keeps_human_control_authority():
+    cli = _make_cli()
+    cli_globals = cli.__class__.chat.__globals__
+    cli._pending_input = queue.Queue()
+
+    payload, origin, producer_enveloped = cli_globals["_unwrap_cli_queue_entry"](
+        "/queue human payload"
+    )
+    assert payload == "/queue human payload"
+    assert origin is cli_globals["_DEFAULT_CLI_MESSAGE_ORIGIN"]
+    assert producer_enveloped is False
+
+    assert cli.process_command(payload) is True
+    requeued = cli._pending_input.get_nowait()
+    assert requeued == "human payload"
+    assert not isinstance(requeued, QueuedInput)
+
+    agent = _CaptureStagingAgent(cli.session_id)
+    cli.agent = agent
+    cli._interrupt_queue = queue.Queue()
+    with patch.object(cli, "_ensure_runtime_credentials", return_value=True), \
+         patch.object(cli, "_resolve_turn_agent_config", return_value={
+             "signature": cli._active_agent_route_signature,
+             "model": None, "runtime": None, "request_overrides": None,
+         }), \
+         patch.object(cli, "_init_agent", return_value=True):
+        cli.chat(requeued)
+
+    assert agent.staged[0]["_origin_proof"] == build_message_origin_proof(
+        CLI_USER
+    )
+
+
 def test_chat_binds_new_origin_before_publishing_running_state():
     cli = _make_cli()
 
