+    def test_successor_attempt_reapplies_guard_and_commits_only_selected_body(self) -> None:
+        from agent import relay_llm
+
+        record = middleware.TransportRecord()
+        self.assertTrue(self.register_with_host_record(record, window=1))
+        record.mark_middleware_verified(self.overlay.request)
+        provider_bodies = []
+
+        def rejected(**body):
+            provider_bodies.append(body)
+            raise RuntimeError("provider rejected before accepting request")
+
+        with middleware.transport_record_scope(record):
+            with self.assertRaisesRegex(RuntimeError, "provider rejected"):
+                relay_llm.call_provider_body(rejected, self.overlay.request)
+            self.assertEqual(self.overlay.disposition, OVERLAY_PENDING)
+            relay_llm.allow_provider_successor()
+            result = relay_llm.call_provider_body(
+                lambda **body: provider_bodies.append(body) or "ok",
+                self.overlay.request,
+            )
+        record.settle()
+
+        self.assertEqual(result, "ok")
+        self.assertEqual(
+            [body["messages"][0]["content"] for body in provider_bodies],
+            ["current", "current"],
+        )
+        self.assertEqual(record.provider_attempt_count, 2)
+        self.assertEqual(record.capture_count, 1)
+        self.assertEqual(record.provider_body, provider_bodies[-1])
+        self.assertEqual(self.overlay.disposition, OVERLAY_REMOVED_FINAL_BUDGET)
+        self.assertTrue(record.settled)
