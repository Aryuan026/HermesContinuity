diff --git a/tests/agent/test_transport_successor_attempts.py b/tests/agent/test_transport_successor_attempts.py
new file mode 100644
index 0000000..d0808b6
--- /dev/null
+++ b/tests/agent/test_transport_successor_attempts.py
@@ -0,0 +1,234 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from types import SimpleNamespace
+
+from agent import chat_completion_helpers as cch
+from hermes_cli.middleware import (
+    TransportRecord,
+    _CURRENT_MIDDLEWARE_OWNER,
+    transport_record_scope,
+)
+from hermes_cli.request_overlay import (
+    OVERLAY_PENDING,
+    OVERLAY_REMOVED_FINAL_BUDGET,
+    project_request_overlay,
+)
+
+
+NAMESPACE = "[SUCCESSOR QUOTED REFERENCE"
+END = "[END SUCCESSOR QUOTED REFERENCE]"
+MARKER = f"{NAMESPACE} marker=one]"
+BODY = f"quoted material\n{END}"
+
+
+def _guarded_request(extra: dict | None = None):
+    request = {
+        "messages": [{"role": "user", "content": "current"}],
+        **(extra or {}),
+    }
+    overlay = project_request_overlay(
+        request,
+        marker_namespace=NAMESPACE,
+        end_boundary=END,
+        marker=MARKER,
+        body=BODY,
+    )
+    record = TransportRecord()
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("successor-test")
+    try:
+        assert overlay.register_final_budget_guard(
+            record,
+            context_window_tokens=1,
+            reserve_tokens=lambda _body, _window: 0,
+            validator=lambda _body, native: (
+                native["messages"][-1]["content"] == "current"
+            ),
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    record.mark_middleware_verified(overlay.request)
+    return overlay, record
+
+
+def _assert_selected_successor(overlay, record, provider_bodies):
+    assert len(provider_bodies) == 2
+    assert all(NAMESPACE not in body["messages"][-1]["content"] for body in provider_bodies)
+    assert overlay.disposition == OVERLAY_REMOVED_FINAL_BUDGET
+    assert record.provider_attempt_count == 2
+    assert record.capture_count == 1
+    assert record.provider_body == provider_bodies[-1]
+    assert record.ambiguous is False
+    assert record.settled is True
+
+
+def test_bedrock_nonstream_cachepoint_retry_reapplies_guard(monkeypatch):
+    overlay, record = _guarded_request(
+        {"__bedrock_region__": "us-east-1", "__bedrock_converse__": True}
+    )
+    provider_bodies = []
+
+    class Client:
+        def converse(self, **body):
+            provider_bodies.append(deepcopy(body))
+            if len(provider_bodies) == 1:
+                raise RuntimeError("cachePoint rejected")
+            return {"ok": True}
+
+    client = Client()
+    monkeypatch.setattr(
+        "agent.bedrock_adapter._get_bedrock_runtime_client", lambda _region: client
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.recover_from_cache_point_rejection",
+        lambda _exc, body: deepcopy(body),
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.normalize_converse_response", lambda response: response
+    )
+
+    agent = SimpleNamespace(api_mode="bedrock_converse", provider="bedrock")
+    with transport_record_scope(record):
+        response = cch._dispatch_nonstreaming_api_request(
+            agent,
+            deepcopy(overlay.request),
+            make_client=lambda *_args, **_kwargs: None,
+        )
+    record.settle()
+
+    assert response == {"ok": True}
+    _assert_selected_successor(overlay, record, provider_bodies)
+
+
+class _StreamingBedrockAgent:
+    api_mode = "bedrock_converse"
+    provider = "bedrock"
+    model = "test-model"
+    session_id = "successor-session"
+    _current_api_request_id = "request-1"
+    _fallback_index = 0
+    is_subagent = False
+    _interrupt_requested = False
+    _disable_streaming = False
+    _consecutive_stale_streams = 0
+    reasoning_callback = None
+    stream_delta_callback = None
+
+    def _has_stream_consumers(self):
+        return False
+
+    def _buffer_status(self, *_args, **_kwargs):
+        return None
+
+    def _claim_stream_writer(self):
+        return 1
+
+    def _fire_stream_delta(self, _text):
+        return None
+
+    def _fire_tool_gen_started(self, _name):
+        return None
+
+    def _fire_reasoning_delta(self, _text):
+        return None
+
+    def _safe_print(self, *_args, **_kwargs):
+        return None
+
+
+def _run_bedrock_stream_successor(monkeypatch, *, fallback_to_converse: bool):
+    overlay, record = _guarded_request(
+        {"__bedrock_region__": "us-east-1", "__bedrock_converse__": True}
+    )
+    provider_bodies = []
+    response = SimpleNamespace(choices=[object()])
+
+    class Client:
+        def converse_stream(self, **body):
+            provider_bodies.append(deepcopy(body))
+            if len(provider_bodies) == 1:
+                raise RuntimeError("stream rejected")
+            return {"stream": []}
+
+        def converse(self, **body):
+            provider_bodies.append(deepcopy(body))
+            return {"native": True}
+
+    client = Client()
+    monkeypatch.setattr(
+        "agent.bedrock_adapter._get_bedrock_runtime_client", lambda _region: client
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.recover_from_cache_point_rejection",
+        (
+            (lambda _exc, _body: None)
+            if fallback_to_converse
+            else (lambda _exc, body: deepcopy(body))
+        ),
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.is_streaming_access_denied_error",
+        lambda _exc: fallback_to_converse,
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.is_stale_connection_error", lambda _exc: False
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.normalize_converse_response", lambda _raw: response
+    )
+    monkeypatch.setattr(
+        "agent.bedrock_adapter.stream_converse_with_callbacks",
+        lambda *_args, **_kwargs: response,
+    )
+
+    with transport_record_scope(record):
+        result = cch.interruptible_streaming_api_call(
+            _StreamingBedrockAgent(),
+            deepcopy(overlay.request),
+        )
+    record.settle()
+
+    assert result is response
+    _assert_selected_successor(overlay, record, provider_bodies)
+
+
+def test_bedrock_stream_cachepoint_retry_reapplies_guard(monkeypatch):
+    _run_bedrock_stream_successor(monkeypatch, fallback_to_converse=False)
+
+
+def test_bedrock_stream_to_converse_fallback_reapplies_guard(monkeypatch):
+    _run_bedrock_stream_successor(monkeypatch, fallback_to_converse=True)
+
+
+def test_anthropic_stream_to_create_fallback_reapplies_guard():
+    from agent.anthropic_adapter import create_anthropic_message
+
+    overlay, record = _guarded_request({"model": "test", "max_tokens": 16})
+    provider_bodies = []
+
+    class RejectedStream:
+        def __enter__(self):
+            raise RuntimeError("stream not supported")
+
+        def __exit__(self, *_args):
+            return False
+
+    class Messages:
+        def stream(self, **body):
+            provider_bodies.append(deepcopy(body))
+            return RejectedStream()
+
+        def create(self, **body):
+            provider_bodies.append(deepcopy(body))
+            return "ok"
+
+    assert overlay.disposition == OVERLAY_PENDING
+    with transport_record_scope(record):
+        result = create_anthropic_message(
+            SimpleNamespace(messages=Messages()),
+            deepcopy(overlay.request),
+        )
+    record.settle()
+
+    assert result == "ok"
+    _assert_selected_successor(overlay, record, provider_bodies)
