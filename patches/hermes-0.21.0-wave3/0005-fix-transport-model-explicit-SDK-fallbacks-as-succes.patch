+    def accept_provider_body_attempt(self, body: Any) -> None:
+        """Commit the SDK candidate only after its provider call returned."""
+
+        snapshot = _transport_snapshot(body)
+        with self._lock:
+            attempt = self._active_provider_attempt
+            self._active_provider_attempt = None
+            if (
+                attempt is None
+                or snapshot is None
+                or attempt.body is None
+                or snapshot != attempt.body
+            ):
+                self._ambiguous = True
+                self._settled = False
+                return
+            self._capture_count += 1
+            if self._capture_count != 1:
+                self._ambiguous = True
+                self._settled = False
+                return
+            self._provider_body = snapshot
+            self._failed_provider_attempt_pending_retry = False
+            pending_acceptances = tuple(attempt.pending_acceptances)
+            estimate = attempt.estimate
+        self._store_provider_body_estimate(estimate)
+        for acceptance in pending_acceptances:
+            try:
+                acceptance._commit()
+            except Exception:
+                self._mark_ambiguous()
+
+    def reject_provider_body_attempt(self) -> None:
+        """Discard a failed SDK candidate and require proof before fallback."""
+
+        with self._lock:
