+    agent.api_mode = "anthropic_messages"
+    agent._create_request_anthropic_client = lambda **_kwargs: client
+    agent._close_request_anthropic_client = lambda *_args, **_kwargs: None
+
+    with transport_record_scope(record):
+        with pytest.raises(cch.EmptyStreamError):
+            agent._interruptible_streaming_api_call(deepcopy(overlay.request))
+    record.settle()
+
+    assert len(provider_bodies) == 1
+    assert len(filter_runs) == 1
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.ambiguous is True
+    assert record.settled is False
+    assert overlay.disposition == OVERLAY_PENDING
+
+
+def _codex_overlay_record():
+    request = {
+        "model": "gpt-test",
+        "input": [
+            {
+                "role": "user",
+                "content": [{"type": "input_text", "text": "current"}],
+            }
+        ],
+    }
+    overlay = project_request_overlay(
+        request,
+        marker_namespace=NAMESPACE,
+        end_boundary=END,
+        marker=MARKER,
+        body=BODY,
+    )
+    record = TransportRecord()
+    filter_runs = []
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("codex-stream-count")
+    try:
+        record.register_provider_body_filter(
+            lambda body: filter_runs.append(deepcopy(body)) or body
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("codex-stream-overlay")
+    try:
+        assert overlay.register_final_budget_guard(
+            record,
+            context_window_tokens=100_000,
+            reserve_tokens=lambda _body, _window: 0,
+            validator=lambda _body, native: (
+                native["input"][-1]["content"][-1]["text"] == "current"
+            ),
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    record.mark_middleware_verified(overlay.request)
+    return overlay, record, filter_runs
+
+
+def _codex_agent():
+    return SimpleNamespace(
+        _abort_request_openai_client=lambda *_args, **_kwargs: None,
+        _client_log_context=lambda: "test",
+        _fallback_index=0,
+        _fire_reasoning_delta=lambda _text: None,
+        _fire_stream_delta=lambda _text: None,
+        _fire_streamed_codex_commentary=lambda _text: None,
+        _interrupt_requested=False,
+        _is_codex_backend=lambda: False,
+        _touch_activity=lambda _text: None,
+        _current_api_request_id="request-id",
+        interim_assistant_callback=None,
+        is_subagent=False,
+        model="gpt-test",
+        provider="openai-codex",
+        session_id="codex-stream-session",
+        show_commentary=True,
+    )
+
+
+def _codex_terminal_events():
+    return [
+        SimpleNamespace(
+            type="response.completed",
+            response=SimpleNamespace(
+                status="completed",
+                output=[],
+                usage=None,
+                id="response-1",
+                model="gpt-test",
+                incomplete_details=None,
+                error=None,
+            ),
+        )
+    ]
+
+
+def test_codex_preopen_connect_retry_reapplies_overlay_guard(monkeypatch):
+    from agent.codex_runtime import run_codex_stream
+
+    overlay, record, filter_runs = _codex_overlay_record()
+    monkeypatch.setenv("HERMES_CODEX_SDK_TRANSFORM", "1")
+    provider_bodies = []
+
+    def create(**body):
+        provider_bodies.append(deepcopy(body))
+        if len(provider_bodies) == 1:
+            raise httpx.ConnectError("pre-open failure")
+        return iter(_codex_terminal_events())
+
+    client = SimpleNamespace(responses=SimpleNamespace(create=create))
+    with transport_record_scope(record):
+        response = run_codex_stream(
+            _codex_agent(),
+            deepcopy(overlay.request),
+            client=client,
+        )
+    record.settle()
+
+    assert response.status == "completed"
+    assert len(provider_bodies) == 2
+    assert len(filter_runs) == 2
+    assert record.provider_attempt_count == 2
+    assert record.capture_count == 1
+    assert record.settled is True
+    assert overlay.disposition != OVERLAY_PENDING
+
+
+def test_codex_mid_iteration_failure_does_not_retry_same_record(monkeypatch):
+    from agent.codex_runtime import run_codex_stream
+
+    overlay, record, filter_runs = _codex_overlay_record()
+    monkeypatch.setenv("HERMES_CODEX_SDK_TRANSFORM", "1")
+    provider_bodies = []
+
+    class BrokenStream:
+        def __iter__(self):
+            yield SimpleNamespace(type="response.output_text.delta", delta="partial")
+            raise httpx.ReadTimeout("mid-stream failure")
+
+    def create(**body):
+        provider_bodies.append(deepcopy(body))
+        return BrokenStream()
+
+    client = SimpleNamespace(responses=SimpleNamespace(create=create))
+    with transport_record_scope(record):
+        with pytest.raises(httpx.ReadTimeout):
+            run_codex_stream(
+                _codex_agent(),
+                deepcopy(overlay.request),
+                client=client,
+            )
+    record.settle()
+
+    assert len(provider_bodies) == 1
+    assert len(filter_runs) == 1
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.ambiguous is True
+    assert record.settled is False
+    assert overlay.disposition == OVERLAY_PENDING
