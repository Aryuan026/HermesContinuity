+class ProviderBodyStreamAttempt:
+    """Keep one filtered provider body pending through stream consumption."""
+
+    def __init__(
+        self,
+        callback: Callable[..., Any],
+        body: dict[str, Any],
+        *,
+        enter_context: bool = False,
+    ) -> None:
+        from hermes_cli.middleware import current_transport_record
+
+        self._callback = callback
+        self._body = dict(body)
+        self._enter_context = enter_context
+        self._record = current_transport_record()
+        self._provider_body: dict[str, Any] | None = None
+        self._manager: Any = None
+        self._state = "new"
+
+    @property
+    def finalized(self) -> bool:
+        return self._state in {"accepted", "failed", "retry_ready"}
+
+    def open(self) -> Any:
+        """Open the SDK stream without accepting its body as terminal truth."""
+
+        from hermes_cli.middleware import transport_record_scope
+
+        client_timeout = self._body.get("timeout")
+        has_client_timeout = "timeout" in self._body
+        provider_body = {
+            key: value for key, value in self._body.items() if key != "timeout"
+        }
+        record = self._record
+        if record is not None and not record.provider_body_supported:
+            record.mark_provider_body_unsupported()
+            self._record = None
+            record = None
+        if record is not None:
+            filtered = record.begin_provider_body_attempt(provider_body)
+            if filtered is not None:
+                provider_body = filtered
+        self._provider_body = dict(provider_body)
+        final_body = dict(provider_body)
+        if has_client_timeout:
+            final_body["timeout"] = client_timeout
+        try:
+            with transport_record_scope(None):
+                resource = self._callback(**final_body)
+                if self._enter_context:
+                    self._manager = resource
+                    resource = resource.__enter__()
+        except BaseException:
+            if record is not None:
+                record.reject_provider_body_attempt(successor_allowed=True)
+            self._state = "preopen_failed"
+            raise
+        self._state = "opened"
+        return resource
+
+    def accept(self) -> None:
+        """Accept only after the consumer observed terminal stream truth."""
+
+        if self._state != "opened":
+            return
+        try:
+            self._exit_manager(None)
+        except BaseException:
+            if self._record is not None:
+                self._record.reject_provider_body_attempt(successor_allowed=False)
+            self._state = "failed"
+            raise
+        if self._record is not None:
+            self._record.accept_provider_body_attempt(self._provider_body)
+        self._state = "accepted"
+
+    def finish_failure(self, exc: BaseException) -> bool:
+        """Close a failed stream and report whether an inner retry is safe."""
+
+        if self._state == "preopen_failed":
+            if self._record is not None:
+                self._record.allow_provider_successor()
+            self._state = "retry_ready"
+            return True
+        if self._state == "opened":
+            try:
+                self._exit_manager(exc)
+            except Exception:
+                logger.debug(
+                    "Provider stream context cleanup failed",
+                    exc_info=True,
+                )
+            if self._record is not None:
+                self._record.reject_provider_body_attempt(successor_allowed=False)
+                retry_safe = False
+            else:
+                retry_safe = True
+            self._state = "failed"
+            return retry_safe
+        return self._record is None
+
+    def abandon(self) -> None:
+        """Reject a non-terminal stream result without authorizing a successor."""
+
+        if self._state != "opened":
+            return
+        try:
+            self._exit_manager(None)
+        except Exception:
+            logger.debug(
+                "Provider stream context cleanup failed",
+                exc_info=True,
+            )
+        if self._record is not None:
+            self._record.reject_provider_body_attempt(successor_allowed=False)
+        self._state = "failed"
+
+    def _exit_manager(self, exc: BaseException | None) -> None:
+        manager = self._manager
+        self._manager = None
+        if manager is None:
+            return
+        from hermes_cli.middleware import transport_record_scope
+
+        with transport_record_scope(None):
+            if exc is None:
+                manager.__exit__(None, None, None)
+            else:
+                manager.__exit__(type(exc), exc, exc.__traceback__)
+
+
 def _without_transport_record(callback: Callable[..., Any], *args: Any) -> Any:
     from hermes_cli.middleware import transport_record_scope
 
