+def test_openai_extra_body_capture_matches_actual_http_json():
+    wire_bodies = []
+    client = _openai_mock_client(wire_bodies)
+    request = {
+        "model": "gpt-test",
+        "messages": [{"role": "user", "content": "top-level"}],
+        "extra_body": {
+            "messages": [{"role": "user", "content": "SDK override"}],
+            "provider_extension": {"mode": "test"},
+        },
+    }
+    record = TransportRecord()
+    record.mark_middleware_verified(request)
+
+    with transport_record_scope(record):
+        cch._dispatch_nonstreaming_api_request(
+            SimpleNamespace(api_mode="chat_completions", provider="openai"),
+            request,
+            make_client=lambda *_args, **_kwargs: client,
+        )
+    record.settle()
+
+    assert record.provider_body == wire_bodies[0]
+    assert record.provider_body["messages"] == [
+        {"role": "user", "content": "SDK override"}
+    ]
+    assert "extra_body" not in record.provider_body
+    assert record.capture_count == 1
+    assert record.ambiguous is False
+    assert record.settled is True
+
