+                            "description": "x" * 20_000,
+                            "parameters": {"type": "object"},
+                        },
+                    }
+                ]
+            },
+        }
+    )
+    wire_bodies = []
+    client = _openai_mock_client(wire_bodies)
+
+    with transport_record_scope(record):
+        cch._dispatch_nonstreaming_api_request(
+            SimpleNamespace(api_mode="chat_completions", provider="openai"),
+            overlay.request,
+            make_client=lambda *_args, **_kwargs: client,
+        )
+    record.settle()
+
+    assert record.provider_body == wire_bodies[0]
+    assert record.provider_body["messages"][-1]["content"] == "current"
+    assert NAMESPACE not in str(wire_bodies[0])
+    assert wire_bodies[0]["tools"][0]["function"]["name"] == "large_tool"
+    assert overlay.disposition == OVERLAY_REMOVED_FINAL_BUDGET
+    assert record.capture_count == 1
+    assert record.settled is True
