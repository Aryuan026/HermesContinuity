+def _provider_body_projection(
+    body: dict[str, Any],
+    *,
+    merge_extra_body: bool,
+) -> tuple[dict[str, Any] | None, frozenset[str] | None, Any, bool]:
+    """Project SDK kwargs into the semantic JSON body seen by the provider."""
+
+    client_timeout = body.get("timeout")
+    has_client_timeout = "timeout" in body
+    base = {
+        key: value
+        for key, value in body.items()
+        if key not in {"extra_body", "timeout"}
+    }
+    if not merge_extra_body or "extra_body" not in body:
+        return base, None, client_timeout, has_client_timeout
+    extra_body = body.get("extra_body")
+    if not isinstance(extra_body, dict):
+        return None, None, client_timeout, has_client_timeout
+    top_level_keys = frozenset(base)
+    semantic = dict(base)
+    semantic.update(extra_body)
+    return semantic, top_level_keys, client_timeout, has_client_timeout
+
+
+def _merge_provider_extra_body(body: dict[str, Any]) -> dict[str, Any] | None:
+    """Apply OpenAI SDK ``extra_body`` precedence to one transform result."""
+
+    if "extra_body" not in body:
+        return body
+    extra_body = body.get("extra_body")
+    if not isinstance(extra_body, dict):
+        return None
+    semantic = {key: value for key, value in body.items() if key != "extra_body"}
+    semantic.update(extra_body)
+    return semantic
+
+
+def _provider_sdk_body(
+    semantic: dict[str, Any],
+    *,
+    top_level_keys: frozenset[str] | None,
+    client_timeout: Any,
+    has_client_timeout: bool,
+) -> dict[str, Any]:
+    """Encode a filtered semantic body back into equivalent SDK kwargs."""
+
+    if top_level_keys is None:
+        final_body = dict(semantic)
+    else:
+        final_body = {
+            key: value for key, value in semantic.items() if key in top_level_keys
+        }
+        extra_body = {
+            key: value for key, value in semantic.items() if key not in top_level_keys
+        }
+        if extra_body:
+            final_body["extra_body"] = extra_body
+    if has_client_timeout:
+        final_body["timeout"] = client_timeout
+    return final_body
+
