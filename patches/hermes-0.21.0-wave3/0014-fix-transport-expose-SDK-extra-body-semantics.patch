+def test_codex_late_extra_body_relocation_stays_visible_to_final_guards(monkeypatch):
+    from agent import codex_runtime, relay_llm
+
+    overlay, record, filter_runs = _codex_overlay_record()
+    monkeypatch.delenv("HERMES_CODEX_SDK_TRANSFORM", raising=False)
+    relocated = codex_runtime._bypass_sdk_request_transform(
+        {**deepcopy(overlay.request), "stream": True}
+    )
+    sdk_calls = []
+
+    with transport_record_scope(record):
+        attempt = relay_llm.ProviderBodyStreamAttempt(
+            lambda **body: sdk_calls.append(deepcopy(body))
+            or iter(_codex_terminal_events()),
+            relocated,
+            merge_extra_body=True,
+        )
+        list(attempt.open())
+        attempt.accept()
+    record.settle()
+
+    assert len(filter_runs) == 1
+    assert "input" in filter_runs[0]
+    assert "extra_body" not in filter_runs[0]
+    assert "input" in record.provider_body
+    assert "extra_body" not in record.provider_body
+    assert sdk_calls[0]["extra_body"]["input"] == record.provider_body["input"]
+    assert overlay.disposition != OVERLAY_PENDING
+    assert record.capture_count == 1
+    assert record.settled is True
+
