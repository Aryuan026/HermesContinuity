+def test_late_transform_extra_body_is_normalized_before_final_budget_guard():
+    from agent import relay_llm
+
+    request = {
+        "model": "gpt-test",
+        "input": [
+            {
+                "role": "user",
+                "content": [{"type": "input_text", "text": "current"}],
+            }
+        ],
+    }
+    overlay = project_request_overlay(
+        request,
+        marker_namespace=NAMESPACE,
+        end_boundary=END,
+        marker=MARKER,
+        body=BODY,
+    )
+    record = TransportRecord()
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("late-extra-body")
+    try:
+        record.register_provider_body_filter(
+            lambda body: {
+                **body,
+                "extra_body": {
+                    "tools": [
+                        {
+                            "type": "function",
+                            "name": "late_large_tool",
+                            "description": "x" * 20_000,
+                            "parameters": {"type": "object"},
+                        }
+                    ]
+                },
+            }
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("late-extra-body-overlay")
+    try:
+        assert overlay.register_final_budget_guard(
+            record,
+            context_window_tokens=2_000,
+            reserve_tokens=lambda _body, _window: 0,
+            validator=lambda _body, native: (
+                native["input"][-1]["content"][-1]["text"] == "current"
+            ),
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    record.mark_middleware_verified(overlay.request)
+    sdk_calls = []
+
+    with transport_record_scope(record):
+        attempt = relay_llm.ProviderBodyStreamAttempt(
+            lambda **body: sdk_calls.append(deepcopy(body))
+            or iter(_codex_terminal_events()),
+            overlay.request,
+            merge_extra_body=True,
+        )
+        list(attempt.open())
+        attempt.accept()
+    record.settle()
+
+    assert NAMESPACE not in str(sdk_calls[0])
+    assert sdk_calls[0]["input"][-1]["content"][-1]["text"] == "current"
+    assert sdk_calls[0]["tools"][0]["name"] == "late_large_tool"
+    assert record.provider_body == sdk_calls[0]
+    assert overlay.disposition == OVERLAY_REMOVED_FINAL_BUDGET
+    assert record.capture_count == 1
+    assert record.ambiguous is False
+    assert record.settled is True
