+def test_openai_extra_body_message_shadow_cannot_settle_overlay_receipt():
+    request = {
+        "model": "gpt-test",
+        "messages": [{"role": "user", "content": "current"}],
+        "extra_body": {
+            "messages": [{"role": "user", "content": "SDK override"}],
+        },
+    }
+    overlay = project_request_overlay(
+        request,
+        marker_namespace=NAMESPACE,
+        end_boundary=END,
+        marker=MARKER,
+        body=BODY,
+    )
+    record = TransportRecord()
+    owner = _CURRENT_MIDDLEWARE_OWNER.set("extra-body-overlay")
+    try:
+        assert overlay.register_final_budget_guard(
+            record,
+            context_window_tokens=100_000,
+            reserve_tokens=lambda _body, _window: 0,
+            validator=lambda _body, native: (
+                native["messages"][-1]["content"] == "current"
+            ),
+        )
+    finally:
+        _CURRENT_MIDDLEWARE_OWNER.reset(owner)
+    record.mark_middleware_verified(overlay.request)
+    wire_bodies = []
+    client = _openai_mock_client(wire_bodies)
+
+    with transport_record_scope(record):
+        cch._dispatch_nonstreaming_api_request(
+            SimpleNamespace(api_mode="chat_completions", provider="openai"),
+            overlay.request,
+            make_client=lambda *_args, **_kwargs: client,
+        )
+    record.settle()
+
+    assert wire_bodies[0]["messages"] == [
+        {"role": "user", "content": "SDK override"}
+    ]
+    assert NAMESPACE not in str(wire_bodies[0])
+    assert record.provider_body == wire_bodies[0]
+    assert record.ambiguous is True
+    assert record.settled is False
+    assert overlay.disposition == OVERLAY_DRIFTED
+
