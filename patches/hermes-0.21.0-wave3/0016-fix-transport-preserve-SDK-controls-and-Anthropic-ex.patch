 def _stream_failure_proves_not_dispatched(exc: BaseException) -> bool:
@@ -76,25 +85,30 @@ def _provider_body_projection(
     body: dict[str, Any],
     *,
     merge_extra_body: bool,
-) -> tuple[dict[str, Any] | None, frozenset[str] | None, Any, bool]:
+) -> tuple[dict[str, Any] | None, _ProviderBodyCodec]:
     """Project SDK kwargs into the semantic JSON body seen by the provider."""
 
-    client_timeout = body.get("timeout")
-    has_client_timeout = "timeout" in body
+    sdk_controls = {
+        key: value for key, value in body.items() if key in _SDK_REQUEST_CONTROL_KEYS
