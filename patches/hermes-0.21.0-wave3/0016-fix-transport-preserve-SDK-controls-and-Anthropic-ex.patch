diff --git a/tests/agent/test_transport_successor_attempts.py b/tests/agent/test_transport_successor_attempts.py
index e97c30b..98e031b 100644
--- a/tests/agent/test_transport_successor_attempts.py
+++ b/tests/agent/test_transport_successor_attempts.py
@@ -63,6 +63,95 @@ def _openai_mock_client(wire_bodies):
     )
 
 
+def _anthropic_mock_client(wire_requests):
+    from anthropic import Anthropic
+
+    assert version("anthropic") == "0.87.0"
+
+    def handler(request):
+        body = json.loads(request.content)
+        wire_requests.append(
+            {
+                "body": body,
+                "beta": request.headers.get("anthropic-beta"),
+                "query": dict(request.url.params),
+            }
+        )
+        if body.get("stream"):
+            events = [
+                (
+                    "message_start",
+                    {
+                        "type": "message_start",
+                        "message": {
+                            "id": "msg_1",
+                            "type": "message",
+                            "role": "assistant",
+                            "model": "claude-opus-4-6",
+                            "content": [],
+                            "stop_reason": None,
+                            "stop_sequence": None,
+                            "usage": {"input_tokens": 1, "output_tokens": 0},
+                        },
+                    },
+                ),
+                (
+                    "content_block_start",
+                    {
+                        "type": "content_block_start",
+                        "index": 0,
+                        "content_block": {"type": "text", "text": ""},
+                    },
+                ),
+                (
+                    "content_block_delta",
+                    {
+                        "type": "content_block_delta",
+                        "index": 0,
+                        "delta": {"type": "text_delta", "text": "done"},
+                    },
+                ),
+                ("content_block_stop", {"type": "content_block_stop", "index": 0}),
+                (
+                    "message_delta",
+                    {
+                        "type": "message_delta",
+                        "delta": {"stop_reason": "end_turn", "stop_sequence": None},
+                        "usage": {"output_tokens": 1},
+                    },
+                ),
+                ("message_stop", {"type": "message_stop"}),
+            ]
+            content = "".join(
+                f"event: {event}\ndata: {json.dumps(data)}\n\n"
+                for event, data in events
+            )
+            return httpx.Response(
+                200,
+                content=content,
+                headers={"content-type": "text/event-stream"},
+            )
+        return httpx.Response(
+            200,
+            json={
+                "id": "msg_1",
+                "type": "message",
+                "role": "assistant",
+                "model": "claude-opus-4-6",
+                "content": [{"type": "text", "text": "done"}],
+                "stop_reason": "end_turn",
+                "stop_sequence": None,
+                "usage": {"input_tokens": 1, "output_tokens": 1},
+            },
+        )
+
+    return Anthropic(
+        api_key="test-key",
+        base_url="https://provider.invalid",
+        http_client=httpx.Client(transport=httpx.MockTransport(handler)),
+    )
+
+
 def _guarded_request(extra: dict | None = None):
     request = {
         "messages": [{"role": "user", "content": "current"}],
@@ -872,6 +961,85 @@ def test_openai_extra_body_capture_matches_actual_http_json():
     assert record.settled is True
 
 
+@pytest.mark.parametrize("prefer_stream", [False, True], ids=("create", "stream"))
+@pytest.mark.parametrize("with_record", [False, True], ids=("native", "recorded"))
+def test_anthropic_fast_mode_extra_body_and_sdk_controls_round_trip(
+    prefer_stream,
+    with_record,
+):
+    from agent.anthropic_adapter import create_anthropic_message
+    from hermes_cli.middleware import transport_record_scope
+
+    wire_requests = []
+    client = _anthropic_mock_client(wire_requests)
+    request = {
+        "model": "claude-opus-4-6",
+        "max_tokens": 16,
+        "messages": [{"role": "user", "content": "hello"}],
+        "extra_body": {"speed": "fast"},
+        "extra_headers": {"anthropic-beta": "fast-mode-2026-02-01"},
+        "extra_query": {"trace": "fast-mode"},
+    }
+    record = TransportRecord() if with_record else None
+    if record is not None:
+        record.mark_middleware_verified(request)
+        with transport_record_scope(record):
+            create_anthropic_message(
+                client,
+                deepcopy(request),
+                prefer_stream=prefer_stream,
+            )
+        record.settle()
+    else:
+        create_anthropic_message(
+            client,
+            deepcopy(request),
+            prefer_stream=prefer_stream,
+        )
+
+    wire = wire_requests[0]
+    assert wire["body"]["speed"] == "fast"
+    assert wire["beta"] == "fast-mode-2026-02-01"
+    assert wire["query"] == {"trace": "fast-mode"}
+    if record is not None:
+        expected_body = dict(wire["body"])
+        expected_body.pop("stream", None)
+        assert record.provider_body == expected_body
+        assert "extra_body" not in record.provider_body
+        assert "extra_headers" not in record.provider_body
+        assert "extra_query" not in record.provider_body
+        assert "fast-mode-2026-02-01" not in repr(record.provider_body)
+        assert record.capture_count == 1
+        assert record.ambiguous is False
+        assert record.settled is True
+
+
+def test_opaque_extra_body_is_preserved_when_semantic_merge_is_disabled():
+    from agent import relay_llm
+
+    request = {
+        "model": "provider-test",
+        "messages": [{"role": "user", "content": "hello"}],
+        "extra_body": {"provider_extension": {"mode": "opaque"}},
+        "extra_headers": {"x-provider-mode": "opaque"},
+    }
+
+    with relay_llm.provider_body_scope(request) as sdk_kwargs:
+        assert sdk_kwargs == request
+
+    record = TransportRecord()
+    record.mark_middleware_verified(request)
+    with transport_record_scope(record):
+        with relay_llm.provider_body_scope(request) as sdk_kwargs:
+            assert sdk_kwargs == request
+    record.settle()
+
+    assert record.provider_body is None
+    assert record.capture_count == 0
+    assert record.ambiguous is True
+    assert record.settled is False
+
+
 def test_openai_extra_body_message_shadow_cannot_settle_overlay_receipt():
     request = {
         "model": "gpt-test",
