diff --git a/tests/agent/test_transport_truth.py b/tests/agent/test_transport_truth.py
index ad724fc..707a0fc 100644
--- a/tests/agent/test_transport_truth.py
+++ b/tests/agent/test_transport_truth.py
@@ -224,6 +224,97 @@ def test_direct_stream_fallback_settles_only_before_post_and_calls_provider_once
     )
 
 
+def test_conversation_loop_marks_native_gemini_unsupported_before_execution(
+    monkeypatch,
+):
+    agent = _agent(monkeypatch)
+    provider_requests = []
+    execution_records = []
+    post_records = []
+
+    class GeminiFacade:
+        _hermes_provider_body_truth_supported = False
+
+        def create(self, **body):
+            provider_requests.append(body)
+            return _response()
+
+    facade = GeminiFacade()
+    agent.client = SimpleNamespace(
+        chat=SimpleNamespace(completions=facade),
+    )
+
+    def provider(request, *, on_first_delta=None):
+        del on_first_delta
+        return relay_llm.call_provider_body(facade.create, request)
+
+    def execution(*, request, next_call, transport_record, **_kwargs):
+        execution_records.append(transport_record)
+        try:
+            transport_record.register_provider_body_filter(lambda body: body)
+        except RuntimeError as exc:
+            assert "no final-body truth seam" in str(exc)
+        else:  # pragma: no cover - defensive
+            raise AssertionError("native Gemini must reject final-body filters")
+        native = dict(request)
+        native["messages"] = [
+            {
+                **message,
+                "content": str(message.get("content") or "").replace(
+                    "[PLUGIN OVERLAY]\n",
+                    "",
+                ),
+            }
+            for message in request["messages"]
+        ]
+        return next_call(native)
+
+    _install_callbacks(
+        monkeypatch,
+        execution,
+        lambda **kwargs: post_records.append(kwargs["transport_record"]),
+    )
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_owner",
+        lambda *_args, **_kwargs: "native-gemini-test",
+    )
+    monkeypatch.setattr(
+        relay_runtime,
+        "resolve_execution_context",
+        lambda _session_id: (None, None, None),
+    )
+    agent._interruptible_streaming_api_call = provider
+    original_builder = agent._build_api_kwargs
+    agent._build_api_kwargs = lambda messages: {
+        **original_builder(messages),
+        "messages": [
+            *messages[:-1],
+            {
+                **messages[-1],
+                "content": f"[PLUGIN OVERLAY]\n{messages[-1]['content']}",
+            },
+        ],
+    }
+
+    result = agent.run_conversation(
+        "hello",
+        conversation_history=[],
+        task_id="task-native-gemini-unsupported",
+    )
+
+    assert result["final_response"] == "done"
+    assert len(provider_requests) == 1
+    assert "[PLUGIN OVERLAY]" not in str(provider_requests[0])
+    assert len(execution_records) == 1
+    assert execution_records[0].provider_body_supported is False
+    assert execution_records[0].provider_body is None
+    assert execution_records[0].capture_count == 0
+    assert execution_records[0].ambiguous is True
+    assert execution_records[0].settled is False
+    assert post_records == [execution_records[0]]
+
+
 def test_lean_auxiliary_call_isolated_before_foreground_overlay_and_settlement(
     monkeypatch,
 ):
