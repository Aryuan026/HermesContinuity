+    def _accept(self, before: Mapping[str, Any], after: Mapping[str, Any]) -> bool:
+        """Compatibility helper for non-physical test doubles.
+
+        The real transport uses ``_validate`` plus deferred ``_commit`` so a
+        rejected SDK candidate cannot publish a disposition.  Older isolated
+        plugin fakes still model a single successful candidate synchronously.
+        """
+
