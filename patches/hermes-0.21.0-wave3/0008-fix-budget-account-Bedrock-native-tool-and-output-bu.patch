+    def test_bedrock_nested_output_reserve_controls_final_budget(self) -> None:
+        from agent import relay_llm
+        from agent.model_metadata import estimate_provider_body_tokens_rough
+
+        overlay = project(
+            {
+                "modelId": "anthropic.claude-test-v1:0",
+                "messages": [{"role": "user", "content": "current"}],
+                "toolConfig": {
+                    "tools": [
+                        {
+                            "toolSpec": {
+                                "name": "large_tool",
+                                "description": "x" * 20_000,
+                                "inputSchema": {"json": {"type": "object"}},
+                            }
+                        }
+                    ]
+                },
+                "inferenceConfig": {"maxTokens": 16_384},
+            }
+        )
+        estimate = estimate_provider_body_tokens_rough(overlay.request)
+        window = estimate["estimated_tokens"] + 8_000
+        record = middleware.TransportRecord()
+        owner = middleware._CURRENT_MIDDLEWARE_OWNER.set("bedrock-budget-owner")
+        try:
+            self.assertTrue(
+                overlay.register_final_budget_guard(
+                    record,
+                    context_window_tokens=window,
+                    reserve_tokens=lambda _body, _window: 4_096,
+                    validator=lambda _body, native: (
+                        native["messages"][-1]["content"] == "current"
+                    ),
+                )
+            )
+        finally:
+            middleware._CURRENT_MIDDLEWARE_OWNER.reset(owner)
+        record.mark_middleware_verified(overlay.request)
+
+        with middleware.transport_record_scope(record):
+            with relay_llm.provider_body_scope(overlay.request) as filtered:
+                self.assertEqual(filtered["messages"][-1]["content"], "current")
+        record.settle()
+
+        self.assertEqual(overlay.disposition, OVERLAY_REMOVED_FINAL_BUDGET)
+        self.assertEqual(record.provider_body_output_reserve_tokens, 16_384)
+        self.assertEqual(
+            record.provider_body_output_reserve_source,
+            "bedrock.inferenceConfig.maxTokens",
+        )
+        self.assertTrue(record.settled)
