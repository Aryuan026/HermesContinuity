+def test_native_gemini_nonstream_is_explicitly_unsupported_transport_truth():
+    from agent import relay_llm
+    from agent.gemini_native_adapter import GeminiNativeClient
+    from hermes_cli.middleware import TransportRecord, transport_record_scope
+
+    recorded = {}
+
+    class DummyHTTP:
+        def post(self, url, json=None, headers=None, timeout=None):
+            recorded.update(url=url, json=json, headers=headers, timeout=timeout)
+            return DummyResponse(
+                payload={
+                    "candidates": [
+                        {
+                            "content": {"parts": [{"text": "hello"}]},
+                            "finishReason": "STOP",
+                        }
+                    ]
+                }
+            )
+
+        def close(self):
+            return None
+
+    client = GeminiNativeClient(api_key="AIza-test", http_client=DummyHTTP())
+    facade = {
+        "model": "gemini-2.5-flash",
+        "messages": [{"role": "user", "content": "Hello"}],
+        "unknown_facade_field": "must-not-be-receipted",
+    }
+    record = TransportRecord()
+    record.mark_middleware_verified(facade)
+
+    with transport_record_scope(record):
+        result = relay_llm.call_provider_body(
+            client.chat.completions.create,
+            facade,
+        )
+    record.settle()
+
+    assert result.choices[0].message.content == "hello"
+    assert recorded["json"]["contents"][0]["parts"] == [{"text": "Hello"}]
+    assert "unknown_facade_field" not in recorded["json"]
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.provider_body is None
+    assert record.ambiguous is True
+    assert record.settled is False
+
+
+def test_native_gemini_stream_is_explicitly_unsupported_transport_truth():
+    from agent import relay_llm
+    from agent.gemini_native_adapter import GeminiNativeClient
+    from hermes_cli.middleware import TransportRecord, transport_record_scope
+
+    recorded = {}
+
+    class StreamResponse(DummyResponse):
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_args):
+            return False
+
+        def iter_text(self):
+            yield (
+                'data: {"candidates":[{"content":{"parts":[{"text":"hi"}]},'
+                '"finishReason":"STOP"}]}\n'
+            )
+
+    class DummyHTTP:
+        def stream(self, method, url, json=None, headers=None, timeout=None):
+            recorded.update(
+                method=method,
+                url=url,
+                json=json,
+                headers=headers,
+                timeout=timeout,
+            )
+            return StreamResponse()
+
+        def close(self):
+            return None
+
+    client = GeminiNativeClient(api_key="AIza-test", http_client=DummyHTTP())
+    facade = {
+        "model": "gemini-2.5-flash",
+        "messages": [{"role": "user", "content": "Hello"}],
+        "stream": True,
+    }
+    record = TransportRecord()
+    record.mark_middleware_verified(facade)
+
+    with transport_record_scope(record):
+        stream = relay_llm.call_provider_body(
+            client.chat.completions.create,
+            facade,
+        )
+        chunks = list(stream)
+    record.settle()
+
+    assert recorded["method"] == "POST"
+    assert recorded["json"]["contents"][0]["parts"] == [{"text": "Hello"}]
+    assert chunks[-1].choices[0].finish_reason == "stop"
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.provider_body is None
+    assert record.ambiguous is True
+    assert record.settled is False
+
+
 
 
 
