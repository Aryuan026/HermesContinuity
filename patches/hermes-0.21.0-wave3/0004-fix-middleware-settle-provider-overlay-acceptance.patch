+def test_lean_auxiliary_call_isolated_before_foreground_overlay_and_settlement(
+    monkeypatch,
+):
+    from agent.context_compressor import ContextCompressor
+
+    marker = "[FOREGROUND OVERLAY]"
+    auxiliary_calls = []
+    provider_calls = []
+    execution_records = []
+    post_records = []
+    compression_calls = 0
+
+    compressor = ContextCompressor(
+        model="test-model",
+        quiet_mode=True,
+        tail_mode="lean",
+        config_context_length=128_000,
+    )
+
+    def auxiliary_call(**kwargs):
+        auxiliary_calls.append(kwargs)
+        assert middleware.current_transport_record() is None
+        assert marker not in repr(kwargs["messages"])
+        return SimpleNamespace(
+            choices=[
+                SimpleNamespace(
+                    message=SimpleNamespace(
+                        content=(
+                            "## Historical Task Snapshot\nold task\n\n"
+                            "## Detailed Session Log\n- old turn"
+                        )
+                    ),
+                    finish_reason="stop",
+                )
+            ]
+        )
+
+    def request_middleware(*, request, **_kwargs):
+        projected = dict(request)
+        projected["messages"] = [dict(message) for message in request["messages"]]
+        carrier = projected["messages"][-1]
+        carrier["content"] = f"{marker}\n\n{carrier['content']}"
+        return {"request": projected}
+
+    def execution(*, request, next_call, transport_record, **_kwargs):
+        result = next_call(request)
+        execution_records.append(transport_record)
+        return result
+
+    def post(*, transport_record, **_kwargs):
+        post_records.append(transport_record)
+
+    monkeypatch.setattr(
+        middleware,
+        "_get_middleware_callbacks",
+        lambda kind: [request_middleware]
+        if kind == middleware.LLM_REQUEST_MIDDLEWARE
+        else [execution]
+        if kind == middleware.LLM_EXECUTION_MIDDLEWARE
+        else [],
+    )
+    monkeypatch.setattr(
+        middleware,
+        "_has_middleware",
+        lambda kind: kind == middleware.LLM_REQUEST_MIDDLEWARE,
+    )
+    monkeypatch.setattr(lifecycle, "has_hook", lambda name: name == "post_api_request")
+    monkeypatch.setattr(
+        lifecycle,
+        "invoke_hook",
+        lambda name, **kwargs: post(**kwargs) if name == "post_api_request" else [],
+    )
+    monkeypatch.setattr(plugins, "invoke_hook", lambda *_args, **_kwargs: [])
+    monkeypatch.setattr(
+        relay_runtime,
+        "resolve_execution_context",
+        lambda _session_id: (None, None, None),
+    )
+    monkeypatch.setattr(
+        "agent.context_compressor.call_llm",
+        auxiliary_call,
+    )
+
+    agent = _agent(monkeypatch)
+    compress_now = iter((True, False, False))
+    agent.context_compressor.should_compress = lambda _tokens: next(
+        compress_now,
+        False,
+    )
+
+    def compress(messages, system_message, **_kwargs):
+        nonlocal compression_calls
+        compression_calls += 1
+        summary = compressor._generate_summary(messages)
+        assert summary is not None
+        return [
+            {"role": "assistant", "content": summary},
+            dict(messages[-1]),
+        ], system_message
+
+    agent._compress_context = compress
+
+    def provider(request, *, on_first_delta=None):
+        del on_first_delta
+        with relay_llm.provider_body_scope(request):
+            provider_calls.append(request)
+            return _response()
+
+    agent._interruptible_streaming_api_call = provider
+    result = agent.run_conversation(
+        "current",
+        conversation_history=[
+            {"role": "user", "content": "old question"},
+            {"role": "assistant", "content": "old answer"},
+        ],
+        task_id="task-lean-foreground-isolation",
+    )
+
+    assert result["final_response"] == "done"
+    assert compression_calls == 1
+    assert len(auxiliary_calls) == 1
+    assert len(provider_calls) == 1
+    assert repr(provider_calls[0]).count(marker) == 1
+    assert len(execution_records) == 1
+    assert post_records == execution_records
+    assert post_records[0].provider_body == provider_calls[0]
+    assert post_records[0].settled is True
+
+
