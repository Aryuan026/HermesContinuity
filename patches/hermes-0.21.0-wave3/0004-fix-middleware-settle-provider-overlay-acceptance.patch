diff --git a/agent/context_compressor.py b/agent/context_compressor.py
index d13f044..57ae857 100644
--- a/agent/context_compressor.py
+++ b/agent/context_compressor.py
@@ -191,14 +191,13 @@ def _response_finish_reason(response: Any) -> str:
         return ""
 
 
-# RuntimeError marker raised when the summarizer's generation stopped on the
-# output-token cap (``finish_reason == "length"``). A length stop means the
-# summary text is PARTIAL — persisting it as a compaction checkpoint would
-# silently truncate the conversation's memory and feed the cut-off text back
-# into every subsequent iterative-update prompt. The except-branch classifier
-# below keys on this exact substring, so keep raise sites and the classifier
-# in sync. (Ported from earendil-works/pi#7048 / commit 97fa14e39.)
-_TRUNCATED_SUMMARY_MARKER = "finish_reason=length"
+# RuntimeError marker for any summary result without closed success truth.
+# Only normalized ``finish_reason=stop`` proves that the text is complete;
+# length/content-filter/tool/failed/cancelled/unknown/missing results must not
+# replace the canonical turns they only partially describe.  The exception
+# classifier below keys on this exact marker so summary fallback and abort stay
+# atomic across every provider adapter.
+_TRUNCATED_SUMMARY_MARKER = "summary_finish_unproven"
 
 
 def _is_summary_access_or_quota_error(exc: Exception) -> bool:
@@ -5314,7 +5313,14 @@ This compaction should PRIORITISE preserving all information related to the focu
             }
             call_kwargs["latency_info"] = _latency_info
             try:
-                with aux_interrupt_protection():
+                # Lean's single summary request is an auxiliary physical call,
+                # never a child of the foreground provider attempt.  Clear any
+                # ambient foreground transport record explicitly so it cannot
+                # consume request overlays, capture the auxiliary body, or
+                # settle a foreground delivery receipt.
+                from hermes_cli.middleware import transport_record_scope
+
+                with aux_interrupt_protection(), transport_record_scope(None):
                     response = call_llm(**call_kwargs)
             finally:
                 route_known = bool(_aux_route.get("provider") and _aux_route.get("model"))
@@ -5371,20 +5377,16 @@ This compaction should PRIORITISE preserving all information related to the focu
                     f"(provider={self.provider or 'auto'} "
                     f"model={self.summary_model or self.model})"
                 )
-            # A finish_reason of "length" means the summarizer hit its output
-            # token cap mid-generation: the text present is PARTIAL. Persisting
-            # a partial summary as the compaction checkpoint silently truncates
-            # the conversation's memory — the cut-off text replaces the real
-            # middle turns AND is fed back into every subsequent iterative
-            # update prompt, compounding the loss across compactions. Treat it
-            # as a failure so it routes through the same main-model fallback +
-            # abort machinery as other degraded responses instead of becoming
-            # a checkpoint. (Ported from earendil-works/pi#7048.)
-            if _response_finish_reason(response) == "length":
+            # A non-stop or missing finish reason is not closed success.  The
+            # text may be filtered, tool-interrupted, cancelled, failed, or
+            # otherwise partial; never let it replace the canonical turns.
+            _summary_finish_reason = _response_finish_reason(response)
+            if _summary_finish_reason != "stop":
                 raise RuntimeError(
-                    "Context compression summary was truncated "
-                    f"({_TRUNCATED_SUMMARY_MARKER}): generation hit the output "
-                    "token cap and the summary is incomplete "
+                    "Context compression summary did not finish successfully "
+                    f"({_TRUNCATED_SUMMARY_MARKER}; "
+                    f"finish_reason={_summary_finish_reason or 'missing'}): "
+                    "the summary is incomplete "
                     f"(provider={self.provider or 'auto'} "
                     f"model={self.summary_model or self.model})"
                 )
@@ -5489,12 +5491,9 @@ This compaction should PRIORITISE preserving all information related to the focu
                 or "llm returned none response" in _err_str
                 or "llm returned invalid response" in _err_str
             )
-            # Summarizer stopped on its output-token cap (finish_reason ==
-            # "length"): the summary text is partial and must never become a
-            # compaction checkpoint. Same degraded-response handling shape as
-            # empty content — one main-model retry (a larger/unconstrained
-            # model may finish the summary), then ABORT preserving the session
-            # unchanged. (Ported from earendil-works/pi#7048.)
+            # Summarizer did not return closed success. Treat every non-stop or
+            # missing finish state like partial output: one main-model retry,
+            # then abort while preserving the session unchanged.
             _is_truncated_summary = (
                 isinstance(e, RuntimeError)
                 and _TRUNCATED_SUMMARY_MARKER in _err_str
@@ -7110,15 +7109,14 @@ This compaction should PRIORITISE preserving all information related to the focu
             logger.info("micro-summarization call failed: %s", exc)
             return None
 
-        # A length stop means the merged rolling summary is partial —
-        # persisting it would silently drop the tail of the merge and feed
-        # the cut-off text into every later micro-compact pass. Leave the
-        # exchange unabsorbed instead; a later pass retries it.
-        # (Same class as _generate_summary's guard; pi#7048.)
-        if _response_finish_reason(response) == "length":
+        # Only a closed stop may replace the rolling summary. Any other or
+        # missing finish state leaves the exchange unabsorbed for a later pass.
+        _finish_reason = _response_finish_reason(response)
+        if _finish_reason != "stop":
             logger.warning(
-                "micro-summarization output hit the token cap "
-                "(finish_reason=length) — discarding partial summary",
+                "micro-summarization did not finish successfully "
+                "(finish_reason=%s) — discarding partial summary",
+                _finish_reason or "missing",
             )
             return None
 
