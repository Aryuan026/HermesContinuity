diff --git a/tests/agent/test_model_metadata.py b/tests/agent/test_model_metadata.py
index 4e17f6d..701977b 100644
--- a/tests/agent/test_model_metadata.py
+++ b/tests/agent/test_model_metadata.py
@@ -163,6 +163,93 @@ class TestEstimateTokensRough:
         assert estimate["estimate_source"] == "unknown"
         assert estimate["estimate_confidence"] == "unknown"
 
+    def test_final_provider_tool_estimate_ignores_stale_identity_cache(self):
+        import agent.model_metadata as mm
+
+        tools = [
+            {
+                "type": "function",
+                "function": {
+                    "name": "first",
+                    "parameters": {"type": "object"},
+                },
+            },
+            {
+                "type": "function",
+                "function": {
+                    "name": "middle",
+                    "parameters": {"type": "object"},
+                },
+            },
+            {
+                "type": "function",
+                "function": {
+                    "name": "last",
+                    "parameters": {"type": "object"},
+                },
+            },
+        ]
+        before = estimate_provider_body_tokens_rough(
+            {"messages": [{"role": "user", "content": "hello"}], "tools": tools}
+        )["estimated_tokens"]
+        mm._TOOLS_TOKENS_CACHE[id(tools)] = (3, "first", "last", 1)
+        tools[1]["function"]["parameters"] = {
+            "type": "object",
+            "description": "中" * 10_000,
+        }
+
+        after = estimate_provider_body_tokens_rough(
+            {"messages": [{"role": "user", "content": "hello"}], "tools": tools}
+        )["estimated_tokens"]
+        mm._TOOLS_TOKENS_CACHE.pop(id(tools), None)
+
+        assert after > before + 9_000
+
+    @pytest.mark.parametrize(
+        "body",
+        [
+            {
+                "model": "claude-test",
+                "messages": [{"role": "user", "content": "hello"}],
+                "tools": [
+                    {
+                        "name": "lookup",
+                        "input_schema": {
+                            "type": "object",
+                            "description": "中" * 50_000,
+                        },
+                    }
+                ],
+            },
+            {
+                "modelId": "anthropic.claude-test-v1:0",
+                "messages": [{"role": "user", "content": [{"text": "hello"}]}],
+                "toolConfig": {
+                    "tools": [
+                        {
+                            "toolSpec": {
+                                "name": "lookup",
+                                "inputSchema": {
+                                    "json": {
+                                        "type": "object",
+                                        "description": "あ" * 50_000,
+                                    }
+                                },
+                            }
+                        }
+                    ]
+                },
+            },
+        ],
+        ids=("anthropic-cjk", "bedrock-cjk"),
+    )
+    def test_final_provider_tool_estimate_is_cjk_aware(self, body):
+        estimate = estimate_provider_body_tokens_rough(body)
+
+        assert estimate["estimated_tokens"] > 50_000
+        assert estimate["estimate_source"] == "hermes.provider_body.rough.v1"
+        assert estimate["estimate_confidence"] == "heuristic_with_margin"
+
 
     def test_known_length(self):
         assert estimate_tokens_rough("a" * 400) == 100
