     assert overlay.disposition != OVERLAY_PENDING
 
 
+@pytest.mark.parametrize(
+    "error",
+    [
+        httpx.ReadTimeout("response headers timed out"),
+        httpx.RemoteProtocolError("peer closed after dispatch"),
+        httpx.WriteTimeout("partial request write timed out"),
+        ConnectionError("dispatch phase unknown"),
+    ],
+)
+def test_openai_stream_open_uncertainty_does_not_retry_same_record(
+    monkeypatch,
+    error,
+):
+    overlay, record, filter_runs = _stream_overlay_record()
+    monkeypatch.setenv("HERMES_STREAM_RETRIES", "1")
+    provider_bodies = []
+
+    def create(**body):
+        provider_bodies.append(deepcopy(body))
+        raise error
+
+    client = SimpleNamespace(
+        chat=SimpleNamespace(completions=SimpleNamespace(create=create))
+    )
+    agent = _streaming_agent()
+    agent._create_request_openai_client = lambda **_kwargs: client
+    agent._close_request_openai_client = lambda *_args, **_kwargs: None
+
+    with transport_record_scope(record):
+        with pytest.raises(type(error)):
+            agent._interruptible_streaming_api_call(deepcopy(overlay.request))
+    record.settle()
+
+    assert len(provider_bodies) == 1
+    assert len(filter_runs) == 1
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.ambiguous is True
+    assert record.settled is False
+    assert overlay.disposition == OVERLAY_PENDING
+
+
