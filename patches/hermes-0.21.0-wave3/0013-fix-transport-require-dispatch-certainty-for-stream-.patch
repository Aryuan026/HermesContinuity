 .../test_transport_successor_attempts.py      | 109 ++++++++++++++++++
 2 files changed, 155 insertions(+), 4 deletions(-)

diff --git a/agent/relay_llm.py b/agent/relay_llm.py
index ab4b418..9ae6061 100644
--- a/agent/relay_llm.py
+++ b/agent/relay_llm.py
@@ -26,6 +26,44 @@ _RELAY_INTERNAL_PROVIDER_HEADERS = frozenset(
 )
 
 
+def _stream_failure_proves_not_dispatched(exc: BaseException) -> bool:
+    """Return whether a stream-open failure proves no request was sent."""
+
+    try:
+        import httpx
+    except ImportError:  # pragma: no cover - Hermes provider installs include it
+        return False
+
+    current: BaseException | None = exc
+    seen: set[int] = set()
+    while current is not None and len(seen) < 5:
+        identity = id(current)
+        if identity in seen:
+            break
+        seen.add(identity)
+        if isinstance(
+            current,
+            (httpx.ConnectError, httpx.ConnectTimeout, httpx.PoolTimeout),
+        ):
+            return True
+        if isinstance(
+            current,
+            (
+                httpx.ReadError,
+                httpx.ReadTimeout,
+                httpx.RemoteProtocolError,
+                httpx.WriteError,
+                httpx.WriteTimeout,
+            ),
+        ):
+            return False
+        next_error = getattr(current, "__cause__", None) or getattr(
+            current, "__context__", None
+        )
+        current = next_error if isinstance(next_error, BaseException) else None
+    return False
+
+
 def _capture_provider_body(body: dict[str, Any]) -> None:
     from hermes_cli.middleware import current_transport_record
 
@@ -162,10 +200,11 @@ class ProviderBodyStreamAttempt:
                 if self._enter_context:
                     self._manager = resource
                     resource = resource.__enter__()
-        except BaseException:
+        except BaseException as exc:
+            retryable = _stream_failure_proves_not_dispatched(exc)
             if record is not None:
-                record.reject_provider_body_attempt(successor_allowed=True)
-            self._state = "preopen_failed"
+                record.reject_provider_body_attempt(successor_allowed=retryable)
+            self._state = "preopen_retryable" if retryable else "possibly_dispatched"
             raise
         self._state = "opened"
         return resource
@@ -189,11 +228,14 @@ class ProviderBodyStreamAttempt:
     def finish_failure(self, exc: BaseException) -> bool:
         """Close a failed stream and report whether an inner retry is safe."""
 
-        if self._state == "preopen_failed":
+        if self._state == "preopen_retryable":
             if self._record is not None:
                 self._record.allow_provider_successor()
             self._state = "retry_ready"
             return True
+        if self._state == "possibly_dispatched":
+            self._state = "failed"
+            return self._record is None
         if self._state == "opened":
             try:
                 self._exit_manager(exc)
diff --git a/tests/agent/test_transport_successor_attempts.py b/tests/agent/test_transport_successor_attempts.py
