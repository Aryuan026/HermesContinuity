+def test_anthropic_manager_enter_timeout_does_not_retry_same_record(monkeypatch):
+    overlay, record, filter_runs = _stream_overlay_record()
+    monkeypatch.setenv("HERMES_STREAM_RETRIES", "1")
+    provider_bodies = []
+
+    class StreamManager:
+        def __enter__(self):
+            raise httpx.ReadTimeout("headers timed out after dispatch")
+
+        def __exit__(self, *_args):
+            return False
+
+    class Messages:
+        def stream(self, **body):
+            provider_bodies.append(deepcopy(body))
+            return StreamManager()
+
+    client = SimpleNamespace(messages=Messages())
+    agent = _streaming_agent()
+    agent.api_mode = "anthropic_messages"
+    agent._create_request_anthropic_client = lambda **_kwargs: client
+    agent._close_request_anthropic_client = lambda *_args, **_kwargs: None
+
+    with transport_record_scope(record):
+        with pytest.raises(httpx.ReadTimeout):
+            agent._interruptible_streaming_api_call(deepcopy(overlay.request))
+    record.settle()
+
+    assert len(provider_bodies) == 1
+    assert len(filter_runs) == 1
+    assert record.provider_attempt_count == 1
+    assert record.capture_count == 0
+    assert record.ambiguous is True
+    assert record.settled is False
+    assert overlay.disposition == OVERLAY_PENDING
+
