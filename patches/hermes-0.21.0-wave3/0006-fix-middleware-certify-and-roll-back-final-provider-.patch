+def test_plain_dict_final_guard_cannot_delete_another_overlay(monkeypatch):
+    from agent import relay_llm
+    from hermes_cli import plugins
+
+    manager = plugins.PluginManager(scope_key="/tmp/hermes-guard-ownership-test")
+    ctx = plugins.PluginContext(
+        plugins.PluginManifest(name="intruder", key="intruder"), manager
+    )
+
+    def execution(*, request, next_call, transport_record, **_kwargs):
+        def delete_other_overlay(body):
+            body["messages"][-1]["content"] = body["messages"][-1][
+                "content"
+            ].replace("<other>owned</other>", "")
+            return body
+
+        transport_record.register_provider_body_filter(
+            delete_other_overlay,
+            phase=middleware.PROVIDER_BODY_FILTER_FINAL_GUARD,
+        )
+        return next_call(request)
+
+    ctx.register_middleware(middleware.LLM_EXECUTION_MIDDLEWARE, execution)
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+    request = {
+        "messages": [
+            {"role": "user", "content": "current<other>owned</other>"}
+        ]
+    }
+    record = middleware.TransportRecord()
+    provider_calls = []
+
+    def terminal(final):
+        record.mark_middleware_verified(final)
+        with middleware.transport_record_scope(record):
+            return relay_llm.call_provider_body(
+                lambda **body: provider_calls.append(body) or "ok",
+                final,
+            )
+
+    assert (
+        middleware.run_llm_execution_middleware(
+            request,
+            terminal,
+            transport_record=record,
+        )
+        == "ok"
+    )
+    record.settle()
+
+    assert provider_calls == [request]
+    assert record.ambiguous is True
+    assert record.settled is False
+
+
+def test_failed_execution_callback_rolls_back_registered_filter(monkeypatch):
+    from agent import relay_llm
+    from hermes_cli import plugins
+
+    manager = plugins.PluginManager(scope_key="/tmp/hermes-filter-rollback-test")
+    broken_ctx = plugins.PluginContext(
+        plugins.PluginManifest(name="broken", key="broken"), manager
+    )
+
+    def broken_execution(*, transport_record, **_kwargs):
+        transport_record.register_provider_body_filter(
+            lambda body: {**body, "poison": True}
+        )
+        raise RuntimeError("failed before next_call")
+
+    broken_ctx.register_middleware(
+        middleware.LLM_EXECUTION_MIDDLEWARE,
+        broken_execution,
+    )
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+    request = {"messages": [{"role": "user", "content": "current"}]}
+    record = middleware.TransportRecord()
+    provider_calls = []
+
+    def terminal(final):
+        record.mark_middleware_verified(final)
+        with middleware.transport_record_scope(record):
+            return relay_llm.call_provider_body(
+                lambda **body: provider_calls.append(body) or "ok",
+                final,
+            )
+
+    assert (
+        middleware.run_llm_execution_middleware(
+            request,
+            terminal,
+            transport_record=record,
+        )
+        == "ok"
+    )
+    record.settle()
+
+    assert provider_calls == [request]
+    assert record.provider_body_filter_owners == ()
+    assert record.ambiguous is False
+    assert record.settled is True
+
