     if bedrock_native:
@@ -4237,7 +4247,17 @@ def estimate_provider_body_tokens_rough(body: Any) -> dict[str, Any]:
                     "output_reserve_source": output_reserve_source,
                     "output_reserve_confidence": output_reserve_confidence,
                 }
-            total += _estimate_tools_tokens_rough(tool_config["tools"])
+            tool_tokens = _provider_tools_tokens_rough(tool_config["tools"])
+            if tool_tokens is None:
